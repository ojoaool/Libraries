	-- Título (esquerda)
	label(header, config.Title or "CARTI HUB", 28, Theme.Text, Theme.FontBold).Position = UDim2.fromOffset(24, 18)
	header:FindFirstChildOfClass("TextLabel").Size = UDim2.fromOffset(170, 34)

	new("Frame", {
		Position = UDim2.fromOffset(24, 56),
		Size = UDim2.fromOffset(150, 1),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
	}, header)

	local sub = label(header, config.Subtitle or "DIE LIT  /  AWGE  /  2018", 8, Theme.SubText)
	sub.Position = UDim2.fromOffset(24, 60)
	sub.Size = UDim2.fromOffset(170, 12)
	sub.Parent = header

	local game_ = label(header, config.GameName or "Game Name - Executor", 11, Theme.SubText)
	game_.Position = UDim2.fromOffset(18, 84)
	game_.Size = UDim2.fromOffset(190, 16)
	game_.Parent = header

	-- Avatar
	local avatar = new("ImageLabel", {
		Position = UDim2.fromOffset(217, 12),
		Size = UDim2.fromOffset(38, 38),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
	}, header)
	corner(avatar, 19)
	stroke(avatar, Theme.Stroke, 1)
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(
				Players.LocalPlayer.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
		end)
		if ok then
			avatar.Image = img
		end
	end)

	-- Nome da aba + FPS
	self.TabTitle = label(header, "Main", 14, Theme.Text, Theme.FontBold)
	self.TabTitle.Position = UDim2.fromOffset(265, 14)
	self.TabTitle.Size = UDim2.fromOffset(120, 18)
	self.TabTitle.Parent = header

	self.FpsLabel = label(header, "0 FPS", 9, Theme.SubText)
	self.FpsLabel.Position = UDim2.fromOffset(265, 32)
	self.FpsLabel.Size = UDim2.fromOffset(140, 12)
	self.FpsLabel.Parent = header

	local frames, last = 0, os.clock()
	RunService.RenderStepped:Connect(function(dt)
		frames += 1
		if os.clock() - last >= 0.5 then
			self.FpsLabel.Text = string.format("%d FPS  :  %.2f", frames * 2, dt)
			frames, last = 0, os.clock()
		end
	end)

	-- Barra de busca
	local search = new("Frame", {
		Position = UDim2.fromOffset(217, 66),
		Size = UDim2.fromOffset(372, 24),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
	}, header)
	corner(search, 6)
	stroke(search, Theme.Stroke, 1)

	local icon = label(search, "⌕", 14, Theme.SubText, Theme.Font, Enum.TextXAlignment.Center)
	icon.Size = UDim2.fromOffset(24, 24)
	icon.Parent = search

	self.SearchBox = new("TextBox", {
		Position = UDim2.fromOffset(26, 0),
		Size = UDim2.new(1, -80, 1, 0),
		BackgroundTransparency = 1,
		PlaceholderText = "Find a feature...",
		PlaceholderColor3 = Theme.SubText,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 11,
		Font = Theme.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
	}, search)

	local hint = label(search, "CTRL", 8, Theme.SubText, Theme.Font, Enum.TextXAlignment.Right)
	hint.Position = UDim2.new(1, -44, 0, 0)
	hint.Size = UDim2.fromOffset(38, 24)
	hint.Parent = search

	self.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self:_filter(self.SearchBox.Text)
	end)

	-- Botões circulares (direita)
	local glyphs = { "⚙", "", "i" }
	for i, g in ipairs(glyphs) do
		local b = new("TextButton", {
