-- Tabs
---------------------------------------------------------------------
function Library:AddTab(name)
	local tab = setmetatable({ Library = self, Name = name }, Tab)
	local order = #self.Tabs * 2 + 1

	tab.Button = new("TextButton", {
		LayoutOrder = order,
		Size = UDim2.new(1, -14, 0, 24),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = Theme.SubText,
		TextSize = 11,
		Font = Theme.Font,
		AutoButtonColor = false,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.SidebarList)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, tab.Button)
	corner(tab.Button, 4)
	tab.ButtonStroke = stroke(tab.Button, Theme.Accent, 1, 1)

	-- pontinho separador entre abas
	new("TextLabel", {
		LayoutOrder = order + 1,
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundTransparency = 1,
		Text = "•",
		TextColor3 = Theme.Stroke,
		TextSize = 8,
		Font = Theme.Font,
	}, self.SidebarList)

	-- Página com duas colunas
	tab.Page = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, self.Pages)

	local function column(xScale, xOffset)
		local col = new("ScrollingFrame", {
			Position = UDim2.new(xScale, xOffset, 0, 0),
			Size = UDim2.new(0.5, -5, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Stroke,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, tab.Page)
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, col)
		new("UIPadding", { PaddingRight = UDim.new(0, 6) }, col)
		return col
	end
	tab.Left = column(0, 0)
	tab.Right = column(0.5, 5)

	tab.Button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	table.insert(self.Tabs, tab)
	if not self.CurrentTab then
		self:SelectTab(tab)
	end
	return tab
end

function Library:SelectTab(tab)
	for _, t in ipairs(self.Tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		tween(t.ButtonStroke, { Transparency = active and 0 or 1 })
		tween(t.Button, { TextColor3 = active and Theme.Text or Theme.SubText })
	end
	self.CurrentTab = tab
	self.TabTitle.Text = tab.Name
end

function Tab:AddSection(name, side)
	local parent = (side == "Right") and self.Right or self.Left
	local sec = setmetatable({ Tab = self, Library = self.Library }, Section)

	sec.Frame = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
	}, parent)
	corner(sec.Frame, 6)
	stroke(sec.Frame, Theme.Stroke, 1)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
	}, sec.Frame)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, sec.Frame)

	local title = label(sec.Frame, name, 12, Theme.Text, Theme.FontBold)
	title.Size = UDim2.new(1, 0, 0, 16)
	title.LayoutOrder = 0
	return sec
end

---------------------------------------------------------------------
-- Elementos
---------------------------------------------------------------------
function Section:_register(frame, name)
	table.insert(self.Library.Elements, { Frame = frame, Name = name })
end

function Section:AddSubtitle(text)
	local l = label(self.Frame, text, 11, Theme.SubText)
	l.Size = UDim2.new(1, 0, 0, 14)
	return l
end

function Section:AddLabel(text)
	local l = label(self.Frame, text, 11, Theme.Text)
	l.Size = UDim2.new(1, 0, 0, 16)
	self:_register(l, text)
	return l
end

function Section:AddToggle(opts)
	local state = opts.Default or false
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, self.Frame)

	local l = label(row, opts.Name, 11, Theme.Text)
	l.Size = UDim2.new(1, -30, 1, 0)

	local box = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = state and Theme.Accent or Theme.Panel,
		BorderSizePixel = 0,
	}, row)
	corner(box, 4)
	stroke(box, Theme.Stroke, 1)

	local function set(v)
		state = v
		tween(box, { BackgroundColor3 = v and Theme.Accent or Theme.Panel })
		if opts.Callback then
			task.spawn(opts.Callback, v)
		end
	end
	row.MouseButton1Click:Connect(function() set(not state) end)

	self:_register(row, opts.Name)
	return { Set = set, Get = function() return state end }
end

function Section:AddButton(opts)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = Theme.Element,
		Text = opts.Name,
		TextColor3 = Theme.Text,
		TextSize = 11,
		Font = Theme.Font,
		AutoButtonColor = false,
	}, self.Frame)
	corner(b, 5)
	stroke(b, Theme.Stroke, 1)
	b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = Theme.Element }) end)
	b.MouseButton1Click:Connect(function()
		if opts.Callback then
			task.spawn(opts.Callback)
		end
	end)
	self:_register(b, opts.Name)
	return b
end

function Section:AddSlider(opts)
	local min, max = opts.Min or 0, opts.Max or 100
	local inc = opts.Increment or 1
	local value = math.clamp(opts.Default or min, min, max)

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
	}, self.Frame)

	local l = label(row, opts.Name, 11, Theme.Text)
	l.Size = UDim2.new(0.5, 0, 0, 18)

	local valueBox = new("TextBox", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(86, 18),
		BackgroundColor3 = Theme.Element,
		TextColor3 = Theme.SubText,
		TextSize = 10,
		Font = Theme.Font,
		ClearTextOnFocus = false,
		Text = "",
	}, row)
	corner(valueBox, 4)

	local track = new("Frame", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(8, 8, 8),
		BorderSizePixel = 0,
	}, row)
	corner(track, 5)
	stroke(track, Theme.Stroke, 1)

	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 5)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(70, 70, 70), Color3.fromRGB(255, 255, 255)),
	}, fill)

	local function set(v, silent)
		v = math.clamp(math.round(v / inc) * inc, min, max)
		value = v
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		valueBox.Text = tostring(v) .. (opts.Suffix and (" " .. opts.Suffix) or "")
		if not silent and opts.Callback then
			task.spawn(opts.Callback, v)
		end
	end
	set(value, true)

	local dragging = false
	local function update(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		set(min + (max - min) * a)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input.Position.X)
		end
	end)
	valueBox.FocusLost:Connect(function()
		local n = tonumber(valueBox.Text:match("[%d%.%-]+"))
		set(n or value)
	end)

	self:_register(row, opts.Name)
	return { Set = set, Get = function() return value end }
end

function Section:AddDropdown(opts)
	local options = opts.Options or {}
	local current = opts.Default or options[1] or ""
	local open = false

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, self.Frame)

	local head = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = Theme.Element,
		Text = current,
		TextColor3 = Theme.Text,
		TextSize = 11,
		Font = Theme.Font,
		AutoButtonColor = false,
	}, holder)
	corner(head, 5)
	stroke(head, Theme.Stroke, 1)

	local arrow = label(head, "⇅", 11, Theme.SubText, Theme.Font, Enum.TextXAlignment.Right)
	arrow.Size = UDim2.new(1, -8, 1, 0)
	arrow.Parent = head

	local list = new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, #options * 22),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
	}, holder)
	corner(list, 5)
	new("UIListLayout", {}, list)

	for _, opt in ipairs(options) do
		local o = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			Text = opt,
			TextColor3 = Theme.SubText,
			TextSize = 11,
			Font = Theme.Font,
		}, list)
		o.MouseButton1Click:Connect(function()
			current = opt
			head.Text = opt
			open = false
			tween(holder, { Size = UDim2.new(1, 0, 0, 24) })
			if opts.Callback then
				task.spawn(opts.Callback, opt)
			end
		end)
	end

	head.MouseButton1Click:Connect(function()
		open = not open
		tween(holder, { Size = UDim2.new(1, 0, 0, open and (28 + #options * 22) or 24) })
	end)

	self:_register(holder, opts.Name or current)
	return { Get = function() return current end }
end

return Library
