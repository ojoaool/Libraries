	notificationContainer.ZIndex = 300

	local notifLayout = Instance.new("UIListLayout")
	notifLayout.SortOrder = Enum.SortOrder.LayoutOrder
	notifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	notifLayout.Padding = UDim.new(0, 8)
	notifLayout.Parent = notificationContainer

	local notifOrder = 0
	local activeToasts = {}

	showNotification = function(toastTitle, message, kind)
		-- o mascote (se existir) reage mesmo com as notificações desligadas
		if Window.OnNotify then Window.OnNotify(kind) end

		-- Com notificações desligadas, só erros aparecem.
		if not notificationsEnabled() and kind ~= "error" then return end

		local accentColor = COLORS.Accent
		if kind == "success" then
			accentColor = COLORS.Success
		elseif kind == "error" then
			accentColor = COLORS.Danger
		end

		notifOrder = notifOrder + 1

		local notifCanvas = Instance.new("CanvasGroup")
		notifCanvas.Name = "Notification"
		notifCanvas.BackgroundTransparency = 1
		notifCanvas.Size = UDim2.new(1, 0, 0, 0)
		notifCanvas.AutomaticSize = Enum.AutomaticSize.Y
		notifCanvas.LayoutOrder = notifOrder
		notifCanvas.GroupTransparency = 1
		notifCanvas.ZIndex = 300
		notifCanvas.Parent = notificationContainer

		local card = newFrame({
			Name = "NotifCard",
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = COLORS.Card,
			Corner = 8,
		}, notifCanvas)
		card.AutomaticSize = Enum.AutomaticSize.Y
		card.ZIndex = 300
		stroke(card, COLORS.PanelBorder, 1)

		newFrame({
			Name = "AccentBar",
			Size = UDim2.new(0, 3, 1, 0),
			BackgroundColor3 = accentColor,
		}, card).ZIndex = 300

		local textHolder = newFrame({
			Name = "TextHolder",
			Size = UDim2.new(1, -15, 0, 0),
			Position = UDim2.new(0, 12, 0, 0),
			BackgroundTransparency = 1,
		}, card)
		textHolder.AutomaticSize = Enum.AutomaticSize.Y
		textHolder.ZIndex = 300

		local textLayout = Instance.new("UIListLayout")
		textLayout.SortOrder = Enum.SortOrder.LayoutOrder
		textLayout.Padding = UDim.new(0, 2)
		textLayout.Parent = textHolder

		local textPad = Instance.new("UIPadding")
		textPad.PaddingTop = UDim.new(0, 8)
		textPad.PaddingBottom = UDim.new(0, 8)
		textPad.PaddingRight = UDim.new(0, 8)
		textPad.Parent = textHolder

		local titleLabel = newLabel({
			Size = UDim2.new(1, 0, 0, 17),
			Text = tostring(toastTitle or ""),
			Font = Enum.Font.GothamBold,
			TextSize = 14,
		}, textHolder)
		titleLabel.ZIndex = 300

		if message and message ~= "" then
			local messageLabel = newLabel({
				Size = UDim2.new(1, 0, 0, 0),
				Text = tostring(message),
				TextColor3 = COLORS.TextMuted,
				TextSize = 12,
				TextWrapped = true,
			}, textHolder)
			messageLabel.AutomaticSize = Enum.AutomaticSize.Y
			messageLabel.ZIndex = 300
		end

		TweenService:Create(notifCanvas,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()

		local dismissed = false
		local function dismiss()
			if dismissed then return end
			dismissed = true
			local idx = table.find(activeToasts, dismiss)
			if idx then table.remove(activeToasts, idx) end

			local fadeOut = TweenService:Create(notifCanvas,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
			fadeOut.Completed:Once(function()
				notifCanvas:Destroy()
			end)
			fadeOut:Play()
		end

		activeToasts[#activeToasts + 1] = dismiss
		-- Limita a pilha: toasts antigos somem quando passa do máximo.
		if #activeToasts > MAX_TOASTS then
			activeToasts[1]()
		end
		task.delay(3, dismiss)
	end

