-- ================== PERSISTÊNCIA DE CONFIG ==================
-- Salva/carrega o HubState inteiro num arquivo JSON local (writefile/readfile,
-- padrão de executor), pra o usuário não perder a configuração toda vez que o
-- script recarrega. writefile/isfile/readfile podem não existir em todo ambiente
-- (ex.: Roblox Studio puro), por isso tudo passa por pcall.
local CONFIG_FILE = "NervHub_Config.json"

-- Função nomeada: lê e decodifica o JSON salvo; retorna {} se não existir ou der erro.
local function loadConfig()
	local ok, result = pcall(function()
		if isfile and isfile(CONFIG_FILE) then
			return HttpService:JSONDecode(readfile(CONFIG_FILE))
		end
		return {}
	end)
	if ok and type(result) == "table" then
		return result
	end
	return {}
end

-- Carregado uma única vez, antes de qualquer card ser construído, pra servir de
-- valor inicial (default) de cada dropdown/slider/toggle mais abaixo.
local SavedConfig = loadConfig()

local configDirty = false
-- Função nomeada: marca que o HubState mudou; o heartbeat lá embaixo descarrega
-- isso pro disco no máximo uma vez por segundo (evita gravar a cada pixel de
-- arraste do slider, por exemplo).
local function markConfigDirty()
	configDirty = true
end

-- Função nomeada: grava o HubState inteiro no disco. Chamada só pelo heartbeat
-- (debounced), nunca direto de dentro de um callback de UI.
local function saveConfig()
	pcall(function()
		if writefile then
			writefile(CONFIG_FILE, HttpService:JSONEncode(HubState))
		end
	end)
	configDirty = false
end

-- Função nomeada: acha o índice de "value" dentro de "options"; cai no fallback
-- se não existir (ex.: a key salva não bater com nenhuma opção atual).
local function findOptionIndex(options, value, fallback)
	if value ~= nil then
		for i, opt in ipairs(options) do
			if opt == value then
				return i
			end
		end
	end
	return fallback
end

-- Função nomeada: lê um valor salvo (SavedConfig.Grupo.Campo) com fallback seguro
-- quando o grupo ainda não existe no arquivo (primeira vez rodando o script).
local function savedOrDefault(group, field, fallback)
	local groupTable = SavedConfig[group]
	if groupTable and groupTable[field] ~= nil then
		return groupTable[field]
	end
	return fallback
end

