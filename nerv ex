-- ===== Arrastar a janela pela TopBar =====
-- Padrão clássico de drag no Roblox: guarda a posição do mouse/touch e a posição
-- da janela no momento do clique, depois só soma o delta a cada InputChanged.
-- Funciona mesmo clicando em cima da SearchBox ou dos botões min/close (o clique
-- neles continua dispensando normal; a janela só "anda" se o mouse realmente mover).
local isDraggingWindow = false
local dragInput
local dragStartInputPos
local dragStartFramePos

local function updateWindowDrag(input)
	local delta = input.Position - dragStartInputPos
	mainFrame.Position = UDim2.new(
		dragStartFramePos.X.Scale, dragStartFramePos.X.Offset + delta.X,
		dragStartFramePos.Y.Scale, dragStartFramePos.Y.Offset + delta.Y
	)
end

local function onDragInputStateChanged(input)
	if input.UserInputState == Enum.UserInputState.End then
		isDraggingWindow = false
	end
end

local function onTopBarInputBegan(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		closeAnyOpenDropdown()
		isDraggingWindow = true
		dragStartInputPos = input.Position
		dragStartFramePos = mainFrame.Position
		input.Changed:Connect(function()
			onDragInputStateChanged(input)
		end)
	end
end

local function onTopBarInputChanged(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end

local function onGlobalInputChanged(input)
	if input == dragInput and isDraggingWindow then
		updateWindowDrag(input)
	end
end

