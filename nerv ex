	-- API pública de um card (métodos com ":").
	local function makeCardApi(body, entry)
		entry.body = body
		local api = {}
		local function wrap(fn)
			return function(_, o)
				local result = fn(body, entry, o or {})
				updateDividers(body)
				return result
			end
		end
		api.AddToggle = wrap(addToggle)
		api.AddDropdown = wrap(addDropdown)
		api.AddMultiDropdown = wrap(addMultiDropdown)
		api.AddSlider = wrap(addSlider)
		api.AddProgressBar = wrap(addProgressBar)
		api.AddKeybind = wrap(addKeybind)
		api.AddTextbox = wrap(addTextbox)
		api.AddButton = wrap(addButton)
		api.AddLabel = wrap(addLabel)
		function api:AddSeparator()
			local result = addSeparator(body)
			updateDividers(body)
			return result
		end
		return api
	end

