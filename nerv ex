	-- ---------- KEY INPUT (status + textbox) ----------
	local function addKeyInput(body, entry, o)
		local statusRow = newFrame({Name = "KeyStatusRow", Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1}, body)
		statusRow.LayoutOrder = nextOrder(body)
		registerRow(entry, statusRow, "key status")

		local statusLabel = newLabel({
			Size = UDim2.new(1, 0, 1, 0),
			Text = "",
			TextSize = 11,
		}, statusRow)

		-- state: "valid" | "invalid" | "required" | "disabled"
		local function setKeyStatus(state)
			local color, text
			if state == "valid" then
				color, text = COLORS.Success, "✔ Key válida"
			elseif state == "invalid" then
				color, text = COLORS.Danger, "✕ Key inválida"
			elseif state == "required" then
				color, text = COLORS.TextMuted, "• Key necessária para ativar as automações"
			else
				color, text = COLORS.TextMuted, "• Key system desativado"
			end
			statusLabel.Text = text
			statusLabel.TextColor3 = color
		end

		local function onSubmitted(text)
			local key = trim(text)
			if key == "" then
				showNotification("Key System", "Digite uma key.", "error")
				return
			end
			local valid = isKeyValid(key)
			keyValue = valid and key or ""
			setKeyUnlocked(valid)
			setKeyStatus(valid and "valid" or "invalid")
			setFlag("KeySystem.Unlocked", keyUnlocked)
			showNotification("Key System",
				valid and "Key válida — automação liberada." or "Key inválida.", valid and "success" or "error")
			fire(o.Callback, valid)
		end

		local api = addTextbox(body, entry, {
			Title = o.Title or "Insert Key",
			Description = o.Description or "Cole sua key para liberar a automação.",
			Placeholder = o.Placeholder or "Sua key aqui...",
			ButtonText = o.ButtonText or "Insert",
			Callback = onSubmitted,
		})

		if not keyEnabled then
			setKeyStatus("disabled")
		elseif keyUnlocked then
			api:Set(keyValue)
			setKeyStatus("valid")
		else
			setKeyStatus("required")
		end
		return api
	end

