end

local function fadeSwitch(canvasGroup, onMidpoint)
	local halfSpeed = FADE_SPEED / 2

	local fadeOutTween = TweenService:Create(
		canvasGroup,
		TweenInfo.new(halfSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{GroupTransparency = 1}
	)

	local function onFadeOutFinished()
		if onMidpoint then
			onMidpoint()
		end

		local fadeInTween = TweenService:Create(
			canvasGroup,
			TweenInfo.new(halfSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{GroupTransparency = 0}
		)
		fadeInTween:Play()
	end

	fadeOutTween.Completed:Once(onFadeOutFinished)
	fadeOutTween:Play()
end

