	-- Escala automática: a janela nunca passa do tamanho da tela (útil no mobile),
	-- e o slider "UI Scale" (página Settings) ajusta dentro desse limite.
	local hasMovedWindow = false

	local function clampCenter(cx, cy)
		local screen = screenGui.AbsoluteSize
		local half = mainFrame.AbsoluteSize / 2
		cx = math.clamp(cx, math.min(half.X, screen.X / 2), math.max(screen.X - half.X, screen.X / 2))
		local extra = topExtra * uiScale.Scale
		cy = math.clamp(cy, math.min(half.Y + extra, screen.Y / 2), math.max(screen.Y - half.Y, screen.Y / 2))
		return cx, cy
	end

	local function clampWindow()
		if not hasMovedWindow then return end
		local center = mainFrame.AbsolutePosition + mainFrame.AbsoluteSize / 2 - screenGui.AbsolutePosition
		local cx, cy = clampCenter(center.X, center.Y)
		mainFrame.Position = UDim2.fromOffset(cx, cy)
	end

	applyScale = function()
		local screen = screenGui.AbsoluteSize
		if screen.X <= 0 or screen.Y <= 0 then return end
		local fitMax = math.min((screen.X - 20) / WINDOW_W, (screen.Y - 20 - topExtra) / WINDOW_H)
		uiScale.Scale = math.clamp(math.min(fitMax, FIXED_SCALE), 0.4, 1.5)
		clampWindow()
	end
	track(screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		closeAnyOpenDropdown()
		applyScale()
	end))

