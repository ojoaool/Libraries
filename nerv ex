					tw(kBtn, 0.15, {BackgroundTransparency = 0.25})
					springAnimate(kBtn, "Size", UDim2.new(0, math.floor(70 * SC), 0, math.floor(28 * SC)), 280, 22, 1)
					playSound(0.08, 1.0)
					setFlag(flag, currentKey.Name)
					fire(o.Callback, currentKey)
					conn:Disconnect()
				end
			end))
		end)

		local api = {Row = card, Button = kBtn}
		-- Set aceita KeyCode ou nome ("F"). noCallback = true não dispara o Callback.
		function api:Set(k, noCallback)
			if type(k) == "string" then
				local resolved = keyCodeFromName(k, nil)
				if not resolved then return end
				k = resolved
			end
			if typeof(k) ~= "EnumItem" then return end
			currentKey = k
			kBtn.Text = k.Name
			setFlag(flag, k.Name)
			if not noCallback then fire(o.Callback, currentKey) end
		end
		function api:Get() return currentKey end
		if flag then keybindElements[flag] = api end

		-- O Expensive dispara os callbacks de todos os elementos depois de carregar a config,
		-- pra lógica ficar igual ao visual. Aqui: uma vez, logo depois do script terminar.
		task.defer(function()
			if not unloaded then fire(o.Callback, currentKey) end
		end)
		return api
	end

