	local notificationContainer = newFrame({
		Name = "NotificationContainer",
		Size = UDim2.new(0, 260, 1, -20),
		Position = UDim2.new(1, -14, 1, -14),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundTransparency = 1,
