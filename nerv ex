-- ================== JANELA ==================
function Library:CreateWindow(opts)
	opts = opts or {}
	ensureFonts()
	SND_ON = opts.Sounds ~= false
	local SC = getScale() -- escala do Expensive (usada pelo keybind)

	local title = tostring(opts.Title or "NERV")
	local subtitle = tostring(opts.Subtitle or "")
	local windowId = tostring(opts.Id or title)
	local WINDOW_W = (opts.Size and opts.Size.X) or 940
	local WINDOW_H = (opts.Size and opts.Size.Y) or 580
	local FADE_SPEED = 0.18
	local MAX_TOASTS = 4

	-- Instância única por Id: criar de novo descarrega a janela anterior.
	env.__NervLibWindows = env.__NervLibWindows or {}
	local previous = env.__NervLibWindows[windowId]
	if previous and previous.Unload then
		pcall(previous.Unload)
	end
	local guiName = "NervLib_" .. windowId
	local oldGui = playerGui:FindFirstChild(guiName)
	if oldGui then oldGui:Destroy() end

	local Window = {Flags = {}, Pages = {}}
	local changedEvent = Instance.new("BindableEvent")
	Window.Changed = changedEvent.Event

	-- ---------- Conexões / limpeza ----------
	local connections = {}
	local function track(connection)
		connections[#connections + 1] = connection
		return connection
	end

	-- Forward declarations (preenchidas mais abaixo)
	local screenGui, mainFrame, overlay, overlayCatcher, uiScale, contentCanvas
	local showNotification, updateActivePage, applySearch, setUiVisible, applyScale
	local closeOpenDropdown
	local unloaded = false

	local function closeAnyOpenDropdown()
		if closeOpenDropdown then
			local closeFn = closeOpenDropdown
			closeOpenDropdown = nil
			closeFn()
		end
	end

	-- ---------- Persistência (por flag) ----------
	local configFile = opts.ConfigFile or ("NervLib_" .. (string.gsub(windowId, "[^%w_%-]", "_")) .. ".json")
	local saveDisabled = false
	local savedFlags, savedKey = {}, ""

	pcall(function()
		if isfile and isfile(configFile) then
			local data = HttpService:JSONDecode(readfile(configFile))
			if type(data) == "table" then
				if type(data.Flags) == "table" then savedFlags = data.Flags end
				if type(data.Key) == "string" then savedKey = data.Key end
			end
		end
	end)
	Window.HadSavedConfig = next(savedFlags) ~= nil

	-- Lê um valor salvo validando o tipo (e tratando corretamente o valor `false`).
	local function saved(flag, default)
		if not flag then return default end
		local v = savedFlags[flag]
		if v == nil then return default end
		if default ~= nil and type(v) ~= type(default) then return default end
		return v
	end

	local keyValue = ""
	local configDirty, saveScheduled = false, false

	local function saveConfig()
		configDirty = false
		if saveDisabled then return end
		pcall(function()
			if writefile then
				writefile(configFile, HttpService:JSONEncode({
					Version = 1,
					Flags = Window.Flags,
					Key = keyValue,
				}))
			end
		end)
	end

	-- Debounce por task.delay: agrupa mudanças e grava 1x por segundo.
	local function markConfigDirty()
		configDirty = true
		if saveScheduled then return end
		saveScheduled = true
		task.delay(1, function()
			saveScheduled = false
			if configDirty then saveConfig() end
		end)
	end

	-- Ponto único de "algo mudou": atualiza a flag, dispara o evento público e agenda o autosave.
	local function setFlag(flag, value)
		if not flag or unloaded then return end
		Window.Flags[flag] = value
		changedEvent:Fire(flag, value)
		markConfigDirty()
	end

	-- Valor inicial (restaurado ou padrão), sem disparar evento.
	local function initFlag(flag, value)
		if flag then Window.Flags[flag] = value end
	end

	-- ---------- Key system ----------
	local keyCfg = opts.KeySystem or {}
	local keyEnabled = keyCfg.Enabled == true
	local validKeys = {}
	for _, k in ipairs(keyCfg.Keys or {}) do
		validKeys[string.upper(trim(k))] = true
	end
	local function isKeyValid(text)
		return validKeys[string.upper(trim(text))] == true
	end

	local keyUnlocked = (not keyEnabled) or isKeyValid(savedKey)
	if keyEnabled and keyUnlocked then keyValue = savedKey end

	-- Toggles com RequiresKey registram aqui um "forçar desligado".
	local gatedToggles = {}

	local function setKeyUnlocked(isValid)
		keyUnlocked = isValid or not keyEnabled
		if not keyUnlocked then
			for _, forceOff in ipairs(gatedToggles) do
				forceOff()
			end
		end
	end

	-- ---------- Notificações ativas? (flag da página Settings, se existir) ----------
	local function notificationsEnabled()
		local v = Window.Flags["Settings.Notifications"]
		if v == nil then v = savedFlags["Settings.Notifications"] end
		return v ~= false
	end

	-- ================== COMPONENTES ==================
	local function registerRow(entry, row, text)
		entry.rows[#entry.rows + 1] = {frame = row, text = string.lower(text)}
	end

	local function addRowHeader(row, rowTitle, description, widthScale)
		newLabel({
			Name = "Title",
			Size = UDim2.new(widthScale, 0, 0, 15),
			Text = rowTitle,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			Truncate = true,
		}, row)
		newLabel({
			Name = "Description",
			Size = UDim2.new(widthScale, 0, 0, 14),
			Position = UDim2.new(0, 0, 0, 17),
			Text = description,
			TextColor3 = COLORS.TextMuted,
			TextSize = 11,
			Truncate = true,
		}, row)
	end

	-- ---------- DROPDOWN ----------
	local function addDropdown(body, entry, o)
		local rowTitle, description = o.Title or "Dropdown", o.Description or ""
		local flag = o.Flag
		local currentOptions = o.Options or {}

		local row = newFrame({Name = "DropdownRow", Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1}, body)
		row.LayoutOrder = nextOrder(body)
		addRowHeader(row, rowTitle, description, 0.5)
		registerRow(entry, row, rowTitle .. " " .. description)

		local dropdownBtn = newButton({
			Name = "Dropdown",
			Size = UDim2.new(0.46, 0, 0, 28),
			Position = UDim2.new(0.54, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = COLORS.Field,
			Corner = 6,
		}, row)
		stroke(dropdownBtn, COLORS.PanelBorder, 1)
		addHover(dropdownBtn, COLORS.Field, COLORS.FieldHover)

		-- índice inicial: valor salvo > Default (valor ou índice) > 1
		local startIndex = 1
		local savedValue = flag and savedFlags[flag]
		if type(savedValue) == "string" and findOptionIndex(currentOptions, savedValue, nil) then
			startIndex = findOptionIndex(currentOptions, savedValue, 1)
		elseif type(o.Default) == "number" then
			startIndex = o.Default
		elseif o.Default ~= nil then
			startIndex = findOptionIndex(currentOptions, o.Default, 1)
		end
		local selectedIndex = math.clamp(startIndex, 1, math.max(#currentOptions, 1))
		initFlag(flag, currentOptions[selectedIndex])

		local valueLabel = newLabel({
			Size = UDim2.new(1, -34, 1, 0),
			Position = UDim2.new(0, 10, 0, 0),
			Text = currentOptions[selectedIndex] or "",
			TextSize = 12,
			Truncate = true,
		}, dropdownBtn)

		local _, setChevronOpen = createChevron(dropdownBtn)
		addDivider(row)

		local listFrame
		local ROW_HEIGHT = 26

		local function closeList()
			if not listFrame then return end
			setChevronOpen(false)
			overlayCatcher.Visible = false

			local frameToClose = listFrame
			listFrame = nil
			if closeOpenDropdown == closeList then
				closeOpenDropdown = nil
			end

			local closeTween = TweenService:Create(frameToClose,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{Size = UDim2.new(0, frameToClose.Size.X.Offset, 0, 0)})
			closeTween.Completed:Once(function()
				frameToClose:Destroy()
			end)
			closeTween:Play()
		end

		-- Aplica uma seleção: atualiza texto, flag e callback.
		local function commit(index)
			selectedIndex = index
			local value = currentOptions[index]
			valueLabel.Text = value or ""
			setFlag(flag, value)
			fire(o.Callback, value, index)
		end

		local function openList()
			closeAnyOpenDropdown()
			setChevronOpen(true)
			overlayCatcher.Visible = true

			-- O overlay vive dentro do mainFrame (herda o UIScale), então as medidas
			-- absolutas (pixels da tela) são divididas pela escala atual.
			local scale = uiScale.Scale
			local targetHeight = #currentOptions * ROW_HEIGHT
			local btnPos, btnSize = dropdownBtn.AbsolutePosition, dropdownBtn.AbsoluteSize
			local ovPos = overlay.AbsolutePosition
			local screenBottom = screenGui.AbsolutePosition.Y + screenGui.AbsoluteSize.Y
			local openUp = (btnPos.Y + btnSize.Y + 4 + targetHeight * scale) > screenBottom

			local width = btnSize.X / scale
			local x = (btnPos.X - ovPos.X) / scale

			listFrame = newFrame({
				Name = "DropdownList",
				BackgroundColor3 = COLORS.Field,
				Corner = 6,
				ClipsDescendants = true,
			}, overlay)
			listFrame.ZIndex = 201
			stroke(listFrame, COLORS.PanelBorder, 1)

			local listLayout = Instance.new("UIListLayout")
			listLayout.SortOrder = Enum.SortOrder.LayoutOrder
			listLayout.Parent = listFrame

			if openUp then
				listFrame.AnchorPoint = Vector2.new(0, 1)
				listFrame.Position = UDim2.new(0, x, 0, (btnPos.Y - ovPos.Y) / scale - 4)
			else
				listFrame.Position = UDim2.new(0, x, 0, (btnPos.Y - ovPos.Y + btnSize.Y) / scale + 4)
			end
			listFrame.Size = UDim2.new(0, width, 0, 0)

			for i, optionText in ipairs(currentOptions) do
				local isSelected = (i == selectedIndex)
				local baseColor = isSelected and COLORS.SelectedBg or COLORS.Field
				local optionBtn = newButton({
					Name = "Option" .. i,
					Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
					BackgroundColor3 = baseColor,
					Text = optionText,
					TextSize = 12,
					TextColor3 = isSelected and COLORS.Accent or COLORS.TextPrimary,
				}, listFrame)
				optionBtn.LayoutOrder = i
				optionBtn.ZIndex = 202
				optionBtn.TextXAlignment = Enum.TextXAlignment.Left
				optionBtn.TextTruncate = Enum.TextTruncate.AtEnd
				addHover(optionBtn, baseColor, COLORS.SelectedBg)

				local optionPadding = Instance.new("UIPadding")
				optionPadding.PaddingLeft = UDim.new(0, 10)
				optionPadding.PaddingRight = UDim.new(0, 10)
				optionPadding.Parent = optionBtn

				optionBtn.MouseButton1Click:Connect(function()
					closeList()
					commit(i)
				end)
			end

			TweenService:Create(listFrame,
				TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Size = UDim2.new(0, width, 0, targetHeight)}):Play()

			closeOpenDropdown = closeList
		end

		dropdownBtn.MouseButton1Click:Connect(function()
			if listFrame then closeList() else openList() end
		end)

		local api = {Row = row}
		function api:Get()
			return currentOptions[selectedIndex], selectedIndex
		end
		function api:Set(value)
			local index = findOptionIndex(currentOptions, value, nil)
			if index then commit(index) end
		end
		-- Troca a lista de opções (ex.: estágios que dependem de outro dropdown).
		function api:SetOptions(newOptions, preferredValue)
			closeList()
			currentOptions = newOptions or {}
			commit(findOptionIndex(currentOptions, preferredValue, 1))
		end

		if o.CallOnLoad then fire(o.Callback, currentOptions[selectedIndex], selectedIndex) end
		return api
	end

	-- ---------- SLIDER ----------
	local function addSlider(body, entry, o)
		local rowTitle, description = o.Title or "Slider", o.Description or ""
		local flag = o.Flag
		local min, max = o.Min or 0, o.Max or 100
		local step = o.Step or 1
		local suffix = o.Suffix or ""

		local row = newFrame({Name = "SliderRow", Size = UDim2.new(1, 0, 0, 58), BackgroundTransparency = 1}, body)
		row.LayoutOrder = nextOrder(body)
		addRowHeader(row, rowTitle, description, 0.6)
		registerRow(entry, row, rowTitle .. " " .. description)

		local valueLabel = newLabel({
			Size = UDim2.new(0.4, -4, 0, 15),
			Position = UDim2.new(0.6, 4, 0, 0),
			Text = "",
			TextSize = 12,
			TextColor3 = COLORS.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)

		local sliderTrack = newFrame({
			Name = "SliderTrack",
			Size = UDim2.new(1, 0, 0, 6),
			Position = UDim2.new(0, 0, 0, 40),
			BackgroundColor3 = COLORS.ToggleOff,
			Corner = 3,
		}, row)

		local fill = newFrame({
			Name = "SliderFill",
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = COLORS.Accent,
			Corner = 3,
		}, sliderTrack)

		local knob = newFrame({
			Name = "SliderKnob",
			Size = UDim2.new(0, 14, 0, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = COLORS.Knob,
			Corner = 7,
		}, sliderTrack)

		local dragCatcher = Instance.new("TextButton")
		dragCatcher.Name = "SliderDragCatcher"
		dragCatcher.BackgroundTransparency = 1
		dragCatcher.Size = UDim2.new(1, 0, 0, 20)
		dragCatcher.Position = UDim2.new(0, 0, 0.5, -10)
		dragCatcher.Text = ""
		dragCatcher.Parent = sliderTrack

		local function snap(value)
			value = math.clamp(value, min, max)
			value = math.floor((value - min) / step + 0.5) * step + min
			return math.clamp(value, min, max)
		end

		local currentValue = snap(saved(flag, o.Default or min))
		initFlag(flag, currentValue)
		local fillTween, knobTween

		local function render(animate)
			local ratio = (currentValue - min) / (max - min)
			valueLabel.Text = tostring(currentValue) .. suffix
			if fillTween then fillTween:Cancel() end
			if knobTween then knobTween:Cancel() end
			if animate then
				local info = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				fillTween = TweenService:Create(fill, info, {Size = UDim2.new(ratio, 0, 1, 0)})
				knobTween = TweenService:Create(knob, info, {Position = UDim2.new(ratio, 0, 0.5, 0)})
				fillTween:Play()
				knobTween:Play()
			else
				fill.Size = UDim2.new(ratio, 0, 1, 0)
				knob.Position = UDim2.new(ratio, 0, 0.5, 0)
			end
		end

		local isDragging = false

		local function updateFromInput(input)
			local ratio = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
			local newValue = snap(min + (max - min) * ratio)
			if newValue ~= currentValue then
				currentValue = newValue
				render(true)
				setFlag(flag, currentValue)
				fire(o.Callback, currentValue, false)
			end
		end

		dragCatcher.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				closeAnyOpenDropdown()
				isDragging = true
				updateFromInput(input)
			end
		end)

		-- Movimento e soltar são globais: soltar o mouse fora da barrinha também encerra o arraste.
		track(UserInputService.InputChanged:Connect(function(input)
			if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				updateFromInput(input)
			end
		end))
		track(UserInputService.InputEnded:Connect(function(input)
			if isDragging and (input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch) then
				isDragging = false
				fire(o.Callback, currentValue, true)
			end
		end))

		render(false)
		addDivider(row)

		local api = {Row = row}
		function api:Get() return currentValue end
		function api:Set(value)
			currentValue = snap(value)
			render(false)
			setFlag(flag, currentValue)
			fire(o.Callback, currentValue, true)
		end

		if o.CallOnLoad then fire(o.Callback, currentValue, true) end
		return api
	end


	-- ---------- KEYBIND ----------
	-- MESMO SISTEMA DO EXPENSIVE HUB:
	--  * AddKeybind só ESCOLHE a tecla. Seu Callback(keyCode) roda quando a tecla é TROCADA
	--    (e uma vez ao carregar, com a tecla salva) — não quando a tecla é apertada.
	--  * A ação fica num atalho global: Window:RegisterKeybind(nome, tecla, callback).
	--    Ligue os dois: Callback = function(key) Window:SetKeybindKey(nome, key) end
	local customKeybinds = {}   -- nome -> {Key, Callback, Enabled}
	local keybindElements = {}  -- flag -> api do AddKeybind (pra atualizar o botão por código)
	local isAnyKeybindListening = false
	local refreshKeybindViewer  -- definido junto da lista Ctrl+B (mais abaixo)

	-- Aceita KeyCode ou nome ("F", "RightShift"); nil se for inválido.
	local function toKeyCode(key)
		if typeof(key) == "EnumItem" then return key end
		if type(key) == "string" then return keyCodeFromName(key, nil) end
		return nil
	end

	-- Tecla de mostrar/esconder a janela (restaurada do arquivo, se houver).
	local toggleKeyCode = keyCodeFromName(savedFlags["Window.Toggle"], opts.ToggleKey or Enum.KeyCode.Insert)

	-- 1) mostrar/esconder a janela (ignora se estiver digitando num TextBox)
	track(UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == toggleKeyCode then
			if UserInputService:GetFocusedTextBox() then return end
			if isAnyKeybindListening then return end
			setUiVisible(not mainFrame.Visible)
		end
	end))

	-- 2) atalhos registrados com RegisterKeybind
	track(UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if isAnyKeybindListening then return end
		for _, kb in pairs(customKeybinds) do
			if kb.Enabled and kb.Key == input.KeyCode and kb.Callback then
				task.spawn(fire, kb.Callback)
			end
		end
	end))

	-- 3) Ctrl+B abre/fecha a lista de atalhos; Esc fecha dropdown aberto
	track(UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.Escape and closeOpenDropdown then
			closeAnyOpenDropdown()
			return
		end
		if opts.KeybindViewer ~= false and input.KeyCode == Enum.KeyCode.B
			and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			if Window:IsKeybindViewerVisible() then
				Window:HideKeybindViewer()
			else
				Window:ShowKeybindViewer()
			end
		end
	end))


