-- Todas as funções aceitam um repositório opcional `g` ({User, Repo, Branch});
-- sem ele usam Library.Github.
local function rawUrl(repoPath, g)
	g = g or Library.Github
	return string.format("https://raw.githubusercontent.com/%s/%s/%s/%s", g.User, g.Repo, g.Branch or "main", repoPath)
end

local function ensureFolders(fullPath)
	if not (makefolder and isfolder) then return end
	local current = ""
	for segment in string.gmatch(fullPath, "[^/]+") do
		current = current == "" and segment or (current .. "/" .. segment)
		pcall(function()
			if not isfolder(current) then makefolder(current) end
		end)
	end
end

-- Baixa "icons/x.png" para workspace/<CacheDir>/<user>_<repo>/icons/x.png (com cache). Retorna caminho local ou nil.
local function downloadToCache(repoPath, g)
	if not (writefile and isfile) then return nil end
	g = g or Library.Github
	-- o cache inclui user/repo pra não misturar arquivos de repositórios diferentes
	local localPath = string.format("%s/%s_%s/%s", Library.CacheDir, g.User, g.Repo, repoPath)
	ensureFolders(localPath:match("^(.*)/[^/]+$") or Library.CacheDir)

	if not isfile(localPath) then
		local ok, data = pcall(function() return game:HttpGet(rawUrl(repoPath, g)) end)
		if not ok or type(data) ~= "string" or #data == 0 or data:sub(1, 3) == "404" then
			return nil
		end
		if not pcall(writefile, localPath, data) then return nil end
	end
	return localPath
end

-- ---------- Fontes ----------
local FONTS = {
	Title = Font.fromEnum(Enum.Font.GothamBold),
	Body  = Font.fromEnum(Enum.Font.GothamMedium),
}
local fontsLoaded = false

local function loadFont(spec, fallbackEnum)
	local fallback = Font.fromEnum(fallbackEnum)
	if not spec or not (getcustomasset and writefile) then return fallback end

	local ttfPath = downloadToCache(spec.File)
	if not ttfPath then return fallback end

	local ok, face = pcall(function()
		local familyPath = Library.CacheDir .. "/" .. spec.Family .. ".json"
		writefile(familyPath, HttpService:JSONEncode({
			name = spec.Family,
			faces = {{
				name = "Regular",
				weight = 400,
				style = "normal",
				assetId = getcustomasset(ttfPath),
			}},
		}))
		return Font.new(getcustomasset(familyPath))
	end)
	return ok and face or fallback
end

local function ensureFonts()
	if fontsLoaded then return end
	fontsLoaded = true
	ensureFolders(Library.CacheDir)
	FONTS.Title = loadFont(Library.FontFiles.Title, Enum.Font.GothamBold)
	FONTS.Body  = loadFont(Library.FontFiles.Body, Enum.Font.GothamMedium)
end

-- ================== HELPERS GERAIS ==================
local function trim(text)
	return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function fire(callback, ...)
	if type(callback) ~= "function" then return end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[NervLib] erro em callback: " .. tostring(err))
	end
end

local function findOptionIndex(options, value, fallback)
	if value ~= nil then
		for i, opt in ipairs(options) do
			if opt == value then return i end
		end
	end
	return fallback
end

local function keyCodeFromName(name, fallback)
	if type(name) ~= "string" then return fallback end
	local ok, keyCode = pcall(function() return Enum.KeyCode[name] end)
	if ok and typeof(keyCode) == "EnumItem" then return keyCode end
	return fallback
end

local function corner(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = inst
	return c
end

local function stroke(inst, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or COLORS.PanelBorder
	s.Thickness = thickness or 1
	s.Parent = inst
	return s
end

local function newFrame(props, parent)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.BackgroundColor3 or COLORS.Panel
	f.BackgroundTransparency = props.BackgroundTransparency or 0
	f.BorderSizePixel = 0
	f.Size = props.Size or UDim2.new(1, 0, 1, 0)
	f.Position = props.Position or UDim2.new(0, 0, 0, 0)
	f.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	f.Name = props.Name or "Frame"
	if props.Visible ~= nil then f.Visible = props.Visible end
	if props.ClipsDescendants then f.ClipsDescendants = true end
	f.Parent = parent
	if props.Corner then corner(f, props.Corner) end
	if props.StrokeColor then stroke(f, props.StrokeColor) end
	return f
end

-- Regra de fontes: o que é pedido como GothamBold vira a fonte de título; o resto vira a fonte base.
local function fontFor(requestedFont)
	if requestedFont == Enum.Font.GothamBold then
		return FONTS.Title
	end
	return FONTS.Body
end

local function newLabel(props, parent)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = props.Size or UDim2.new(1, 0, 0, 20)
	l.Position = props.Position or UDim2.new(0, 0, 0, 0)
	l.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	l.FontFace = fontFor(props.Font)
	l.Text = props.Text or ""
	l.TextColor3 = props.TextColor3 or COLORS.TextPrimary
	l.TextSize = props.TextSize or 14
	l.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	l.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	l.TextWrapped = props.TextWrapped or false
	if props.Truncate then l.TextTruncate = Enum.TextTruncate.AtEnd end
	l.Name = props.Name or "Label"
	l.Parent = parent
	return l
end

local function newButton(props, parent)
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = props.BackgroundColor3 or COLORS.Field
	b.BackgroundTransparency = props.BackgroundTransparency or 0
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Size = props.Size or UDim2.new(1, 0, 0, 30)
	b.Position = props.Position or UDim2.new(0, 0, 0, 0)
	b.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	b.FontFace = fontFor(props.Font)
	b.Text = props.Text or ""
	b.TextColor3 = props.TextColor3 or COLORS.TextPrimary
	b.TextSize = props.TextSize or 14
	b.Name = props.Name or "Button"
	b.Parent = parent
	if props.Corner then corner(b, props.Corner) end
	return b
end

-- ---------- Ícones ----------
-- Aceita número, "rbxassetid://..." ou "gh:caminho". Sem asset (ou falha no download) => texto/emoji.
local assetCache = {}

local function normalizeAsset(spec)
	if type(spec) == "number" then return "rbxassetid://" .. spec end
	if type(spec) == "string" and spec ~= "" then
		if tonumber(spec) then return "rbxassetid://" .. spec end
		return spec
	end
	return nil
end

local function resolveGithubAsset(repoPath, g)
	g = g or Library.Github
	-- a chave inclui o repositório pra não misturar arquivos com o mesmo caminho
	local key = g.User .. "/" .. g.Repo .. "/" .. repoPath
	if assetCache[key] then return assetCache[key] end
	local path = downloadToCache(repoPath, g)
	if path and getcustomasset then
		local ok, asset = pcall(getcustomasset, path)
		if ok and asset then
			assetCache[key] = asset
			return asset
		end
	end
	return nil
end

local function createIcon(props, parent)
	local spec = normalizeAsset(props.AssetId)
	local color = props.ImageColor3 or COLORS.TextPrimary
	local size = props.Size or UDim2.new(0, 20, 0, 20)
	local position = props.Position or UDim2.new(0, 0, 0, 0)
	local anchor = props.AnchorPoint or Vector2.new(0, 0)

	if spec and spec ~= "rbxassetid://0" then
		local img = Instance.new("ImageLabel")
		img.Name = props.Name or "Icon"
		img.BackgroundTransparency = 1
		img.Size = size
		img.Position = position
		img.AnchorPoint = anchor
		img.ImageColor3 = color
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = parent

		local fallback = newLabel({
			Name = "Fallback",
			Size = UDim2.new(1, 0, 1, 0),
			Text = props.FallbackText or "•",
			TextSize = props.TextSize or 16,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Center,
		}, img)

		if spec:sub(1, 3) == "gh:" then
			-- download assíncrono: o emoji aparece até a imagem chegar
			task.spawn(function()
				local asset = resolveGithubAsset(spec:sub(4))
				if asset and img.Parent then
					img.Image = asset
					fallback.Visible = false
				end
			end)
		else
			img.Image = spec
			fallback.Visible = false
		end
		return img
	end

	return newLabel({
		Name = props.Name or "IconFallback",
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		Text = props.FallbackText or "•",
		TextSize = props.TextSize or 16,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
	}, parent)
end

local function setIconColor(icon, color)
	if icon:IsA("ImageLabel") then
		icon.ImageColor3 = color
		local fallback = icon:FindFirstChild("Fallback")
		if fallback then fallback.TextColor3 = color end
	else
		icon.TextColor3 = color
	end
end

-- Hover suave de cor de fundo (as conexões morrem junto com o botão).
local function addHover(btn, normalColor, hoverColor)
	local info = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, info, {BackgroundColor3 = hoverColor}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, info, {BackgroundColor3 = normalColor}):Play()
	end)
end

-- LayoutOrder por container (cada card tem sua própria contagem).
local function nextOrder(parent)
	local n = (parent:GetAttribute("RowCount") or 0) + 1
	parent:SetAttribute("RowCount", n)
	return n
end

local function addDivider(parent)
	return newFrame({
		Name = "RowDivider",
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = COLORS.Divider,
	}, parent)
end

-- Esconde o divisor da última linha visível do card (a última não leva linha embaixo).
-- Considera só os elementos que TÊM um RowDivider.
local function updateDividers(body)
	local last, lastOrder = nil, -math.huge
	for _, child in ipairs(body:GetChildren()) do
		if child:IsA("Frame") and child.Visible and child:FindFirstChild("RowDivider") and child.LayoutOrder > lastOrder then
			last, lastOrder = child, child.LayoutOrder
		end
	end
	for _, child in ipairs(body:GetChildren()) do
		local divider = child:IsA("Frame") and child:FindFirstChild("RowDivider")
		if divider then
			divider.Visible = (child ~= last)
		end
	end
end

-- Chevron do dropdown: sempre gira 180° ao abrir/fechar.
local function createChevron(parent)
	local icon = createIcon({
		Name = "Chevron",
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -26, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		AssetId = Library.Icons.ChevronDown,
		FallbackText = "⌄",
		TextSize = 14,
		ImageColor3 = COLORS.TextMuted,
	}, parent)

	local function setOpen(isOpen)
		TweenService:Create(icon, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Rotation = isOpen and 180 or 0}):Play()
	end
	return icon, setOpen
end

-- ================== JANELA ==================
function Library:CreateWindow(opts)
	opts = opts or {}
	ensureFonts()

	local title = tostring(opts.Title or "NERV")
	local subtitle = tostring(opts.Subtitle or "")
	local windowId = tostring(opts.Id or title)
	local WINDOW_W = (opts.Size and opts.Size.X) or 1020
	local WINDOW_H = (opts.Size and opts.Size.Y) or 640
	local FADE_SPEED = 0.18
	local MAX_TOASTS = 4
	local FIXED_SCALE = opts.Scale or 0.95 -- escala fixa da janela (limitada ao tamanho da tela)
	local topExtra = 0 -- pixels que o mascote ocupa acima da janela (usado pra não cortar no topo da tela)

	-- Instância única por Id: criar de novo descarrega a janela anterior.
	env.__NervLibWindows = env.__NervLibWindows or {}
	local previous = env.__NervLibWindows[windowId]
	if previous and previous.Unload then
		pcall(previous.Unload)
	end
	local guiName = "NervLib_" .. windowId
	local oldGui = playerGui:FindFirstChild(guiName)
	if oldGui then oldGui:Destroy() end

	local Window = {Flags = {}, Pages = {}}
	local changedEvent = Instance.new("BindableEvent")
	Window.Changed = changedEvent.Event

	-- ---------- Conexões / limpeza ----------
	local connections = {}
	local function track(connection)
		connections[#connections + 1] = connection
		return connection
	end
	-- Desconecta e remove da lista (evita acumular conexões de atalhos já atribuídos).
	local function untrack(connection)
		if not connection then return end
		pcall(function() connection:Disconnect() end)
		local idx = table.find(connections, connection)
		if idx then table.remove(connections, idx) end
	end

	-- Forward declarations (preenchidas mais abaixo)
	local screenGui, mainFrame, overlay, overlayCatcher, uiScale, contentCanvas
	local sidebar, navList -- usados pelo mascote
	local showNotification, updateActivePage, applySearch, setUiVisible, applyScale
	local closeOpenDropdown
	local unloaded = false

	local function closeAnyOpenDropdown()
		if closeOpenDropdown then
			local closeFn = closeOpenDropdown
			closeOpenDropdown = nil
			closeFn()
		end
	end

	-- ---------- Persistência (por flag) ----------
	local configFile = opts.ConfigFile or ("NervLib_" .. (string.gsub(windowId, "[^%w_%-]", "_")) .. ".json")
	local saveDisabled = false
	local savedFlags = {}

	pcall(function()
		if isfile and isfile(configFile) then
			local data = HttpService:JSONDecode(readfile(configFile))
			if type(data) == "table" then
				if type(data.Flags) == "table" then savedFlags = data.Flags end
			end
		end
	end)
	Window.HadSavedConfig = next(savedFlags) ~= nil

	-- Lê um valor salvo validando o tipo (e tratando corretamente o valor `false`).
	local function saved(flag, default)
		if not flag then return default end
		local v = savedFlags[flag]
		if v == nil then return default end
		if default ~= nil and type(v) ~= type(default) then return default end
		return v
	end

	local configDirty, saveScheduled = false, false

	local function saveConfig()
		configDirty = false
		if saveDisabled then return end
		pcall(function()
			if writefile then
				writefile(configFile, HttpService:JSONEncode({
					Version = 1,
					Flags = Window.Flags,
				}))
			end
		end)
	end

	-- Debounce por task.delay: agrupa mudanças e grava 1x por segundo.
	local function markConfigDirty()
		configDirty = true
		if saveScheduled then return end
		saveScheduled = true
		task.delay(1, function()
			saveScheduled = false
			if configDirty then saveConfig() end
		end)
	end

	-- Ponto único de "algo mudou": atualiza a flag, dispara o evento público e agenda o autosave.
	local function setFlag(flag, value)
		if not flag or unloaded then return end
		Window.Flags[flag] = value
		changedEvent:Fire(flag, value)
		markConfigDirty()
	end

	-- Valor inicial (restaurado ou padrão), sem disparar evento.
	local function initFlag(flag, value)
		if flag then Window.Flags[flag] = value end
	end

	-- ---------- Notificações ativas? (flag da página Settings, se existir) ----------
	local function notificationsEnabled()
		local v = Window.Flags["Settings.Notifications"]
		if v == nil then v = savedFlags["Settings.Notifications"] end
		return v ~= false
	end

	-- ================== COMPONENTES ==================
	local function registerRow(entry, row, text)
		entry.rows[#entry.rows + 1] = {frame = row, text = string.lower(text)}
	end

	-- Adiciona margem superior sutil (4px) para afastar o texto do divider anterior
	local function addRowHeader(row, rowTitle, description, widthScale)
		local rowPad = Instance.new("UIPadding")
		rowPad.PaddingTop = UDim.new(0, 4)
		rowPad.Parent = row

		newLabel({
			Name = "Title",
