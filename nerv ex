	-- Fade out -> troca no meio -> fade in. Trava durante a animação.
	local isSwitching = false
	local function fadeSwitch(canvasGroup, onMidpoint)
		if isSwitching then return end
		isSwitching = true
		local half = FADE_SPEED / 2

		local fadeOut = TweenService:Create(canvasGroup,
			TweenInfo.new(half, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
		fadeOut.Completed:Once(function()
			if onMidpoint then onMidpoint() end
			local fadeIn = TweenService:Create(canvasGroup,
				TweenInfo.new(half, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0})
			fadeIn.Completed:Once(function()
				isSwitching = false
			end)
			fadeIn:Play()
		end)
		fadeOut:Play()
	end

