-- Reconecta os toggles existentes pra também atualizarem o status (sem reescrever
-- os addToggleRow acima): um heartbeat leve de baixa frequência é mais simples e
-- seguro aqui do que encadear callbacks em cascata. O mesmo heartbeat também
-- descarrega o autosave de configuração (ver markConfigDirty/saveConfig).
local statusUpdateAccumulator = 0
local configSaveAccumulator = 0
local function onHeartbeat(deltaTime)
	statusUpdateAccumulator = statusUpdateAccumulator + deltaTime
	if statusUpdateAccumulator >= 0.25 then
		statusUpdateAccumulator = 0
		refreshQueueStatus()
	end

	if configDirty then
		configSaveAccumulator = configSaveAccumulator + deltaTime
		if configSaveAccumulator >= 1 then
			configSaveAccumulator = 0
			saveConfig()
		end
	end
end
