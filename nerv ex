	newFrame({
		Name = "AccentBar",
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accentColor,
	}, card).ZIndex = 300

	local textHolder = newFrame({
		Name = "TextHolder",
		Size = UDim2.new(1, -15, 0, 0),
		Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1,
