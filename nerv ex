			kBtn.Text = "..."
			playSound(0.08, 1.1)
			tw(kBtn, 0.15, {BackgroundTransparency = 0.05})
			springBounce(kBtn, "Size", UDim2.new(0, math.floor(74 * SC), 0, math.floor(30 * SC)), 4)

			local conn
			conn = track(UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe then return end
