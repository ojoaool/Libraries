local SoundService = game:GetService("SoundService")
local SND_ON = true
local SOUND_ID = "rbxassetid://876939830"
local soundInstance = nil

local function playSound(vol, pitch)
	if not SND_ON then return end
	pcall(function()
		if not soundInstance or not soundInstance.Parent then
			soundInstance = Instance.new("Sound")
			soundInstance.SoundId = SOUND_ID
			soundInstance.Parent = SoundService
		end
		soundInstance.Volume = vol or 0.12
		soundInstance.PlaybackSpeed = pitch or 1
		soundInstance:Play()
	end)
end

local function destroySound()
	if soundInstance then
		pcall(function() soundInstance:Destroy() end)
		soundInstance = nil
	end
end

-- Escala do Expensive: tudo do keybind é multiplicado por SC (depende do tamanho da tela).
local function getScale()
	local camera = workspace.CurrentCamera
	if not camera then return 1 end
	local vp = camera.ViewportSize
	return math.clamp(math.min(vp.X, vp.Y * 1.6) / 1080, 0.65, 1.15)
end

local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Card sobe `liftPx` pixels com mola ao passar o mouse (igual ao addHoverLift do Expensive Hub).
local function addHoverLift(frame, liftPx)
	if IS_MOBILE then return end
	liftPx = liftPx or 3
	local origPos = nil
	local lifting = false
	frame.MouseEnter:Connect(function()
		if lifting then return end
		lifting = true
		origPos = origPos or frame.Position
		springAnimate(frame, "Position", UDim2.new(
			origPos.X.Scale, origPos.X.Offset,
			origPos.Y.Scale, origPos.Y.Offset - liftPx
		), 300, 20, 0.8)
		playSound(0.04, 1.35)
	end)
	frame.MouseLeave:Connect(function()
		lifting = false
		if origPos then
			springAnimate(frame, "Position", origPos, 260, 22, 1)
		end
	end)
end

