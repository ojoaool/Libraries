-- ================== HELPERS ==================
local function corner(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = inst
	return c
end

local function stroke(inst, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or COLORS.PanelBorder
	s.Thickness = thickness or 1
	s.Parent = inst
	return s
end

-- Função nomeada: aplica um brilho suave (UIShadow com Offset zerado = espalha
-- simetricamente em vez de projetar sombra pra um lado, funcionando como glow).
-- Usada nos divisores do hub pra dar aquele contorno brilhante sutil.
local function glow(inst, color, transparency, blurRadius)
	local g = Instance.new("UIShadow")
	g.Color = color or Color3.fromRGB(255, 255, 255)
	g.Transparency = transparency or 0.75
	g.Offset = UDim2.new(0, 0, 0, 0)
	g.Spread = UDim2.new(0, 0, 0, 0)
	g.BlurRadius = blurRadius or UDim.new(0, 4)
	g.Parent = inst
	return g
end

local function newFrame(props, parent)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.BackgroundColor3 or COLORS.Panel
	f.BackgroundTransparency = props.BackgroundTransparency or 0
	f.BorderSizePixel = 0
	f.Size = props.Size or UDim2.new(1, 0, 1, 0)
	f.Position = props.Position or UDim2.new(0, 0, 0, 0)
	f.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	f.Name = props.Name or "Frame"
	f.Parent = parent
	if props.Corner then corner(f, props.Corner) end
	if props.Stroke then stroke(f, props.StrokeColor) end
	if props.ClipsDescendants then f.ClipsDescendants = true end
	if props.Glow then glow(f, props.GlowColor, props.GlowTransparency, props.GlowBlur) end
	return f
end

local function newLabel(props, parent)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = props.Size or UDim2.new(1, 0, 0, 20)
	l.Position = props.Position or UDim2.new(0, 0, 0, 0)
	l.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	l.Font = props.Font or Enum.Font.GothamMedium
	l.Text = props.Text or ""
	l.TextColor3 = props.TextColor3 or COLORS.TextPrimary
	l.TextSize = props.TextSize or 14
	l.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	l.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	l.TextWrapped = props.TextWrapped or false
	l.Name = props.Name or "Label"
	l.Parent = parent
	return l
end

local function createIcon(props, parent)
	local hasAsset = props.AssetId and props.AssetId ~= "" and props.AssetId ~= "rbxassetid://0"
	local imageColor = props.ImageColor3 or COLORS.TextPrimary

	if hasAsset then
		local img = Instance.new("ImageLabel")
		img.Name = props.Name or "Icon"
		img.BackgroundTransparency = 1
		img.Size = props.Size or UDim2.new(0, 20, 0, 20)
		img.Position = props.Position or UDim2.new(0, 0, 0, 0)
		img.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
		img.Image = props.AssetId
		img.ImageColor3 = imageColor
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = parent
		return img
	end

	local fallback = newLabel({
		Name = props.Name or "IconFallback",
		Size = props.Size or UDim2.new(0, 20, 0, 20),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		AnchorPoint = props.AnchorPoint,
		Text = props.FallbackText or "•",
		TextSize = props.TextSize or 16,
		TextColor3 = imageColor,
		TextXAlignment = Enum.TextXAlignment.Center,
	}, parent)
	return fallback
end

local function newButton(props, parent)
