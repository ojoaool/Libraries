local function createChevron(parent, size, position)
	local icon = createIcon({
		Name = "Chevron",
		Size = size or UDim2.new(0, 18, 1, 0),
		Position = position or UDim2.new(1, -22, 0, 0),
		AssetId = ASSETS.IconChevronDown,
		FallbackText = "⌄",
		TextSize = 13,
		ImageColor3 = COLORS.TextMuted,
	}, parent)

	local function setOpen(isOpen)
		if icon:IsA("ImageLabel") then
			icon.Image = isOpen and ASSETS.IconChevronUp or ASSETS.IconChevronDown
		else
			icon.Text = isOpen and "⌃" or "⌄"
		end
		-- Mini animação: gira o chevron 180° ao abrir/fechar (funciona pra imagem e fallback)
		TweenService:Create(
			icon,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Rotation = isOpen and 180 or 0}
		):Play()
	end

	return icon, setOpen
end

