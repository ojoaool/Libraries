	local function newTab(page, tabName, columns)
		local scroll = createScroll(tabName)

		local left = newFrame({
			Name = "LeftColumn",
			Size = columns == 1 and UDim2.new(1, 0, 0, 0) or UDim2.new(0.5, -6, 0, 0),
			BackgroundTransparency = 1,
		}, scroll)
		left.AutomaticSize = Enum.AutomaticSize.Y
		local leftLayout = Instance.new("UIListLayout")
		leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
		leftLayout.Padding = UDim.new(0, 10)
		leftLayout.Parent = left

		local right
		if columns ~= 1 then
			right = newFrame({
				Name = "RightColumn",
				Size = UDim2.new(0.5, -6, 0, 0),
				Position = UDim2.new(0.5, 6, 0, 0),
				BackgroundTransparency = 1,
			}, scroll)
			right.AutomaticSize = Enum.AutomaticSize.Y
			local rightLayout = Instance.new("UIListLayout")
			rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
			rightLayout.Padding = UDim.new(0, 10)
			rightLayout.Parent = right
		end

		local tab = {
			Name = tabName,
			Page = page,
			Columns = columns,
			Scroll = scroll,
			Left = left,
			Right = right,
			Cards = {},
			CardCount = 0,
		}

		function tab:AddCard(co)
			return createCard(tab, co)
		end
		function tab:Select()
			page.CurrentTab = tab
			styleTabs(page)
			updateActivePage()
		end
		return tab
	end

	function Window:AddPage(po)
		po = po or {}
		local page = {
			Name = tostring(po.Name or "Page"),
			Columns = po.Columns or 1,
			Tabs = {},
			CurrentTab = nil,
		}
		pages[#pages + 1] = page

		-- Item da sidebar
		local navBtn = newButton({
			Name = page.Name .. "Nav",
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = COLORS.Sidebar,
			Text = "",
			Corner = 10,
		}, navList)
		navBtn.LayoutOrder = #pages

		local navStroke = stroke(navBtn, COLORS.Accent, 1)
		navStroke.Transparency = 1

		local navIcon = createIcon({
			Size = UDim2.new(0, 24, 0, 24),
			Position = UDim2.new(0, 10, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			AssetId = po.Icon,
			FallbackText = po.IconFallback or "•",
			TextSize = 18,
			ImageColor3 = COLORS.TextMuted,
		}, navBtn)

		local navLabel = newLabel({
			Size = UDim2.new(1, -48, 1, 0),
			Position = UDim2.new(0, 42, 0, 0),
			Text = page.Name,
			Font = Enum.Font.GothamBold,
			TextColor3 = COLORS.TextMuted,
			TextSize = 15,
		}, navBtn)

		page.Nav = {Button = navBtn, Label = navLabel, Icon = navIcon, Stroke = navStroke}

		-- Hover só em itens inativos (o ativo mantém o fundo de destaque).
		navBtn.MouseEnter:Connect(function()
			if currentPage ~= page then
				TweenService:Create(navBtn, TweenInfo.new(0.1), {BackgroundColor3 = COLORS.FieldHover}):Play()
			end
		end)
		navBtn.MouseLeave:Connect(function()
			if currentPage ~= page then
				TweenService:Create(navBtn, TweenInfo.new(0.1), {BackgroundColor3 = COLORS.Sidebar}):Play()
			end
		end)
		navBtn.MouseButton1Click:Connect(function()
			if currentPage == page then return end
			closeAnyOpenDropdown()
			fadeSwitch(contentCanvas, function()
				setCurrentPage(page)
			end)
		end)

		-- Barra de abas desta página
		page.TabBarFrame = newFrame({
			Name = page.Name .. "TabBar",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Visible = false,
		}, tabBar)
		local tabLayout = Instance.new("UIListLayout")
		tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
		tabLayout.FillDirection = Enum.FillDirection.Horizontal
		tabLayout.Padding = UDim.new(0, 18)
		tabLayout.Parent = page.TabBarFrame

		function page:AddTab(to)
			to = to or {}
			local tabName = tostring(to.Name or ("Tab " .. (#page.Tabs + 1)))
			local tab = newTab(page, tabName, to.Columns or page.Columns)
			page.Tabs[#page.Tabs + 1] = tab

			local holder = newFrame({
				Name = tabName .. "Tab",
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundTransparency = 1,
			}, page.TabBarFrame)
			holder.AutomaticSize = Enum.AutomaticSize.X
			holder.LayoutOrder = #page.Tabs

			local btn = Instance.new("TextButton")
			btn.Name = "TabButton"
			btn.BackgroundTransparency = 1
			btn.Size = UDim2.new(0, 0, 1, -4)
			btn.AutomaticSize = Enum.AutomaticSize.X
			btn.FontFace = FONTS.Body
			btn.Text = tabName
			btn.TextColor3 = COLORS.TextMuted
			btn.TextSize = 14
			btn.Parent = holder

			local underline = newFrame({
				Name = "Underline",
				Size = UDim2.new(1, 0, 0, 2),
				Position = UDim2.new(0, 0, 1, -2),
				BackgroundColor3 = COLORS.Accent,
				Visible = false,
			}, holder)

			tab.Button, tab.Underline = btn, underline

			btn.MouseEnter:Connect(function()
				if page.CurrentTab ~= tab then btn.TextColor3 = COLORS.TextPrimary end
			end)
			btn.MouseLeave:Connect(function()
				if page.CurrentTab ~= tab then btn.TextColor3 = COLORS.TextMuted end
			end)
			btn.MouseButton1Click:Connect(function()
				if page.CurrentTab == tab then return end
				closeAnyOpenDropdown()
				fadeSwitch(contentCanvas, function()
					tab:Select()
				end)
			end)

			if not page.CurrentTab then page.CurrentTab = tab end
			styleTabs(page)
			updateActivePage()
			return tab
		end

		-- Sem abas explícitas, os cards vão pra uma aba padrão (a barra de abas fica oculta).
		function page:AddCard(co)
			local tab = page.Tabs[1] or page:AddTab({Name = "Main"})
			return tab:AddCard(co)
		end

		function page:Select()
			setCurrentPage(page)
		end

		if #pages == 1 then currentPage = page end
		setNavActive(page, page == currentPage)
		updateActivePage()
		return page
	end

	-- ================== PÁGINA SETTINGS PRONTA ==================
	function Window:AddSettingsPage(so)
		so = so or {}
		local page = Window:AddPage({
			Name = so.Name or "Settings",
			Icon = so.Icon,
			IconFallback = "⚙️",
			Columns = 1,
		})

		local ui = page:AddCard({Title = "INTERFACE", IconFallback = "🖥️"})
		ui:AddToggle({
			Title = "Notificações",
			Description = "Mostra avisos no canto da tela (erros sempre aparecem).",
			Flag = "Settings.Notifications",
			Default = true,
			Notify = true,
		})
		-- A escala só é aplicada ao soltar o slider (committed); aplicar durante o arraste
		-- moveria a barrinha debaixo do mouse e causaria tremedeira.
		ui:AddSlider({
			Title = "UI Scale",
			Description = "Tamanho da janela (limitado ao tamanho da tela).",
			Min = 60, Max = 120, Default = 100, Step = 5, Suffix = "%",
			Flag = "Settings.UIScale",
			Callback = function(_, committed)
				if committed then applyScale() end
			end,
		})
		ui:AddKeybind({
			Title = "Toggle UI",
			Description = "Tecla que mostra/esconde a janela inteira.",
			Flag = "Window.Toggle",
			Default = toggleDefault,
			Callback = function(key)
				Window:SetToggleKeybind(key)
			end,
		})

		local data = page:AddCard({Title = "DADOS", IconFallback = "💾"})
		data:AddButton({
			Title = "Resetar configuração",
			Description = "Apaga o arquivo salvo (vale no próximo carregamento).",
			ButtonText = "Resetar",
			Danger = true,
			Callback = function()
				Window:ResetConfig()
				showNotification("Configuração", "Arquivo apagado. Recarregue o script para usar os padrões.", "info")
			end,
		})
		data:AddButton({
			Title = "Descarregar UI",
			Description = "Fecha a interface e desconecta todos os atalhos.",
			ButtonText = "Descarregar",
			Danger = true,
			Callback = unload,
		})

		applyScale()
		return page
	end

