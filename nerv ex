	-- ---------- MULTI DROPDOWN ----------
	local function addMultiDropdown(body, entry, o)
		local rowTitle, description = o.Title or "Multi Select", o.Description or ""
		local flag = o.Flag
		local currentOptions = o.Options or {}
		local selected = {}

		-- Default: tabela, valor único ou nil
		if type(o.Default) == "table" then
			for _, v in ipairs(o.Default) do selected[v] = true end
		elseif o.Default ~= nil then
			selected[o.Default] = true
		end

		-- Restaurar salvo (array JSON)
		local savedValue = flag and savedFlags[flag]
		if type(savedValue) == "table" then
			selected = {}
			for _, v in ipairs(savedValue) do selected[v] = true end
		end

		local row = newFrame({Name = "MultiDropdownRow", Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1}, body)
		row.LayoutOrder = nextOrder(body)
		addRowHeader(row, rowTitle, description, 0.5)
		registerRow(entry, row, rowTitle .. " " .. description)

		local dropdownBtn = newButton({
			Name = "MultiDropdown",
			Size = UDim2.new(0.46, 0, 0, 36),
			Position = UDim2.new(0.54, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = COLORS.Field,
			Corner = 7,
		}, row)
		stroke(dropdownBtn, COLORS.PanelBorder, 1)
		addHover(dropdownBtn, COLORS.Field, COLORS.FieldHover)

		local valueLabel = newLabel({
			Size = UDim2.new(1, -38, 1, 0),
			Position = UDim2.new(0, 12, 0, 0),
			Text = "",
			TextSize = 14,
			Truncate = true,
		}, dropdownBtn)

		local _, setChevronOpen = createChevron(dropdownBtn)
		addDivider(row)

		local function getSelectedList()
			local list = {}
			for _, opt in ipairs(currentOptions) do
				if selected[opt] then table.insert(list, opt) end
			end
			return list
		end

		local function updateLabel()
			local list = getSelectedList()
			if #list == 0 then
				valueLabel.Text = "Nenhum"
				valueLabel.TextColor3 = COLORS.TextMuted
			elseif #list == 1 then
				valueLabel.Text = list[1]
				valueLabel.TextColor3 = COLORS.TextPrimary
			else
				valueLabel.Text = list[1] .. " +" .. (#list - 1)
				valueLabel.TextColor3 = COLORS.TextPrimary
			end
		end

		local function commit(silent)
			local list = getSelectedList()
			setFlag(flag, list)
			if not silent then fire(o.Callback, list) end
			updateLabel()
		end

		local listFrame
		local ROW_HEIGHT = 32
		local optionRows = {}

		local function closeList()
			if not listFrame then return end
			setChevronOpen(false)
			overlayCatcher.Visible = false

			local frameToClose = listFrame
			listFrame = nil
			optionRows = {}
			if closeOpenDropdown == closeList then
				closeOpenDropdown = nil
			end

			local closeTween = TweenService:Create(frameToClose,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{Size = UDim2.new(0, frameToClose.Size.X.Offset, 0, 0)})
			closeTween.Completed:Once(function()
				frameToClose:Destroy()
			end)
			closeTween:Play()
		end

		local function toggleOption(opt)
			selected[opt] = not selected[opt] or nil
			commit()
			-- atualiza visual do checkbox da linha
			local rowRefs = optionRows[opt]
			if rowRefs then
				local isOn = selected[opt] == true
				rowRefs.box.BackgroundColor3 = isOn and COLORS.Accent or COLORS.Field
				rowRefs.stroke.Color = isOn and COLORS.Accent or COLORS.PanelBorder
				rowRefs.check.Visible = isOn
				rowRefs.label.TextColor3 = isOn and COLORS.Accent or COLORS.TextPrimary
			end
		end

		local function openList()
			closeAnyOpenDropdown()
			setChevronOpen(true)
			overlayCatcher.Visible = true

			local scale = uiScale.Scale
			local targetHeight = math.min(#currentOptions, 8) * ROW_HEIGHT
			local btnPos, btnSize = dropdownBtn.AbsolutePosition, dropdownBtn.AbsoluteSize
			local ovPos = overlay.AbsolutePosition
			local screenBottom = screenGui.AbsolutePosition.Y + screenGui.AbsoluteSize.Y
			local openUp = (btnPos.Y + btnSize.Y + 4 + targetHeight * scale) > screenBottom

			local width = btnSize.X / scale
			local x = (btnPos.X - ovPos.X) / scale

			listFrame = newFrame({
				Name = "MultiDropdownList",
				BackgroundColor3 = COLORS.Field,
				Corner = 7,
				ClipsDescendants = true,
			}, overlay)
			listFrame.ZIndex = 201
			stroke(listFrame, COLORS.PanelBorder, 1)

			local listScroll = Instance.new("ScrollingFrame")
			listScroll.Name = "OptionsScroll"
			listScroll.BackgroundTransparency = 1
			listScroll.BorderSizePixel = 0
			listScroll.Size = UDim2.new(1, 0, 1, 0)
			listScroll.ScrollBarThickness = 3
			listScroll.ScrollBarImageColor3 = COLORS.Scroll
			listScroll.ScrollingDirection = Enum.ScrollingDirection.Y
			listScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
			listScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
			listScroll.ZIndex = 202
			listScroll.Parent = listFrame

			local listLayout = Instance.new("UIListLayout")
			listLayout.SortOrder = Enum.SortOrder.LayoutOrder
			listLayout.Parent = listScroll

			for i, opt in ipairs(currentOptions) do
				local isOn = selected[opt] == true
				local optionBtn = newButton({
					Name = "Option" .. i,
					Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
					BackgroundColor3 = COLORS.Field,
					Text = "",
				}, listScroll)
				optionBtn.LayoutOrder = i
				optionBtn.ZIndex = 202
				addHover(optionBtn, COLORS.Field, COLORS.FieldHover)

				local checkbox = newFrame({
					Name = "Checkbox",
					Size = UDim2.new(0, 16, 0, 16),
					Position = UDim2.new(0, 12, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					BackgroundColor3 = isOn and COLORS.Accent or COLORS.Field,
					Corner = 4,
				}, optionBtn)
				checkbox.ZIndex = 203
				local cbStroke = stroke(checkbox, isOn and COLORS.Accent or COLORS.PanelBorder, 1)
				cbStroke.ZIndex = 203

				local check = newLabel({
					Name = "Check",
					Size = UDim2.new(1, 0, 1, 0),
					Text = "✓",
					TextSize = 12,
					TextColor3 = COLORS.AccentDark,
					TextXAlignment = Enum.TextXAlignment.Center,
				}, checkbox)
				check.ZIndex = 204
				check.Visible = isOn

				local optLabel = newLabel({
					Size = UDim2.new(1, -44, 1, 0),
					Position = UDim2.new(0, 36, 0, 0),
					Text = opt,
					TextSize = 14,
					TextColor3 = isOn and COLORS.Accent or COLORS.TextPrimary,
					Truncate = true,
				}, optionBtn)
				optLabel.ZIndex = 203

				optionRows[opt] = {box = checkbox, stroke = cbStroke, check = check, label = optLabel}

				optionBtn.MouseButton1Click:Connect(function()
					toggleOption(opt)
				end)
			end

			if openUp then
				listFrame.AnchorPoint = Vector2.new(0, 1)
				listFrame.Position = UDim2.new(0, x, 0, (btnPos.Y - ovPos.Y) / scale - 4)
			else
				listFrame.Position = UDim2.new(0, x, 0, (btnPos.Y - ovPos.Y + btnSize.Y) / scale + 4)
			end
			listFrame.Size = UDim2.new(0, width, 0, 0)

			TweenService:Create(listFrame,
				TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Size = UDim2.new(0, width, 0, targetHeight)}):Play()

			closeOpenDropdown = closeList
		end

		dropdownBtn.MouseButton1Click:Connect(function()
			if listFrame then closeList() else openList() end
		end)

		updateLabel()
		initFlag(flag, getSelectedList())

		local api = {Row = row}
		function api:Get() return getSelectedList() end
		function api:Set(values, silent)
			selected = {}
			if type(values) == "table" then
				for _, v in ipairs(values) do selected[v] = true end
			elseif values ~= nil then
				selected[values] = true
			end
			commit(silent)
		end
		function api:Toggle(value, state, silent)
			if state == nil then
				selected[value] = not selected[value] or nil
			else
				selected[value] = state and true or nil
			end
			commit(silent)
		end
		function api:SetOptions(newOptions, silent)
			if listFrame then closeList() end
			currentOptions = newOptions or {}
			-- remove seleções que não existem mais
			for v in pairs(selected) do
				if not table.find(currentOptions, v) then selected[v] = nil end
			end
			commit(silent)
		end

		if o.CallOnLoad then fire(o.Callback, getSelectedList()) end
		return api
	end

	-- ---------- KEYBIND ----------
	-- Registro ÚNICO de atalhos: os elementos AddKeybind e os atalhos criados por código
	-- (Window:RegisterKeybind) vivem na mesma tabela, então aparecem juntos na lista Ctrl+B
	-- e compartilham a checagem de conflito.
	-- id -> {key, onPressed, onChanged, enabled, name, flag, refresh, custom}
	local keybinds = {}
	local keybindCounter = 0
	local isAnyKeybindListening = false
	local keybindCooldownUntil = 0
	local refreshKeybindViewer -- definido junto do visualizador (mais abaixo)
	local toggleKeybindViewer  -- idem; só existe se KeybindViewer ~= false

	-- Aceita KeyCode ou nome ("F", "RightShift"); devolve nil se for inválido.
	local function toKeyCode(key)
		if typeof(key) == "EnumItem" then return key end
		if type(key) == "string" then return keyCodeFromName(key, nil) end
		return nil
	end

	-- Procura por id/flag (elementos) ou pelo nome usado em RegisterKeybind.
	local function findKeybind(nameOrId)
		if keybinds[nameOrId] then return keybinds[nameOrId], nameOrId end
		local customId = "Custom." .. tostring(nameOrId)
		if keybinds[customId] then return keybinds[customId], customId end
		return nil, nil
	end

	local function keyDisplayName(keyCode)
		return keyCode == Enum.KeyCode.Unknown and "None" or keyCode.Name
	end

	-- Troca a tecla de um atalho: atualiza o botão, a flag (salva no arquivo), a lista Ctrl+B
	-- e dispara OnChanged (a não ser que silent).
	local function applyKeybindKey(id, keyCode, silent)
		local kb = keybinds[id]
		if not kb or typeof(keyCode) ~= "EnumItem" then return false end
		kb.key = keyCode
		if kb.flag then setFlag(kb.flag, keyCode.Name) end
		if kb.refresh then kb.refresh() end
		if refreshKeybindViewer then refreshKeybindViewer() end
		if not silent then fire(kb.onChanged, keyCode) end
		return true
	end

	-- Um único handler global despacha todos os atalhos (e o Esc fecha dropdowns).
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

		-- Ctrl+B abre/fecha a lista de atalhos
		if input.KeyCode == Enum.KeyCode.B and not gameProcessed
			and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			if toggleKeybindViewer then
				toggleKeybindViewer()
				return
			end
		end

		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.Escape and closeOpenDropdown then
			closeAnyOpenDropdown()
			return
		end
		if isAnyKeybindListening or os.clock() < keybindCooldownUntil then return end
		-- não dispara atalhos enquanto o usuário digita num TextBox
		if UserInputService:GetFocusedTextBox() then return end

		for _, kb in pairs(keybinds) do
			if kb.enabled ~= false and kb.key == input.KeyCode and kb.onPressed then
				fire(kb.onPressed)
			end
		end
	end))

	local function addKeybind(body, entry, o)
		local rowTitle, description = o.Title or "Keybind", o.Description or ""
		keybindCounter = keybindCounter + 1
		local id = o.Flag or ("Keybind" .. keybindCounter)

		local row = newFrame({Name = "KeybindRow", Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1}, body)
		row.LayoutOrder = nextOrder(body)
		addRowHeader(row, rowTitle, description, 0.55)
		registerRow(entry, row, rowTitle .. " " .. description)

		-- tecla inicial: salva no arquivo > Default > None
		local startKey = keyCodeFromName(o.Flag and savedFlags[o.Flag], toKeyCode(o.Default) or Enum.KeyCode.Unknown)
		local kb = {
			key = startKey,
			onPressed = o.Callback,   -- roda quando a TECLA É APERTADA
			onChanged = o.OnChanged,  -- roda quando o usuário TROCA a tecla
			enabled = true,
			name = rowTitle,
			flag = o.Flag,
		}
		keybinds[id] = kb
		initFlag(o.Flag, startKey.Name)

		local keyBtn = newButton({
			Name = "KeybindButton",
			Size = UDim2.new(0, 110, 0, 34),
			Position = UDim2.new(1, -110, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = COLORS.Field,
			Text = keyDisplayName(startKey),
			TextSize = 14,
			Corner = 7,
		}, row)
		stroke(keyBtn, COLORS.PanelBorder, 1)
		addHover(keyBtn, COLORS.Field, COLORS.FieldHover)

		local isListening = false
		local listenConnection
		local listenToken

		-- chamado por applyKeybindKey (inclusive via SetKeybindKey / api:Set)
		kb.refresh = function()
			if not isListening then
				keyBtn.Text = keyDisplayName(kb.key)
			end
		end

		local function stopListening(newKeyCode)
			isListening = false
			isAnyKeybindListening = false
			keybindCooldownUntil = os.clock() + 0.25 -- evita disparar a ação com a própria tecla recém-atribuída
			untrack(listenConnection)
			listenConnection = nil
			if newKeyCode then
				applyKeybindKey(id, newKeyCode)
			end
			keyBtn.Text = keyDisplayName(kb.key)
		end

		local function startListening()
			if isAnyKeybindListening then return end
			isListening = true
			isAnyKeybindListening = true
			keyBtn.Text = "..."

			local token = {}
			listenToken = token

			listenConnection = track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				if input.KeyCode == Enum.KeyCode.Escape then
					stopListening(nil)
					return
				end
				if gameProcessed then return end

				-- conflito com qualquer outro atalho (da UI ou registrado por código)
				for otherId, other in pairs(keybinds) do
					if otherId ~= id and other.key == input.KeyCode then
						showNotification("Atalho em uso",
							input.KeyCode.Name .. " já está atribuída a \"" .. tostring(other.name or otherId) .. "\".", "error")
						stopListening(nil)
						return
					end
				end
				stopListening(input.KeyCode)
			end))

			-- Cancela sozinho se o usuário desistir.
			task.delay(8, function()
				if listenToken == token and isListening then
					stopListening(nil)
				end
			end)
		end

		keyBtn.MouseButton1Click:Connect(function()
			if isListening then stopListening(nil) else startListening() end
		end)

		addDivider(row)

		local api = {Row = row}
		function api:Get() return kb.key end
		-- Set aceita KeyCode ou nome ("F"). silent = true não dispara OnChanged.
		function api:Set(key, silent) return applyKeybindKey(id, toKeyCode(key), silent) end
		function api:SetEnabled(enabled)
			kb.enabled = enabled and true or false
			if refreshKeybindViewer then refreshKeybindViewer() end
		end
		function api:IsEnabled() return kb.enabled ~= false end
		return api
	end

	-- ---------- TOGGLE ----------
	local function setToggleVisual(toggleBg, knob, isOn)
		local info = TweenInfo.new(0.15)
		TweenService:Create(knob, info, {
			Position = isOn and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = isOn and COLORS.AccentDark or COLORS.Knob, -- track branco => knob escuro
		}):Play()
		TweenService:Create(toggleBg, info, {BackgroundColor3 = isOn and COLORS.ToggleOn or COLORS.ToggleOff}):Play()
	end

	local function addToggle(body, entry, o)
		local rowTitle, description = o.Title or "Toggle", o.Description or ""
		local flag = o.Flag

		local row = newFrame({Name = "ToggleRow", Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1}, body)
		row.LayoutOrder = nextOrder(body)
		addRowHeader(row, rowTitle, description, 0.75)
		registerRow(entry, row, rowTitle .. " " .. description)

		local isOn = saved(flag, o.Default and true or false)
		initFlag(flag, isOn)

		local toggleBg = newFrame({
			Name = "ToggleBg",
			Size = UDim2.new(0, 48, 0, 26),
			Position = UDim2.new(1, -48, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = isOn and COLORS.ToggleOn or COLORS.ToggleOff,
			Corner = 13,
		}, row)
		stroke(toggleBg, COLORS.PanelBorder, 1)

		local knob = newFrame({
			Name = "Knob",
			Size = UDim2.new(0, 20, 0, 20),
			Position = isOn and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = isOn and COLORS.AccentDark or COLORS.Knob,
			Corner = 10,
		}, toggleBg)

		local clickCatcher = Instance.new("TextButton")
		clickCatcher.Name = "ToggleClickCatcher"
		clickCatcher.BackgroundTransparency = 1
		clickCatcher.Size = UDim2.new(1, 0, 1, 0)
		clickCatcher.Text = ""
		clickCatcher.Parent = toggleBg

		-- silent = não mostra notificação (e não chama o Callback).
		local function setState(value, silent)
			value = value and true or false
			if value == isOn then return true end
			isOn = value
			setToggleVisual(toggleBg, knob, isOn)
			setFlag(flag, isOn)
			if not silent then
				if o.Notify then
					showNotification(rowTitle, isOn and "Ativado" or "Desativado", isOn and "success" or "info")
				end
				fire(o.Callback, isOn)
			end
			return true
		end

		clickCatcher.MouseButton1Click:Connect(function()
			setState(not isOn)
		end)

		addDivider(row)

		local api = {Row = row}
		function api:Get() return isOn end
		function api:Set(value, silent) return setState(value, silent) end

		if o.CallOnLoad then fire(o.Callback, isOn) end
		return api
	end

