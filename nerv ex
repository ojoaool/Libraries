-- Função nomeada: cria uma linha de dropdown FUNCIONAL, com mini animação de abrir/fechar
-- (altura da lista anima de 0 até o tamanho real, e o chevron gira).
local function addDropdownRow(card, title, description, options, defaultIndex, onSelected)
	local row = newFrame({
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		LayoutOrder = nextRowOrder(),
	}, card)

	newLabel({
		Size = UDim2.new(0.5, 0, 0, 15),
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	}, row)

	newLabel({
		Size = UDim2.new(0.5, 0, 0, 13),
		Position = UDim2.new(0, 0, 0, 17),
		Text = description,
		TextColor3 = COLORS.TextMuted,
		TextSize = 10,
	}, row)

	local dropdownBtn = newButton({
		Name = "Dropdown",
		Size = UDim2.new(0.46, 0, 0, 28),
		Position = UDim2.new(0.54, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = COLORS.Field,
		Text = "",
		Corner = 6,
	}, row)
	stroke(dropdownBtn, COLORS.PanelBorder, 1)

	local valueLabel = newLabel({
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		Text = options[defaultIndex] or options[1] or "",
		TextSize = 11,
	}, dropdownBtn)
	-- Corta com "..." em vez de vazar/sobrepor a borda quando o nome é grande demais
	-- (ex.: "2 - Regular Challenge #2 / 3" não cabendo na caixa fechada do dropdown).
	valueLabel.TextTruncate = Enum.TextTruncate.AtEnd

	local chevron, setChevronOpen = createChevron(dropdownBtn)

	addRowDivider(row)

	local selectedIndex = defaultIndex or 1
	local listFrame -- criado dinamicamente ao abrir
	local ROW_HEIGHT = 26

	local function applySelection(index)
		selectedIndex = index
		valueLabel.Text = options[index]
	end

	-- Função nomeada: fecha a lista aberta deste dropdown, com mini animação de encolher
	local function closeList()
		if not listFrame then return end
		setChevronOpen(false)
		if overlayBackgroundCatcher then
			overlayBackgroundCatcher.Visible = false
		end

		local frameToClose = listFrame
		listFrame = nil

		local closeTween = TweenService:Create(
			frameToClose,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{Size = UDim2.new(0, frameToClose.AbsoluteSize.X, 0, 0)}
		)
		local function onCloseTweenFinished()
			frameToClose:Destroy()
		end
		closeTween.Completed:Once(onCloseTweenFinished)
		closeTween:Play()
	end

	-- Função nomeada: abre a lista de opções com mini animação (altura 0 -> altura real)
	local function openList()
		if closeOpenDropdown then
			closeOpenDropdown()
		end

		setChevronOpen(true)
		if overlayBackgroundCatcher then
			overlayBackgroundCatcher.Visible = true
		end

		local targetHeight = #options * ROW_HEIGHT

		listFrame = newFrame({
			Name = "DropdownList",
			BackgroundColor3 = COLORS.Field,
			Corner = 6,
			ClipsDescendants = true,
		}, overlay)
		listFrame.ZIndex = 201
		stroke(listFrame, COLORS.PanelBorder, 1)

		local listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Parent = listFrame

		local buttonPos = dropdownBtn.AbsolutePosition
		local overlayPos = overlay.AbsolutePosition
		listFrame.Position = UDim2.new(
			0, buttonPos.X - overlayPos.X,
			0, buttonPos.Y - overlayPos.Y + dropdownBtn.AbsoluteSize.Y + 4
		)
		-- Começa com altura 0 (fechado) e anima até a altura real da lista
		listFrame.Size = UDim2.new(0, dropdownBtn.AbsoluteSize.X, 0, 0)

		for i, optionText in ipairs(options) do
			local optionBtn = newButton({
				Name = "Option" .. i,
				Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
				BackgroundColor3 = (i == selectedIndex) and COLORS.SelectedBg or COLORS.Field,
				Text = optionText,
				TextSize = 11,
				TextColor3 = (i == selectedIndex) and COLORS.Accent or COLORS.TextPrimary,
			}, listFrame)
			optionBtn.LayoutOrder = i
			optionBtn.ZIndex = 202
			-- Bug reportado: as opções da lista vinham centralizadas (herdando o
			-- padrão do TextButton), enquanto o valor fechado do dropdown é
			-- alinhado à esquerda — deixa os dois consistentes, sempre esquerda->direita.
			optionBtn.TextXAlignment = Enum.TextXAlignment.Left
			-- Mesma proteção do valueLabel: opção com nome grande corta com "..."
			-- em vez de vazar pra fora do fundo da lista.
			optionBtn.TextTruncate = Enum.TextTruncate.AtEnd
			local optionPadding = Instance.new("UIPadding")
			optionPadding.PaddingLeft = UDim.new(0, 10)
			optionPadding.PaddingRight = UDim.new(0, 10)
			optionPadding.Parent = optionBtn

			local function onOptionClicked()
				applySelection(i)
				closeList()
				if onSelected then
					onSelected(options[i], i)
				end
			end
			optionBtn.MouseButton1Click:Connect(onOptionClicked)
		end

		local openTween = TweenService:Create(
			listFrame,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Size = UDim2.new(0, dropdownBtn.AbsoluteSize.X, 0, targetHeight)}
		)
		openTween:Play()

		closeOpenDropdown = closeList
	end

	local function onDropdownClicked()
		if listFrame then
			closeList()
			closeOpenDropdown = nil
		else
			openList()
		end
	end
	dropdownBtn.MouseButton1Click:Connect(onDropdownClicked)

	local function getSelected()
		return options[selectedIndex], selectedIndex
	end

	-- Aplica a seleção inicial no HubState (via callback), se houver
	if onSelected then
		onSelected(options[defaultIndex] or options[1], defaultIndex or 1)
	end

	return row, getSelected
end

-- ================== COMPONENTES: SLIDER ==================
local function addSliderRow(card, title, description, min, max, default, suffix, onChanged)
	suffix = suffix or ""
	local row = newFrame({
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundTransparency = 1,
		LayoutOrder = nextRowOrder(),
	}, card)

	newLabel({
		Size = UDim2.new(0.6, 0, 0, 15),
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	}, row)

	newLabel({
		Size = UDim2.new(0.6, 0, 0, 13),
		Position = UDim2.new(0, 0, 0, 17),
		Text = description,
		TextColor3 = COLORS.TextMuted,
		TextSize = 10,
	}, row)

	local valueLabel = newLabel({
		Size = UDim2.new(0.4, -4, 0, 15),
		Position = UDim2.new(0.6, 4, 0, 0),
		Text = tostring(default) .. suffix,
		TextSize = 11,
		TextColor3 = COLORS.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)

	local track = newFrame({
		Name = "SliderTrack",
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 40),
		BackgroundColor3 = COLORS.ToggleOff,
		Corner = 3,
	}, row)

	local fill = newFrame({
		Name = "SliderFill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = COLORS.Accent,
		Corner = 3,
	}, track)

	local knob = newFrame({
		Name = "SliderKnob",
		Size = UDim2.new(0, 14, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = COLORS.Knob,
		Corner = 7,
	}, track)

	local dragCatcher = Instance.new("TextButton")
	dragCatcher.Name = "SliderDragCatcher"
	dragCatcher.BackgroundTransparency = 1
	dragCatcher.Size = UDim2.new(1, 0, 0, 20)
	dragCatcher.Position = UDim2.new(0, 0, 0.5, -10)
	dragCatcher.Text = ""
	dragCatcher.Parent = track

	local currentValue = default
	local fillTween, knobTween -- tweens ativos, cancelados a cada nova mudança pra não acumular

	-- Função nomeada: aplica o valor com uma mini animação suave (fill + knob deslizam
	-- até a nova posição em vez de saltar instantaneamente a cada passo do arraste).
	local function applyValue(value)
		value = math.clamp(value, min, max)
		currentValue = math.floor(value + 0.5)
		local ratio = (currentValue - min) / (max - min)

		if fillTween then fillTween:Cancel() end
		if knobTween then knobTween:Cancel() end

		local tweenInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		fillTween = TweenService:Create(fill, tweenInfo, {Size = UDim2.new(ratio, 0, 1, 0)})
		knobTween = TweenService:Create(knob, tweenInfo, {Position = UDim2.new(ratio, 0, 0.5, 0)})
		fillTween:Play()
		knobTween:Play()

		valueLabel.Text = tostring(currentValue) .. suffix
	end

	local function valueFromMouseX(mouseX)
		local trackPos = track.AbsolutePosition.X
		local trackWidth = track.AbsoluteSize.X
		local ratio = math.clamp((mouseX - trackPos) / trackWidth, 0, 1)
		return min + (max - min) * ratio
	end

	local isDragging = false
	local dragMoveConnection

	local function onDragEnded()
		isDragging = false
		if dragMoveConnection then
			dragMoveConnection:Disconnect()
			dragMoveConnection = nil
		end
	end

	local function onDragMoved(input)
		if not isDragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			applyValue(valueFromMouseX(input.Position.X))
			if onChanged then
				onChanged(currentValue)
			end
		end
	end

	local function onDragStarted(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			applyValue(valueFromMouseX(input.Position.X))
			if onChanged then
				onChanged(currentValue)
			end
			dragMoveConnection = UserInputService.InputChanged:Connect(onDragMoved)
		end
	end

	dragCatcher.InputBegan:Connect(onDragStarted)

	local function onDragInputEnded(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			onDragEnded()
		end
	end
	dragCatcher.InputEnded:Connect(onDragInputEnded)

	applyValue(default)
	if onChanged then
		onChanged(currentValue)
	end

	addRowDivider(row)

	local function getValue()
		return currentValue
	end

	return row, getValue
end

