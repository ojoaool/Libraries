	-- Busca: filtra linhas por título/descrição; cards sem nenhum resultado somem
	-- (se o título do card casar, o card inteiro continua visível). Só vale pra aba atual.
	applySearch = function()
		local query = string.lower(trim(searchInput.Text))
		local tab = currentPage and currentPage.CurrentTab
		noResultsLabel.Visible = false
		if not tab then return end

		local anyCardVisible = false
		for _, entry in ipairs(tab.Cards) do
			local cardMatches = query == "" or string.find(entry.title, query, 1, true) ~= nil
			local anyRowVisible = false
			for _, r in ipairs(entry.rows) do
				local show = cardMatches or string.find(r.text, query, 1, true) ~= nil
				r.frame.Visible = show
				anyRowVisible = anyRowVisible or show
			end
			local showCard = cardMatches or anyRowVisible
			entry.card.Visible = showCard
			anyCardVisible = anyCardVisible or showCard
		end
		noResultsLabel.Visible = query ~= "" and #tab.Cards > 0 and not anyCardVisible
	end
	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		applySearch()
	end)

	updateActivePage = function()
		for _, page in ipairs(pages) do
			local isCurrent = (page == currentPage)
			page.TabBarFrame.Visible = isCurrent and #page.Tabs > 1
			for _, tab in ipairs(page.Tabs) do
				tab.Scroll.Visible = isCurrent and tab == page.CurrentTab and #tab.Cards > 0
			end
		end

		local tab = currentPage and currentPage.CurrentTab
		placeholderPage.Visible = currentPage ~= nil and (tab == nil or #tab.Cards == 0)
		placeholderTitle.Text = tab and tab.Name or (currentPage and currentPage.Name or "")

		pageTitleLabel.Text = currentPage and currentPage.Name or title
		local index = currentPage and table.find(pages, currentPage) or 1
		pageCounterLabel.Text = string.format("%02d / %02d", index, math.max(#pages, 1))

		applySearch()
	end

