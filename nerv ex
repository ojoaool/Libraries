			local messageLabel = newLabel({
				Size = UDim2.new(1, 0, 0, 0),
				Text = tostring(message),
				TextColor3 = COLORS.TextMuted,
				TextSize = 11,
				TextWrapped = true,
			}, textHolder)
			messageLabel.AutomaticSize = Enum.AutomaticSize.Y
