		local function dismiss()
			if dismissed then return end
			dismissed = true
			local idx = table.find(activeToasts, dismiss)
			if idx then table.remove(activeToasts, idx) end

			local fadeOut = TweenService:Create(notifCanvas,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
			fadeOut.Completed:Once(function()
				notifCanvas:Destroy()
			end)
			fadeOut:Play()
		end

		activeToasts[#activeToasts + 1] = dismiss
		-- Limita a pilha: toasts antigos somem quando passa do máximo.
		if #activeToasts > MAX_TOASTS then
			activeToasts[1]()
		end
		task.delay(3, dismiss)
