	function Window:ResetConfig()
		saveDisabled = true
		configDirty = false
		pcall(function()
			if delfile and isfile and isfile(configFile) then
				delfile(configFile)
			elseif writefile then
				writefile(configFile, "{}")
			end
		end)
	end

	-- ================== ATALHOS: API (mesmos nomes do Expensive Hub) ==================
	-- Registra um atalho global. key = KeyCode ou nome ("F"). Aparece na lista Ctrl+B.
	function Window:RegisterKeybind(name, key, callback)
		local keyCode = toKeyCode(key)
		if not keyCode then
			warn("[NervLib] RegisterKeybind: tecla inválida para '" .. tostring(name) .. "'")
			return false
		end
		customKeybinds[name] = {Key = keyCode, Callback = callback, Enabled = true}
		if refreshKeybindViewer then refreshKeybindViewer() end
		return true
	end

	function Window:UnregisterKeybind(name)
		customKeybinds[name] = nil
		if refreshKeybindViewer then refreshKeybindViewer() end
	end

	function Window:SetKeybindEnabled(name, enabled)
		if customKeybinds[name] then
			customKeybinds[name].Enabled = enabled and true or false
			if refreshKeybindViewer then refreshKeybindViewer() end
		end
	end

	function Window:SetKeybindKey(name, key)
		local keyCode = toKeyCode(key)
		if customKeybinds[name] and keyCode then
			customKeybinds[name].Key = keyCode
			if refreshKeybindViewer then refreshKeybindViewer() end
		end
	end

	-- nome -> {Key, Callback, Enabled}
	function Window:GetKeybinds()
		return customKeybinds
	end

	-- Troca a tecla de mostrar/esconder a janela (atualiza o botão na página Settings e salva).
	function Window:SetToggleKeybind(key)
		local keyCode = toKeyCode(key)
		if not keyCode then return false end
		toggleKeyCode = keyCode
		setFlag("Window.Toggle", keyCode.Name)
		local element = keybindElements["Window.Toggle"]
		if element then element:Set(keyCode, true) end
		if refreshKeybindViewer then refreshKeybindViewer() end
		return true
	end

	-- ================== KEYBIND LIST (cópia do Expensive Hub) — FIXA NO CANTO SUPERIOR DIREITO ==================
	-- Mesmos tamanhos (x SC), cores, fontes, linhas, botão X e animações do "Keybind List" do Expensive.
	-- A única diferença é a posição: ancorada no topo à direita e arrastável, aberta ao iniciar.
	-- Fica na ScreenGui (aparece mesmo com a janela escondida). Ctrl+B esconde/mostra.
	-- CreateWindow({KeybindViewer = false}) começa escondido e desliga o Ctrl+B.
	local keybindViewerVisible = false
	local KB_W = math.floor(320 * SC)
	local KB_MAX_H = math.floor(400 * SC)
	local KB_ROW_H = math.floor(32 * SC)
	local kbTargetH = KB_MAX_H

	local kbViewer = Instance.new("CanvasGroup")
	kbViewer.Name = "KeybindList"
	kbViewer.Active = true
	kbViewer.Draggable = true
	kbViewer.AnchorPoint = Vector2.new(1, 0)
	kbViewer.BackgroundColor3 = COLORS.KeybindViewerBG
	kbViewer.BackgroundTransparency = 0.05
	kbViewer.Position = UDim2.new(1, -10, 0, 54)
	kbViewer.Size = UDim2.new(0, KB_W, 0, 0)
	kbViewer.ZIndex = 90
	kbViewer.Visible = false
	kbViewer.Parent = screenGui
	corner(kbViewer, 18)
	do
		local viewerStroke = Instance.new("UIStroke")
		viewerStroke.Color = COLORS.KeybindBorder
		viewerStroke.Thickness = 1
		viewerStroke.Transparency = 0.3
		viewerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		viewerStroke.Parent = kbViewer
	end
	addClayShadow(kbViewer)

	local kbvHeader = Instance.new("TextLabel")
	kbvHeader.Active = false
	kbvHeader.BackgroundTransparency = 1
	kbvHeader.Size = UDim2.new(1, 0, 0, math.floor(42 * SC))
	kbvHeader.Font = Enum.Font.GothamBold
	kbvHeader.TextSize = math.floor(15 * SC)
	kbvHeader.Text = "Keybind List"
	kbvHeader.TextColor3 = COLORS.KeybindBtnText
	kbvHeader.ZIndex = 91
	kbvHeader.Parent = kbViewer

	local kbvSep = Instance.new("Frame")
	kbvSep.Active = false
	kbvSep.BackgroundColor3 = COLORS.KeybindBorder
	kbvSep.BackgroundTransparency = 0.5
	kbvSep.BorderSizePixel = 0
	kbvSep.Size = UDim2.new(1, -24, 0, 1)
	kbvSep.Position = UDim2.new(0, 12, 0, math.floor(42 * SC))
	kbvSep.ZIndex = 91
	kbvSep.Parent = kbViewer

	local kbvScroll = Instance.new("ScrollingFrame")
	kbvScroll.BackgroundTransparency = 1
	kbvScroll.BorderSizePixel = 0
	kbvScroll.Position = UDim2.new(0, 0, 0, math.floor(48 * SC))
	kbvScroll.Size = UDim2.new(1, 0, 1, -math.floor(48 * SC))
	kbvScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	kbvScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	kbvScroll.ScrollingDirection = Enum.ScrollingDirection.Y
	kbvScroll.ScrollBarThickness = 3
	kbvScroll.ScrollBarImageColor3 = COLORS.KeybindBtnText
	kbvScroll.ScrollBarImageTransparency = 0.5
	kbvScroll.ZIndex = 91
	kbvScroll.Parent = kbViewer

	local kbvPad = Instance.new("UIPadding")
	kbvPad.PaddingTop = UDim.new(0, 8)
	kbvPad.PaddingBottom = UDim.new(0, 8)
	kbvPad.PaddingLeft = UDim.new(0, 14)
	kbvPad.PaddingRight = UDim.new(0, 14)
	kbvPad.Parent = kbvScroll

	local kbvLayout = Instance.new("UIListLayout")
	kbvLayout.Padding = UDim.new(0, 4)
	kbvLayout.FillDirection = Enum.FillDirection.Vertical
	kbvLayout.SortOrder = Enum.SortOrder.LayoutOrder
	kbvLayout.Parent = kbvScroll

	local kbvClose = Instance.new("TextButton")
	kbvClose.AnchorPoint = Vector2.new(1, 0)
	kbvClose.BackgroundTransparency = 1
	kbvClose.Position = UDim2.new(1, -10, 0, 8)
	kbvClose.Size = UDim2.new(0, math.floor(28 * SC), 0, math.floor(28 * SC))
	kbvClose.Text = "X"
	kbvClose.Font = Enum.Font.GothamBold
	kbvClose.TextSize = math.floor(16 * SC)
	kbvClose.TextColor3 = COLORS.KeybindViewerSub
	kbvClose.AutoButtonColor = false
	kbvClose.ZIndex = 92
	kbvClose.Parent = kbViewer
	kbvClose.MouseButton1Click:Connect(function()
		keybindViewerVisible = false
		playSound(0.06, 1.2)
		tw(kbViewer, 0.25, {Size = UDim2.new(0, KB_W, 0, 0), GroupTransparency = 1},
			Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.3, function()
			kbViewer.Visible = false
			kbViewer.GroupTransparency = 0
		end)
	end)

	refreshKeybindViewer = function()
		for _, child in ipairs(kbvScroll:GetChildren()) do
			if child:IsA("Frame") then child:Destroy() end
		end

		-- A tecla da janela vem primeiro; depois os atalhos do RegisterKeybind em ordem alfabética.
		local entries = {{Name = "Toggle UI", Key = toggleKeyCode.Name, Enabled = true}}
		local names = {}
		for name in pairs(customKeybinds) do names[#names + 1] = name end
		table.sort(names)
		for _, name in ipairs(names) do
			local kb = customKeybinds[name]
			entries[#entries + 1] = {Name = tostring(name), Key = kb.Key.Name, Enabled = kb.Enabled}
		end

		-- o painel acompanha o tamanho da lista (até o máximo de 400*SC do Expensive)
		kbTargetH = math.min(math.floor(48 * SC) + #entries * (KB_ROW_H + 4) + 20, KB_MAX_H)
		if keybindViewerVisible and kbViewer.Visible then
			kbViewer.Size = UDim2.new(0, KB_W, 0, kbTargetH)
		end

		for i, entry in ipairs(entries) do
			local row = Instance.new("Frame")
			row.Active = false
			row.BackgroundColor3 = COLORS.KeybindViewerRow
			row.BackgroundTransparency = 0.4
			row.BorderSizePixel = 0
			row.Size = UDim2.new(1, 0, 0, KB_ROW_H)
			row.LayoutOrder = i
			row.ZIndex = 92
			row.Parent = kbvScroll
			corner(row, 8)

			local keyBadge = Instance.new("Frame")
			keyBadge.Active = false
			keyBadge.AnchorPoint = Vector2.new(1, 0.5)
			keyBadge.BackgroundColor3 = COLORS.KeybindBtn
			keyBadge.BorderSizePixel = 0
			keyBadge.Position = UDim2.new(1, -8, 0.5, 0)
			keyBadge.Size = UDim2.new(0, math.floor(60 * SC), 0, math.floor(22 * SC))
			keyBadge.ZIndex = 93
			keyBadge.Parent = row
			corner(keyBadge, 6)
			local badgeStroke = Instance.new("UIStroke")
			badgeStroke.Color = COLORS.KeybindBorder
			badgeStroke.Thickness = 1
			badgeStroke.Transparency = 0.5
			badgeStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			badgeStroke.Parent = keyBadge

			local keyText = Instance.new("TextLabel")
			keyText.Active = false
			keyText.BackgroundTransparency = 1
			keyText.Size = UDim2.new(1, 0, 1, 0)
			keyText.Font = Enum.Font.Code
			keyText.TextSize = math.floor(10 * SC)
			keyText.Text = entry.Key
			keyText.TextColor3 = COLORS.KeybindBtnText
			keyText.ZIndex = 94
			keyText.Parent = keyBadge

			local nameL = Instance.new("TextLabel")
			nameL.Active = false
			nameL.BackgroundTransparency = 1
			nameL.Position = UDim2.new(0, 10, 0, 0)
			nameL.Size = UDim2.new(0.6, 0, 1, 0)
			nameL.Font = Enum.Font.GothamMedium
			nameL.TextSize = math.floor(11 * SC)
			nameL.Text = entry.Name .. (entry.Enabled and "" or " (off)")
			nameL.TextColor3 = COLORS.KeybindViewerText
			nameL.TextTransparency = entry.Enabled and 0.1 or 0.55
			nameL.TextXAlignment = Enum.TextXAlignment.Left
			nameL.TextTruncate = Enum.TextTruncate.AtEnd
			nameL.ZIndex = 93
			nameL.Parent = row
		end
	end

	function Window:IsKeybindViewerVisible()
		return keybindViewerVisible
	end

	function Window:ShowKeybindViewer()
		keybindViewerVisible = true
		refreshKeybindViewer()
		kbViewer.Visible = true
		kbViewer.GroupTransparency = 0
		kbViewer.Size = UDim2.new(0, KB_W, 0, 0)
		playSound(0.08, 1.0)
		tw(kbViewer, 0.35, {Size = UDim2.new(0, KB_W, 0, kbTargetH)}, Enum.EasingStyle.Back)
	end

	function Window:HideKeybindViewer()
		keybindViewerVisible = false
		playSound(0.06, 1.2)
		tw(kbViewer, 0.25, {Size = UDim2.new(0, KB_W, 0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.3, function()
			kbViewer.Visible = false
		end)
	end

	-- Aberta ao iniciar (a não ser com KeybindViewer = false).
	refreshKeybindViewer()
	if opts.KeybindViewer ~= false then
		task.defer(function()
			if not unloaded then Window:ShowKeybindViewer() end
		end)
	end

	-- ================== INICIALIZAÇÃO ==================
	applyScale()
	updateActivePage()
	env.__NervLibWindows[windowId] = Window

	return Window
end

return Library
