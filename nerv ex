	-- Registra um atalho global por código (sem linha na UI). Aparece na lista Ctrl+B.
	-- flag (opcional): salva/restaura a tecla no arquivo de config.
	function Window:RegisterKeybind(name, key, callback, flag)
		local keyCode = toKeyCode(key)
		if not keyCode then
			warn("[NervLib] RegisterKeybind: tecla inválida para '" .. tostring(name) .. "'")
			return false
		end
		keyCode = keyCodeFromName(flag and savedFlags[flag], keyCode)
		keybinds["Custom." .. tostring(name)] = {
			key = keyCode,
			onPressed = callback,
			enabled = true,
			name = tostring(name),
			flag = flag,
			custom = true,
		}
		initFlag(flag, keyCode.Name)
		if refreshKeybindViewer then refreshKeybindViewer() end
		return true
	end

	-- Só remove atalhos criados com RegisterKeybind.
	function Window:UnregisterKeybind(name)
		keybinds["Custom." .. tostring(name)] = nil
		if refreshKeybindViewer then refreshKeybindViewer() end
	end

	-- name = nome do RegisterKeybind, ou a Flag de um AddKeybind.
	function Window:SetKeybindEnabled(name, enabled)
		local kb = findKeybind(name)
		if not kb then return false end
		kb.enabled = enabled and true or false
		if refreshKeybindViewer then refreshKeybindViewer() end
		return true
	end

	function Window:SetKeybindKey(name, key, silent)
		local _, id = findKeybind(name)
		if not id then return false end
		return applyKeybindKey(id, toKeyCode(key), silent)
	end

	-- Troca a tecla de mostrar/esconder a janela (atualiza o botão na página Settings também).
	function Window:SetToggleKeybind(key, silent)
		return applyKeybindKey("Window.Toggle", toKeyCode(key), silent)
	end

	-- id -> {Name, Key, Enabled, Custom}
	function Window:GetKeybinds()
		local result = {}
		for id, kb in pairs(keybinds) do
			result[id] = {
				Name = kb.name or id,
				Key = kb.key,
				Enabled = kb.enabled ~= false,
				Custom = kb.custom == true,
			}
		end
		return result
	end

	-- ================== MASCOTE ==================
	-- Personagem que reage ao mouse, aos cliques e às notificações.
	-- Espera PNGs com estes nomes dentro de `Folder` (ex.: hub/frames):
	-- angry blink blushAway boop denial dizzy excited flustered grumpy huff laugh
	-- lookDown lookL lookR lookUp mouth1 mouth2 mouth3 nervous ow pat poke pout
	-- shyGlance sleep smug squint wink yawn
	function Window:AddMascot(mo)
		mo = mo or {}
		local gh = mo.Github -- opcional: {User=, Repo=, Branch=}
		local folder = mo.Folder or "hub/frames"
		local size = mo.Size or Vector2.new(150, 150)
		local idleName = mo.Idle or "mouth1"
		local sleepAfter = mo.SleepAfter or 12
		local deadzone = mo.Deadzone or 70
		local fastSpeed = mo.FastSpeed or 3500 -- px/s

		local NAMES = {
			"angry", "blink", "blushAway", "boop", "denial", "dizzy", "excited", "flustered",
			"grumpy", "huff", "laugh", "lookDown", "lookL", "lookR", "lookUp",
			"mouth1", "mouth2", "mouth3", "nervous", "ow", "pat", "poke", "pout",
			"shyGlance", "sleep", "smug", "squint", "wink", "yawn",
		}
		local MOUTHS = {"mouth1", "mouth2", "mouth3"}
		local function pick(t) return t[math.random(#t)] end

		-- ---------- Imagem ----------
		local placement = mo.Placement or "Top" -- "Top" (apoiada na borda de cima) | "Sidebar"
		local overlap = mo.Overlap or 24        -- Top: quantos px do corpo descem sobre a borda da janela
		local behind = mo.Behind ~= false       -- Top: corpo atrás dos elementos da janela (só as mãos ficam na frente)
		local parent = mo.Parent or (placement == "Sidebar" and sidebar or mainFrame)
		local button = Instance.new("ImageButton")
		button.Name = "Mascot"
		button.BackgroundTransparency = 1
		button.AutoButtonColor = false
		button.Size = UDim2.fromOffset(size.X, size.Y)
		button.ScaleType = Enum.ScaleType.Fit
		button.AnchorPoint = Vector2.new(0.5, 1)
		if placement == "Top" then
			-- bottom do sprite um pouco abaixo da borda de cima da janela, como se espiasse por cima dela
			button.Position = mo.Position or UDim2.new(mo.X or 0.62, 0, 0, overlap + (mo.OffsetY or 0))
			button.ZIndex = behind and 0 or 2
			topExtra = math.max(size.Y - overlap, 0)
			applyScale()
		else
			button.Position = mo.Position or UDim2.new(0.5, 0, 1, -10)
			if parent == sidebar then
				-- a lista de páginas não passa por baixo dela
				navList.Size = UDim2.new(1, -22, 1, -104 - size.Y)
			end
		end
		button.Parent = parent

		-- Mãos apoiadas na borda (camada por cima do corpo). Assume PNGs do mesmo tamanho/posição do corpo.
		-- Só liga com Hands = true. Troque os nomes com HandFiles = {Left = "handL-hands", Right = "handR-hands"}.
		local handLayers = {}
		if placement == "Top" and mo.Hands == true then
			local handFiles = mo.HandFiles or {Left = "handL-hands", Right = "handR-hands"}
			for side, fileName in pairs(handFiles) do
				local hand = Instance.new("ImageLabel")
				hand.Name = "Hand" .. side
				hand.BackgroundTransparency = 1
				-- irmã do corpo (não filha) pra poder ficar NA FRENTE da janela enquanto o corpo fica atrás
				hand.Size = button.Size
				hand.Position = button.Position
				hand.AnchorPoint = button.AnchorPoint
				hand.ScaleType = Enum.ScaleType.Fit
				hand.ZIndex = 3
				hand.Active = false
				hand.Parent = parent
				task.spawn(function()
					local asset = resolveGithubAsset(folder .. "/" .. fileName .. ".png", gh)
					if asset and hand.Parent then hand.Image = asset end
				end)
				handLayers[side] = hand
			end
		end

		local frames, shown = {}, idleName
		local function show(name)
			shown = name
			local asset = frames[name] or frames[idleName]
			if asset and button.Image ~= asset then button.Image = asset end
		end

		-- baixa todos os frames em paralelo (com cache em disco)
		for _, name in ipairs(NAMES) do
			task.spawn(function()
				local asset = resolveGithubAsset(folder .. "/" .. name .. ".png", gh)
				if asset then
					frames[name] = asset
					if not unloaded then show(shown) end -- reaplica caso o frame atual tenha acabado de chegar
				end
			end)
		end

		-- diagnóstico: avisa no console se os frames não chegaram (repo/branch/pasta errados, HTTP bloqueado...)
		task.delay(10, function()
			if unloaded then return end
			local loaded, missing = 0, {}
			for _, name in ipairs(NAMES) do
				if frames[name] then loaded = loaded + 1 else missing[#missing + 1] = name end
			end
			local g = gh or Library.Github
			if loaded == 0 then
				warn(string.format("[NervLib] Mascote: NENHUM frame baixou de %s. Confira User/Repo/Branch/Folder e se getcustomasset/writefile existem no executor.",
					rawUrl(folder .. "/" .. idleName .. ".png", g)))
			elseif #missing > 0 then
				warn("[NervLib] Mascote: " .. #missing .. " frame(s) não baixaram: " .. table.concat(missing, ", "))
			else
				print("[NervLib] Mascote: " .. loaded .. " frames carregados.")
			end
		end)

		-- ---------- Estado ----------
		local reactName, reactUntil = nil, 0
		local blinkUntil, nextBlink = 0, os.clock() + 3
		local talkUntil = 0
		local holding, holdStart = false, 0
		local hovering = false
		local lookName = idleName
		local clicks, lastClick = 0, 0
		local lastMouse = UserInputService:GetMouseLocation()
		local lastMove, lastTick = os.clock(), os.clock()

		local function react(name, duration)
			reactName, reactUntil = name, os.clock() + (duration or 1.2)
		end

		-- ---------- Interação direta ----------
		button.MouseEnter:Connect(function() hovering = true end)
		button.MouseLeave:Connect(function() hovering, holding = false, false end)

		button.MouseButton1Down:Connect(function()
			local now = os.clock()
			holding, holdStart = true, now
			clicks = (now - lastClick < 2) and clicks + 1 or 1
			lastClick = now
		end)

		button.MouseButton1Up:Connect(function()
			if not holding then return end
			holding = false
			local held = os.clock() - holdStart
			if held > 1.5 then react("flustered", 1.8)
			elseif held > 0.35 then react("blushAway", 1.2)
			elseif clicks >= 9 then react("angry", 1.6)
			elseif clicks >= 7 then react("grumpy", 1.4)
			elseif clicks >= 5 then react("dizzy", 1.4)
			elseif clicks >= 3 then react("ow", 1)
			else react(clicks % 2 == 1 and "poke" or "boop", 0.7) end
		end)

		-- ---------- Loop principal ----------
		task.spawn(function()
			while not unloaded do
				task.wait(0.05)
				if unloaded then break end
				if not mainFrame.Visible then continue end
				local now = os.clock()

				-- movimento do mouse
				local mouse = UserInputService:GetMouseLocation()
				local dist = (mouse - lastMouse).Magnitude
				local speed = dist / math.max(now - lastTick, 0.001)
				lastTick, lastMouse = now, mouse
				if dist > 2 then lastMove = now end
				if speed > fastSpeed and not reactName then react("nervous", 0.7) end

				-- direção do olhar (GetMouseLocation inclui o inset do topo da tela)
				local center = button.AbsolutePosition + button.AbsoluteSize / 2
				local inset = GuiService:GetGuiInset()
				local d = (mouse - inset) - center
				if d.Magnitude < deadzone then lookName = idleName
				elseif math.abs(d.X) > math.abs(d.Y) then lookName = d.X < 0 and "lookL" or "lookR"
				else lookName = d.Y < 0 and "lookUp" or "lookDown" end

				-- piscar
				if now >= nextBlink then
					blinkUntil = now + 0.14
					nextBlink = now + 2.5 + math.random() * 3.5
				end

				-- fim de reação (depois de brava, ela bufa)
				if reactName and now >= reactUntil then
					if reactName == "angry" then react("huff", 1.5) else reactName = nil end
				end

				-- escolhe o frame (prioridade de cima pra baixo)
				local idle = now - lastMove
				local name
				if holding and now - holdStart > 0.35 then name = "pat"
				elseif reactName then name = reactName
				elseif now < blinkUntil and idle < sleepAfter then name = "blink"
				elseif now < talkUntil then name = MOUTHS[math.floor(now * 9) % 3 + 1]
				elseif idle > sleepAfter + 6 then name = "sleep"
				elseif idle > sleepAfter + 3 then name = "yawn"
				elseif idle > sleepAfter then name = "squint"
				elseif hovering then name = "shyGlance"
				else name = lookName end

				if name ~= shown then show(name) end
			end
		end)

		-- ---------- Reage à UI ----------
		Window.OnNotify = function(kind)
			if kind == "success" then react(pick({"excited", "laugh", "wink"}), 1.6)
			elseif kind == "error" then react(pick({"ow", "denial", "nervous"}), 1.8)
			else talkUntil = os.clock() + 1.4 end
		end

		-- toggles ligando/desligando: pisca/emburra
		track(Window.Changed:Connect(function(_, value)
			if value == true then react("wink", 0.9)
			elseif value == false then react("pout", 0.9) end
		end))

		return {
			Image = button,
			Hands = handLayers,
			React = function(_, name, duration) react(name, duration) end,
			Talk = function(_, duration) talkUntil = os.clock() + (duration or 1.5) end,
		}
	end

	-- ================== INICIALIZAÇÃO ==================
	applyScale()
	updateActivePage()
	env.__NervLibWindows[windowId] = Window

	return Window
end

return Library
