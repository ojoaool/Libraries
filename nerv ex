		Font = Enum.Font.GothamBold,
		TextSize = 12,
	}, row)

	newLabel({
		Size = UDim2.new(0.6, 0, 0, 13),
		Position = UDim2.new(0, 0, 0, 17),
		Text = description,
		TextColor3 = COLORS.TextMuted,
		TextSize = 10,
	}, row)

	local keyBtn = newButton({
		Name = "KeybindButton",
		Size = UDim2.new(0, 90, 0, 26),
		Position = UDim2.new(1, -90, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = COLORS.Field,
		Text = defaultKeyCode.Name,
		TextSize = 11,
		Corner = 6,
	}, row)
	stroke(keyBtn, COLORS.PanelBorder, 1)

	local currentKeyCode = defaultKeyCode
	local isListening = false
	local listenConnection

	local function stopListening(newKeyCode)
		isListening = false
		if listenConnection then
			listenConnection:Disconnect()
			listenConnection = nil
		end
		if newKeyCode then
			currentKeyCode = newKeyCode
		end
		keyBtn.Text = currentKeyCode.Name
	end

	local function startListening()
		isListening = true
		keyBtn.Text = "..."

		local function onCaptureInput(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				stopListening(input.KeyCode)
			end
		end
		listenConnection = UserInputService.InputBegan:Connect(onCaptureInput)
	end

	local function onKeybindButtonClicked()
		if isListening then
			stopListening()
		else
			startListening()
		end
	end
	keyBtn.MouseButton1Click:Connect(onKeybindButtonClicked)

	local function onGlobalInput(input, gameProcessed)
		if gameProcessed or isListening then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKeyCode then
			if onPressed then
				onPressed()
			end
		end
	end
	UserInputService.InputBegan:Connect(onGlobalInput)

	addRowDivider(row)

	local function getKeyCode()
		return currentKeyCode
	end

	return row, getKeyCode
end

