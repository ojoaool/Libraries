local function setToggleState(toggleBg, knob, isOn)
	local targetPos = isOn and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
	local targetBgColor = isOn and COLORS.ToggleOn or COLORS.ToggleOff
	-- Track ligado agora é branco, então o knob precisa ficar escuro nesse estado
	-- (senão um círculo quase-branco some dentro de um fundo branco).
	local targetKnobColor = isOn and COLORS.AccentDark or COLORS.Knob
	TweenService:Create(knob, TweenInfo.new(0.15), {Position = targetPos, BackgroundColor3 = targetKnobColor}):Play()
	TweenService:Create(toggleBg, TweenInfo.new(0.15), {BackgroundColor3 = targetBgColor}):Play()
end

-- Função nomeada: adiciona uma linha de toggle. onChanged(isOn) roda a cada mudança
-- (clique ou setState programático), alimentando o HubState em tempo real.
local function addToggleRow(card, title, description, defaultOn, onChanged)
	local row = newFrame({
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		LayoutOrder = nextRowOrder(),
	}, card)

	newLabel({
		Size = UDim2.new(0.75, 0, 0, 15),
		Text = title,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
	}, row)

	newLabel({
		Size = UDim2.new(0.75, 0, 0, 13),
		Position = UDim2.new(0, 0, 0, 17),
		Text = description,
		TextColor3 = COLORS.TextMuted,
		TextSize = 10,
	}, row)

	local toggleBg = newFrame({
		Name = "ToggleBg",
		Size = UDim2.new(0, 40, 0, 20),
		Position = UDim2.new(1, -40, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = defaultOn and COLORS.ToggleOn or COLORS.ToggleOff,
		Corner = 10,
	}, row)

	local knob = newFrame({
		Name = "Knob",
		Size = UDim2.new(0, 16, 0, 16),
		Position = defaultOn and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = defaultOn and COLORS.AccentDark or COLORS.Knob,
		Corner = 8,
	}, toggleBg)

	local clickCatcher = Instance.new("TextButton")
	clickCatcher.Name = "ToggleClickCatcher"
	clickCatcher.BackgroundTransparency = 1
	clickCatcher.Size = UDim2.new(1, 0, 1, 0)
	clickCatcher.Text = ""
	clickCatcher.Parent = toggleBg

	local isOn = defaultOn

	local function setState(value)
		isOn = value
		setToggleState(toggleBg, knob, isOn)
		if onChanged then
			onChanged(isOn)
		end
	end

	local function onToggleClicked()
		setState(not isOn)
	end
	clickCatcher.MouseButton1Click:Connect(onToggleClicked)

	addRowDivider(row)

	if onChanged then
		onChanged(isOn)
	end

	local function getToggleState()
		return isOn
	end

	return row, getToggleState, setState
end

