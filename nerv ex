		{GroupTransparency = 0}
	):Play()

	-- Função nomeada: some com o toast depois do tempo de exibição
	local function dismissNotification()
		local fadeOut = TweenService:Create(
			notifCanvas,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{GroupTransparency = 1}
		)
		local function onFadeOutDone()
			notifCanvas:Destroy()
		end
		fadeOut.Completed:Once(onFadeOutDone)
		fadeOut:Play()
	end
	task.delay(3, dismissNotification)
end

