-- É a "lógica do hub": Settings e qualquer aba != "Auto Join" caem no placeholder;
-- só "Automation" + "Auto Join" mostram o conteúdo real (STORY/RAID/CHALLENGE/...).
function updateActivePage()
	if currentNav ~= "Automation" then
		content.Visible = false
		placeholderPage.Visible = true
		placeholderTitle.Text = currentNav
		pageTitleLabel.Text = currentNav
	elseif currentTab ~= "Auto Join" then
		content.Visible = false
		placeholderPage.Visible = true
		placeholderTitle.Text = currentTab
		pageTitleLabel.Text = currentTab
	else
		placeholderPage.Visible = false
		content.Visible = true
		pageTitleLabel.Text = "Automation"
	end
end

