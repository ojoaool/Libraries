-- Estado central do hub: guarda o valor atual de cada dropdown/toggle pra qualquer
-- lógica de automação real ler depois (ex.: um loop de farm consultando HubState.Story.Map).
local HubState = {
	Story = {Map = nil, Stage = nil, Difficulty = nil, AutoJoin = false},
	Challenge = {Type = nil, Stage = nil, AutoJoin = false},
	Raid = {Map = nil, Act = nil, Difficulty = nil, AutoJoin = false},
