	tab.pillText = make("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 56), AutomaticSize = Enum.AutomaticSize.X,
		Text = tab.name, TextSize = 25, TextColor3 = C.text, FontFace = R.fontB,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = 2, ZIndex = 11,
	}, group)

	-- a box acompanha o conteúdo e fica centralizada (AbsoluteSize inclui o UIScale)
	local function layoutPill()
		local w = math.ceil(group.AbsoluteSize.X / self.scale)
		if w > 0 then pill.Size = UDim2.fromOffset(w + 56, 56) end
	end
	group:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutPill)
	layoutPill()
	pill.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

	table.insert(self.tabs, tab)
	if not self.activeTab then
		self:SelectTab(tab)
	else
		self:SelectTab(self.activeTab, true) -- reaplica estilo (nova tab fica inativa)
	end
	return tab
end

function Tab:SetName(name)
	self.name = name
	self.pillText.Text = name
end

----------------------------------------------------------------
-- SubTab (barra de cima)
----------------------------------------------------------------
local function showSub(tab, sub, animate)
	local C = Autumn.Theme
	local previous = tab.current
	tab.current = sub

	-- direção da animação conforme a posição da subtab
	local dir = 1
	if previous then
		local pi, ni
		for i, s in ipairs(tab.subList) do
			if s == previous then pi = i end
			if s == sub then ni = i end
		end
		if pi and ni and ni < pi then dir = -1 end
	end

	for _, s in ipairs(tab.subList) do
		local active = (s == sub)
		TweenService:Create(s.btn, TweenInfo.new(0.2), {
			BackgroundTransparency = active and 0 or 1,
		}):Play()
		s.icon.SetColor(active and C.dark or C.sub)
		s.text.TextColor3 = active and C.dark or C.sub
		s.glow.Enabled = active
		setPage(s, tab.active and active, animate, dir)
	end
end

function Tab:AddSubTab(opts)
	opts = opts or {}
	local C = Autumn.Theme
	local name = opts.Name or "SubTab"
	local sub = setmetatable({
		tab = self, name = name, cards = {}, columns = { Left = {}, Right = {} },
		autoFit = opts.AutoFit ~= false, -- 1 coluna só => cards ocupam a largura toda
	}, SubTab)

	local btn = make("TextButton", {
		Text = "", AutoButtonColor = false,
		Size = UDim2.fromOffset(0, 43), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.accent, BackgroundTransparency = 1, BorderSizePixel = 0,
		LayoutOrder = #self.subList + 1,
	}, self.holder)
	corner(btn, 10)
	sub.glow = stroke(btn, C.accent, 3, 0.65)
	sub.glow.Enabled = false
	-- o fundo laranja sempre acompanha o tamanho do nome
	make("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 18) }, btn)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	}, btn)

	sub.icon = makeIcon(btn, opts.Icon or name:lower(), 0, 0, 26, 26, C.sub, true)
	sub.icon.obj.LayoutOrder = 1
	if opts.Icon == false then sub.icon.obj.Visible = false end
	sub.text = label(btn, name, 0, 0, 0, 43, 28, C.sub, true)
	sub.text.Size = UDim2.fromOffset(0, 43)
	sub.text.AutomaticSize = Enum.AutomaticSize.X
	sub.text.LayoutOrder = 2
	sub.btn = btn

	-- o CanvasGroup permite fazer fade da página inteira na troca
	sub._visible = false
	sub.group = make("CanvasGroup", {
		Position = UDim2.fromOffset(PAGE_X, PAGE_Y), Size = UDim2.fromOffset(1073, 685),
		BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
	}, self.window.root)
	sub.page = make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.fromOffset(0, 0),
	}, sub.group)

	table.insert(self.subList, sub)
	btn.MouseButton1Click:Connect(function()
		if self.current == sub then return end
		showSub(self, sub, true)
		fire(self.window.OnSubTabChanged, self.name, name)
	end)

	if not self.current then showSub(self, sub) end
	return sub
end

function SubTab:_colHeight(col)
	local h = 0
	for _, c in ipairs(self.columns[col]) do h = h + c.height + CARD_GAP end
	return h
end

function SubTab:_relayout()
	local maxY = 0
	-- se só uma coluna tem cards, eles ocupam a largura toda (regulariza conforme a quantidade)
	local used = (#self.columns.Left > 0 and 1 or 0) + (#self.columns.Right > 0 and 1 or 0)
	local full = self.autoFit and used == 1
	for col, list in pairs(self.columns) do
		local y = 0
		local x = full and 0 or COL_X[col]
		local w = full and FULL_W or COL_W[col]
		for _, card in ipairs(list) do
			card.width = w
			card.frame.Position = UDim2.fromOffset(x, y)
			card.frame.Size = UDim2.fromOffset(w, card.height)
			y = y + card.height + CARD_GAP
		end
		maxY = math.max(maxY, y)
	end
	self.page.CanvasSize = UDim2.fromOffset(0, maxY + 10)
end

----------------------------------------------------------------
-- Card
----------------------------------------------------------------
function SubTab:AddCard(opts)
	opts = opts or {}
	local C, S = Autumn.Theme, Autumn.Style
	local col = opts.Column
	if col ~= "Left" and col ~= "Right" then
		col = (self:_colHeight("Left") <= self:_colHeight("Right")) and "Left" or "Right"
	end

	local card = setmetatable({
		sub = self, window = self.tab.window, column = col,
		y = 60,       -- topo da próxima linha (abaixo do cabeçalho)
		height = 74,
	}, Card)

	card.frame = make("Frame", {
		Size = UDim2.fromOffset(COL_W[col], 74),
		BackgroundColor3 = C.card, BorderSizePixel = 0,
	}, self.page)
	corner(card.frame, 18)
	stroke(card.frame, C.stroke, 1, 0.5)
	if R.bg then
		card.frame.BackgroundTransparency = 0.25 -- cor sólida por baixo da imagem
		imageBackground(card.frame, 18, S.CardImageTransparency, S.CardImageTint, 1)
	end
	makeIcon(card.frame, opts.Icon or "settings", 26, 25, 26, 26, C.sub, true)
	label(card.frame, string.upper(opts.Name or "CARD"), 54, 23, 300, 30, 22, C.sub, true)

	table.insert(self.columns[col], card)
	table.insert(self.cards, card)
	self:_relayout()
	return card
end

function Card:_advance(h)
	self.y = self.y + h
	self.height = self.y + 14
	self.sub:_relayout()
end

-- cria título + descrição e devolve o topo da linha
function Card:_row(opts, h)
	local C = Autumn.Theme
	local top = self.y
	local tx = 32
	if opts.Icon then -- ícone opcional à esquerda do título
		makeIcon(self.frame, opts.Icon, 32, top + 15, 28, 28, C.text, true)
		tx = 70
	end
	label(self.frame, opts.Name or "", tx, top + 11, 330, 36, 28, C.text, true)
	label(self.frame, opts.Description or "", tx, top + 43, 400, 28, 20, C.sub, false)
	self:_advance(h)
	return top
end

----------------------------------------------------------------
-- Toggle  { Name, Description, Default, Keybind, Flag, Callback, KeyCallback }
----------------------------------------------------------------
function Card:AddToggle(opts)
	opts = opts or {}
	local C = Autumn.Theme
	local window = self.window
	local top = self:_row(opts, 87)
	local flag = opts.Flag or opts.Name
	local state = opts.Default and true or false
	local el = {}

	local bg = make("TextButton", {
		Text = "", AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -32, 0, top + 38),
		Size = UDim2.fromOffset(56, 30),
		BackgroundColor3 = state and C.accent or C.off, BorderSizePixel = 0,
	}, self.frame)
	corner(bg, 15)
	local knob = make("Frame", {
		Position = UDim2.fromOffset(state and 31 or 5, 5), Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = state and C.knobOn or C.knobOff, BorderSizePixel = 0,
	}, bg)
	corner(knob, 10)

	function el:Set(v, silent)
		state = v and true or false
		Autumn.Flags[flag] = state
		local ti = TweenInfo.new(0.18, Enum.EasingStyle.Quad)
		TweenService:Create(bg, ti, { BackgroundColor3 = state and C.accent or C.off }):Play()
		TweenService:Create(knob, ti, {
			Position = UDim2.fromOffset(state and 31 or 5, 5),
			BackgroundColor3 = state and C.knobOn or C.knobOff,
		}):Play()
		if not silent then fire(opts.Callback, state) end
	end
	function el:Get() return state end

	bg.MouseButton1Click:Connect(function() el:Set(not state) end)
	Autumn.Flags[flag] = state

	-- keybind opcional (a tecla liga/desliga o toggle)
	if opts.Keybind then
		local key = typeof(opts.Keybind) == "EnumItem" and opts.Keybind or nil
		local listening = false
		local kb = make("TextButton", {
			Text = key and key.Name or "None", AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -104, 0, top + 36),
			Size = UDim2.fromOffset(67, 36),
			BackgroundColor3 = C.key, BorderSizePixel = 0,
			TextColor3 = C.text, TextSize = 20, FontFace = R.fontR,
		}, self.frame)
		corner(kb, 6)
		stroke(kb, C.stroke, 1, 0.2)
		Autumn.Flags[flag .. "_Key"] = key

		function el:SetKey(k)
			key = k
			kb.Text = key and key.Name or "None"
			Autumn.Flags[flag .. "_Key"] = key
			fire(opts.KeyCallback, key)
		end
		function el:GetKey() return key end

		kb.MouseButton1Click:Connect(function()
			if listening then return end
			listening = true
			kb.Text = "..."
			local conn
			conn = UserInputService.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.Keyboard then
					conn:Disconnect()
					task.defer(function() listening = false end)
					el:SetKey(i.KeyCode ~= Enum.KeyCode.Escape and i.KeyCode or nil)
				end
			end)
		end)
		window:_connect(UserInputService.InputBegan, function(i, gp)
			if not gp and not listening and key and i.KeyCode == key then
				el:Set(not state)
			end
		end)
	end

	return el
end

