----------------------------------------------------------------
-- Utilitários de ambiente (HTTP / arquivos)
----------------------------------------------------------------
local function httpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" then return res end
	local req = http_request or request or (syn and syn.request)
	if req then
		local ok2, r = pcall(req, { Url = url, Method = "GET" })
		if ok2 and type(r) == "table" and r.Body then return r.Body end
	end
	return nil
end

local function validBody(body, kind)
	if type(body) ~= "string" or #body < 64 then return false end
	if kind == "png" then return body:sub(2, 4) == "PNG" end
	return body:sub(1, 3) ~= "404" and not body:find("<!DOCTYPE", 1, true)
end

local warned = {}
local function warnOnce(msg)
	if not warned[msg] then
		warned[msg] = true
		warn("[Autumn] " .. msg)
	end
end

-- baixa (uma vez) um arquivo e devolve o caminho local
-- file = nome do arquivo no cache | url = endereço (padrão: AssetsUrl .. file)
local function fetchFile(file, kind, url)
	if not (writefile and getcustomasset) then return nil end
	local ok, res = pcall(function()
		local folder = Autumn.Folder
		if makefolder and isfolder and not isfolder(folder) then makefolder(folder) end
		local path = folder .. "/" .. file
		if not (isfile and isfile(path)) then
			local body = httpGet(url or (Autumn.AssetsUrl .. file))
			if not validBody(body, kind) then error("arquivo inválido ou inexistente: " .. file) end
			writefile(path, body)
		end
		return path
	end)
	if ok then return res end
	warnOnce(tostring(res))
	return nil
end

local function loadFont(file, family)
	local path = fetchFile(file, "font")
	if not path then return nil end
	local ok, font = pcall(function()
		local jsonPath = Autumn.Folder .. "/" .. family .. ".json"
		writefile(jsonPath, HttpService:JSONEncode({
			name = family,
			faces = { {
				name = "Regular", weight = 400, style = "normal",
				assetId = getcustomasset(path),
			} },
		}))
		return Font.new(getcustomasset(jsonPath), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end)
	if ok then return font end
	warnOnce("não foi possível carregar a fonte " .. file)
	return nil
end

