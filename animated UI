local env = getfenv()
local writefile, readfile, isfile, delfile = env.writefile, env.readfile, env.isfile, env.delfile
local isfolder, makefolder, listfiles = env.isfolder, env.makefolder, env.listfiles
local getasset = env.getcustomasset or env.getsynasset
local CAN_DOWNLOAD = (writefile and isfile and getasset) and true or false

local function httpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" and #res > 0 then return res end
	local req = (env.syn and env.syn.request) or env.http_request or env.request
	if req then
		local ok2, r = pcall(req, { Url = url, Method = "GET" })
		if ok2 and r and r.StatusCode == 200 then return r.Body end
	end
end

local function ensureFolder(path)
	if not (isfolder and makefolder) then return end
	pcall(function()
		local acc = ""
		for part in string.gmatch(path, "[^/]+") do
			acc = acc == "" and part or (acc .. "/" .. part)
			if not isfolder(acc) then makefolder(acc) end
		end
	end)
end

local function download(baseUrl, dir, fileName)
	local safe = (string.gsub(fileName, "[^%w%.%-_]", "_"))
	local path = dir .. "/" .. safe
	if not isfile(path) then
		local data = httpGet(baseUrl .. HttpService:UrlEncode(fileName))
		if not data then return nil end
		writefile(path, data)
	end
	return path
end

local initialized = false
local function init()
	if initialized then return end
	initialized = true
	local A = Library.Assets
	if not CAN_DOWNLOAD then
		warn("[FarmUI] writefile/getcustomasset indisponíveis — usando fonte padrão, sem ícones/mascote.")
		return
	end
	ensureFolder(A.FontDir)
	for key, fileName in pairs(FONT_FILES) do
		local ok, face = pcall(function()
			local path = download(A.FontBase, A.FontDir, fileName)
			if not path then return nil end
			local jsonPath = A.FontDir .. "/" .. key .. ".json"
			writefile(jsonPath, HttpService:JSONEncode({
				name = "FarmUI_" .. key,
				faces = { { name = "Regular", weight = 400, style = "normal", assetId = getasset(path) } },
			}))
			return Font.new(getasset(jsonPath), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
		end)
		if ok and face then
			Fonts[key] = face
		else
			warn("[FarmUI] não foi possível carregar a fonte: " .. fileName)
		end
	end
end

local IconCache = {}
local function applyIcon(img, key, onLoaded)
	local file = Library.IconFiles[key]
	if not file then
		img.Visible = false
		return
	end
	local function done(asset)
		if img.Parent then
			img.Image = asset
			img.Visible = true
			if onLoaded then onLoaded() end
		end
	end
	if string.sub(file, 1, 13) == "rbxassetid://" then return done(file) end
	if IconCache[key] then return done(IconCache[key]) end
	img.Visible = false
	if not CAN_DOWNLOAD then return end
	local A = Library.Assets
	ensureFolder(A.IconDir)
	task.spawn(function()
		local ok, asset = pcall(function()
			local path = download(A.IconBase, A.IconDir, file)
			return path and getasset(path)
		end)
		if ok and asset then
			IconCache[key] = asset
			done(asset)
		else
			warn("[FarmUI] não foi possível carregar o ícone: " .. file)
		end
	end)
end

