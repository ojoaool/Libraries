local Window, Tab, SubTab, Card = {}, {}, {}, {}
Window.__index, Tab.__index, SubTab.__index, Card.__index = Window, Tab, SubTab, Card

local DESIGN_W, DESIGN_H = 1120, 864
local COL_X = { Left = 0, Right = 547 }
local COL_W = { Left = 526, Right = 525 }
local FULL_W = 1073 -- largura quando só há uma coluna de cards
local CARD_GAP = 20
local PAGE_X, PAGE_Y = 23, 160

-- mostra/esconde uma página com animação (fade + deslize)
--   dir =  1 / -1 : desliza da direita / esquerda (troca de subtab)
--   dir =  0      : sobe de baixo para cima (troca de tab)
local function setPage(sub, visible, animate, dir)
	if sub._visible == visible then return end
	sub._visible = visible
	local g = sub.group
	if sub._tween then sub._tween:Cancel() sub._tween = nil end

	if visible then
		g.Visible = true
		if animate then
			dir = dir or 0
			g.GroupTransparency = 1
			g.Position = UDim2.fromOffset(PAGE_X + dir * 40, PAGE_Y + (dir == 0 and 24 or 0))
			sub._tween = TweenService:Create(g,
				TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{ GroupTransparency = 0, Position = UDim2.fromOffset(PAGE_X, PAGE_Y) })
			sub._tween:Play()
		else
			g.GroupTransparency = 0
			g.Position = UDim2.fromOffset(PAGE_X, PAGE_Y)
		end
	elseif animate and g.Visible then
		local tw = TweenService:Create(g,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ GroupTransparency = 1 })
		sub._tween = tw
		tw.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and not sub._visible then
				g.Visible = false
			end
		end)
		tw:Play()
	else
		g.Visible = false
	end
end

