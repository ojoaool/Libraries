	local function setTabColor(n, color, t)
		tween(tabButtons[n], { TextColor3 = color }, t)
		local ic = tabIcons[n]
		if ic and Library.Assets.IconTint then tween(ic, { ImageColor3 = color }, t) end
	end

	local function moveIndicator(name, instant)
		local width, posX = tabWidths[name], tabPositions[name]
		if not width or not posX then return end
		if instant then
			tabIndicator.Position = UDim2.fromOffset(posX, 0)
			tabIndicator.Size = UDim2.fromOffset(width, 34)
			tabIndicator.Visible = true
		else
			tween(tabIndicator, {
				Position = UDim2.fromOffset(posX, 0), Size = UDim2.fromOffset(width, 34),
			}, 0.35, Enum.EasingStyle.Quint)
		end
	end

	function Window:SelectTab(name)
		if currentTab == name or not pages[name] then return end
		local prev = currentTab
		currentTab = name
		self.CurrentTab = name

		moveIndicator(name, prev == nil)
		for n in pairs(tabButtons) do
			setTabColor(n, n == name and T.text or TAB_INACTIVE, 0.3)
		end

		local dir = (prev and tabOrder[name] < tabOrder[prev]) and -1 or 1
		local page = pages[name]
		page.Position = UDim2.fromOffset(PAGE_SLIDE * dir, 0)
		page.GroupTransparency = 1
		page.Visible = true
		tween(page, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.5, Enum.EasingStyle.Quint)

		if prev then
			local oldPage = pages[prev]
			tween(oldPage, { Position = UDim2.fromOffset(-PAGE_SLIDE * dir, 0), GroupTransparency = 1 }, 0.22, Enum.EasingStyle.Quad)
			task.delay(0.24, function()
				if currentTab ~= prev then oldPage.Visible = false end
			end)
		end
		self.TabChanged:Fire(name, prev)
	end

