	-- ── Slider ────────────────────────────────────────────────────────────────
	-- AddSlider(texto, min, max, padrão, callback, sufixo)
	-- ou AddSlider({ Text, Min, Max, Default, Increment, Suffix, Callback, Flag, Tooltip })
	function CardMethods:AddSlider(a, b, c, d, e, f)
		local o = type(a) == "table" and a or { Text = a, Min = b, Max = c, Default = d, Callback = e, Suffix = f }
		local min, max = o.Min or 0, o.Max or 100
		if max <= min then max = min + 1 end
		local step = o.Increment or 1
		local decimals = #(tostring(step):match("%.(%d+)") or "")
		local suffix = o.Suffix or ""

		local function snap(v)
			v = tonumber(v)
			if not v then return nil end
			v = math.clamp(v, min, max)
			v = min + math.floor((v - min) / step + 0.5) * step
			return math.clamp(math.floor(v * 1e6 + 0.5) / 1e6, min, max)
		end
		local function fmt(v) return string.format("%." .. decimals .. "f", v) .. suffix end

		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, self.Frame)
		local lbl = label(row, o.Text or "Slider", { Size = UDim2.new(0.5, 0, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd })
		local default = snap(o.Default or min)
		local val = label(row, fmt(default), {
			Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0.5, 0, 0, 14),
			TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.accent, TextSize = 11, Face = "mono600",
		})
		local bar = new("Frame", { Position = UDim2.new(0, 0, 0, 21), Size = UDim2.new(1, 0, 0, 5), BackgroundColor3 = T.off }, row)
		corner(bar, 3)
		local fill = new("Frame", { Size = UDim2.fromScale((default - min) / (max - min), 1), BackgroundColor3 = T.accent }, bar)
		corner(fill, 3)
		local knob = new("Frame", {
			Size = UDim2.fromOffset(13, 13), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
		}, fill)
		corner(knob, 7)

		local el = makeElement(self, "Slider", row, o)
		el._value, el._label = default, lbl
		el.Min, el.Max = min, max
		el._normalize = snap
		el._render = function(v)
			tween(fill, { Size = UDim2.fromScale((v - min) / (max - min), 1) }, 0.06)
			val.Text = fmt(v)
		end

		local dragging = false
		local function fromX(x)
			local alpha = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
			el:Set(min + (max - min) * alpha)
		end
		row.InputBegan:Connect(function(i)
			if el._disabled then return end
			if isPress(i) then
				dragging = true
				tween(knob, { Size = UDim2.fromOffset(17, 17) }, 0.1)
				fromX(i.Position.X)
			end
		end)
		trackFor(el, UIS.InputChanged:Connect(function(i)
			if dragging and isMove(i) then fromX(i.Position.X) end
		end))
		trackFor(el, UIS.InputEnded:Connect(function(i)
			if isPress(i) and dragging then
				dragging = false
				tween(knob, { Size = UDim2.fromOffset(13, 13) }, 0.1)
			end
		end))

		registerFlag(el)
		if o.Disabled then el:SetDisabled(true) end
		return el
	end

	-- ── Dropdown ──────────────────────────────────────────────────────────────
	-- AddDropdown(texto, opções, padrão, callback)
	-- ou AddDropdown({ Text, Options, Default, Multi, Callback, Flag, Tooltip })
	-- Multi = true  -> valor é uma lista (ex: {"A","B"})
	-- Métodos extras: el:Refresh(novasOpcoes, manterValor), el:GetOptions()
	local OPT_H, MAX_VISIBLE = 20, 8

	function CardMethods:AddDropdown(a, b, c, d)
		local o = type(a) == "table" and a or { Text = a, Options = b, Default = c, Callback = d }
		local options = o.Options or {}
		local multi = o.Multi == true
		local el

		local function computeNeed()
			local m = 0
			for _, opt in ipairs(options) do
				m = math.max(m, getTextWidth(tostring(opt) .. "  ▾", 11))
			end
			return math.clamp(m + 16, 64, multi and 150 or 170)
		end

		local ctrl = splitRow(self.Frame, o.Text or "Dropdown", computeNeed(), 64, 22)
		local btn = new("TextButton", {
			Size = UDim2.fromOffset(84, 20), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0), Text = "", Face = "sans600", TextSize = 11,
			TextColor3 = T.text, BackgroundColor3 = T.field, AutoButtonColor = false,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, ctrl.Row)
		corner(btn, 7)
		pad(btn, 0, 6, 0, 6)
		btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = Color3.fromRGB(50, 50, 61) }) end)
		btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = T.field }) end)
		ctrl:Bind(btn)

		local function normalize(v)
			if multi then
				local out = {}
				if type(v) == "table" then
					for _, x in ipairs(v) do table.insert(out, x) end
				elseif v ~= nil and v ~= "" then
					out[1] = v
				end
				return out
			end
			if type(v) == "table" then v = v[1] end
			return v
		end
		local function display(v)
			if multi then
				return (#v == 0 and "None" or table.concat(v, ", ")) .. "  ▾"
			end
			return (v == nil and "None" or tostring(v)) .. "  ▾"
		end
		local function isSelected(opt)
			if multi then return table.find(el._value, opt) ~= nil end
			return el._value == opt
		end

		el = makeElement(self, "Dropdown", ctrl.Row, o)
		el._ctrl, el._label = ctrl, ctrl.Label
		if multi then
			el._value = normalize(o.Default)
		else
			el._value = normalize(o.Default ~= nil and o.Default or options[1])
		end
		el._normalize = normalize
		el._render = function(v) btn.Text = display(v) end
		btn.Text = display(el._value)

		function el:GetOptions() return options end
		function el:Refresh(newOptions, keep)
			options = newOptions or {}
			closeDropdown()
			ctrl.need = computeNeed()
			ctrl.min = math.min(ctrl.min, ctrl.need)
			ctrl:Layout()
			if multi then
				local kept = {}
				if keep then
					for _, x in ipairs(self._value) do
						if table.find(options, x) then table.insert(kept, x) end
					end
				end
				self:Set(kept)
			else
				if not (keep and table.find(options, self._value)) then
					self:Set(options[1] ~= nil and options[1] or "None")
				end
			end
		end

		btn.MouseButton1Click:Connect(function()
			if el._disabled then return end
			local wasOpen = openList ~= nil
			closeDropdown()
			if wasOpen then return end

			catcher = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 49 }, gui)
			catcher.MouseButton1Click:Connect(closeDropdown)

			local pos = btn.AbsolutePosition
			local listW = math.max(btn.AbsoluteSize.X, ctrl.need * scale.Scale)
			local visible = math.min(#options, MAX_VISIBLE)
			local h = math.max(visible, 1) * OPT_H + 8
			local l = new("ScrollingFrame", {
				Position = UDim2.fromOffset(pos.X + btn.AbsoluteSize.X - listW, pos.Y + btn.AbsoluteSize.Y + 4),
				Size = UDim2.fromOffset(listW, 0), BackgroundColor3 = T.field, BorderSizePixel = 0,
				ZIndex = 50, ClipsDescendants = true, ScrollBarThickness = 2, ScrollBarImageColor3 = T.off,
				CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			}, gui)
			corner(l, 10)
			new("UIStroke", { Color = Color3.fromRGB(70, 70, 84) }, l)
			pad(l, 4)
			list(l, 0)
			openList = l
			tween(l, { Size = UDim2.fromOffset(listW, h) }, 0.15)

			local buttons = {}
			local function paint()
				for opt, ob in pairs(buttons) do
					tween(ob, { BackgroundTransparency = isSelected(opt) and 0.7 or 1 }, 0.1)
				end
			end
			for _, opt in ipairs(options) do
				local ob = new("TextButton", {
					Size = UDim2.new(1, 0, 0, OPT_H), Text = tostring(opt), Font = T.font, TextSize = 11,
					TextColor3 = T.text, BackgroundColor3 = T.accent,
					BackgroundTransparency = isSelected(opt) and 0.7 or 1,
					AutoButtonColor = false, ZIndex = 51,
				}, l)
				corner(ob, 7)
				buttons[opt] = ob
				ob.MouseEnter:Connect(function() tween(ob, { BackgroundTransparency = 0.5 }, 0.1) end)
				ob.MouseLeave:Connect(function() tween(ob, { BackgroundTransparency = isSelected(opt) and 0.7 or 1 }, 0.1) end)
				ob.MouseButton1Click:Connect(function()
					if multi then
						local nextValue = {}
						for _, x in ipairs(options) do
							local on = isSelected(x)
							if x == opt then on = not on end
							if on then table.insert(nextValue, x) end
						end
						el:Set(nextValue)
						paint()
					else
						el:Set(opt)
						closeDropdown()
					end
				end)
			end
		end)

		registerFlag(el)
		if o.Disabled then el:SetDisabled(true) end
		return el
	end

	-- ── Button ────────────────────────────────────────────────────────────────
	-- AddButton(texto, callback)  ou  AddButton({ Text, Callback, Style = "primary"|"secondary"|"danger", Tooltip })
	-- Sinal: el.Clicked:Connect(fn)   |   el:Click() dispara manualmente
	function CardMethods:AddButton(a, b)
		local o = type(a) == "table" and a or { Text = a, Callback = b }
		local styles = {
			primary = { T.accent, T.accentHover },
			secondary = { T.field, Color3.fromRGB(50, 50, 61) },
			danger = { T.red, Color3.fromRGB(248, 113, 113) },
		}
		local style = styles[o.Style or "primary"] or styles.primary
		local prefix = "➤   "
		local b2 = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 28), Text = prefix .. (o.Text or "Button"), Font = T.fontBold, TextSize = 12,
			TextColor3 = T.text, BackgroundColor3 = style[1], AutoButtonColor = false,
		}, self.Frame)
		corner(b2, 9)

		local el = makeElement(self, "Button", b2, o)
		el._label, el._prefix = b2, prefix
		el.Clicked = el.Changed
		function el:Click()
			if self._disabled then return end
			react("excited", 1.4)
			self.Changed:Fire()
			safeCall(self._callback)
		end

		b2.MouseEnter:Connect(function() tween(b2, { BackgroundColor3 = style[2] }) end)
		b2.MouseLeave:Connect(function() tween(b2, { BackgroundColor3 = style[1] }) end)
		b2.MouseButton1Down:Connect(function() tween(b2, { Size = UDim2.new(1, -6, 0, 26) }, 0.08) end)
		b2.MouseButton1Up:Connect(function() tween(b2, { Size = UDim2.new(1, 0, 0, 28) }, 0.08) end)
		b2.MouseButton1Click:Connect(function() el:Click() end)

		if o.Disabled then el:SetDisabled(true) end
		return el
	end

	-- ── Keybind ───────────────────────────────────────────────────────────────
	-- AddKeybind({ Text, Default = Enum.KeyCode.X, Callback = ao PRESSIONAR a tecla,
	--              ChangedCallback = ao TROCAR a tecla, Flag })
	-- Sinais: el.Pressed (tecla pressionada), el.Changed (tecla trocada). Esc limpa.
	function CardMethods:AddKeybind(a, b, c)
		local o = type(a) == "table" and a or { Text = a, Default = b, Callback = c }
		local ctrl = splitRow(self.Frame, o.Text or "Keybind", 84, 56, 22)
		local btn = new("TextButton", {
			Size = UDim2.fromOffset(84, 20), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			Text = "", Face = "mono600", TextSize = 10, TextColor3 = T.text, BackgroundColor3 = T.field,
			AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd,
		}, ctrl.Row)
		corner(btn, 7)
		ctrl:Bind(btn)

		local function norm(v)
			if typeof(v) == "EnumItem" then return v.Name end
			if v == nil or v == "" then return "None" end
			return tostring(v)
		end

		local el = makeElement(self, "Keybind", ctrl.Row, { Text = o.Text, Flag = o.Flag, Tooltip = o.Tooltip, Callback = o.ChangedCallback })
		el._ctrl, el._label = ctrl, ctrl.Label
		el._value = norm(o.Default)
		el._normalize = norm
		el._render = function(v)
			btn.Text = v
			btn.TextColor3 = T.text
		end
		el._render(el._value)
		el.Pressed = Signal.new()
		el._onPress = o.Callback

		function el:GetKeyCode()
			local ok, k = pcall(function() return Enum.KeyCode[self._value] end)
			return ok and k or nil
		end
		function el:_cancelListen()
			if listening == self then listening = nil end
			self._render(self._value)
		end
		function el:_finishListen(keycode)
			listening = nil
			self:Set(keycode == Enum.KeyCode.Escape and "None" or keycode.Name)
		end
		el._onDestroy = function()
			local i = table.find(keybinds, el)
			if i then table.remove(keybinds, i) end
			if listening == el then listening = nil end
		end
		table.insert(keybinds, el)

		btn.MouseButton1Click:Connect(function()
			if el._disabled then return end
			if listening == el then return el:_cancelListen() end
			if listening then listening:_cancelListen() end
			listening = el
			btn.Text = "..."
			btn.TextColor3 = T.accent
		end)

		registerFlag(el)
		if o.Disabled then el:SetDisabled(true) end
		return el
	end

	-- ── Input (caixa de texto) ────────────────────────────────────────────────
	-- AddInput({ Text, Default, Placeholder, Numeric = true, Callback, Flag, Tooltip })
	function CardMethods:AddInput(a, b, c, d)
		local o = type(a) == "table" and a or { Text = a, Default = b, Callback = c, Placeholder = d }
		local ctrl = splitRow(self.Frame, o.Text or "Input", 100, 60, 22)
		local box = new("TextBox", {
			Size = UDim2.fromOffset(100, 20), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			Text = "", PlaceholderText = o.Placeholder or "", PlaceholderColor3 = T.sub,
			Face = "sans600", TextSize = 11, TextColor3 = T.text, BackgroundColor3 = T.field,
			ClearTextOnFocus = o.ClearOnFocus == true, TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, ctrl.Row)
		corner(box, 7)
		pad(box, 0, 6, 0, 6)
		ctrl:Bind(box)

		local numeric = o.Numeric == true
		local el = makeElement(self, "Input", ctrl.Row, o)
		el._ctrl, el._label = ctrl, ctrl.Label
		el._normalize = function(v)
			if numeric then return tonumber(v) end
			return tostring(v == nil and "" or v)
		end
		el._render = function(v) box.Text = tostring(v) end
		el._value = el._normalize(o.Default) or (numeric and 0 or "")
		box.Text = tostring(el._value)

		box.FocusLost:Connect(function()
			if el._disabled then box.Text = tostring(el._value) return end
			if numeric and tonumber(box.Text) == nil then
				box.Text = tostring(el._value)
				return
			end
			el:Set(box.Text)
		end)

		registerFlag(el)
		if o.Disabled then el:SetDisabled(true) end
		return el
	end

