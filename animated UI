local function safeCall(fn, ...)
	if type(fn) ~= "function" then return false end
	local ok, err = xpcall(fn, function(e) return debug.traceback(tostring(e), 2) end, ...)
	if not ok then warn("[FarmUI] erro em callback:\n" .. tostring(err)) end
	return ok
end

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _h = {} }, Signal)
end

function Signal:Connect(fn)
	local list = self._h
	local h = { fn = fn, on = true }
	table.insert(list, h)
	local conn = { Connected = true }
	conn.Disconnect = function()
		h.on = false
		conn.Connected = false
		local i = table.find(list, h)
		if i then table.remove(list, i) end
	end
	return conn
end

function Signal:Once(fn)
	local conn
	conn = self:Connect(function(...)
		conn.Disconnect()
		fn(...)
	end)
	return conn
end

function Signal:Wait()
	local co = coroutine.running()
	self:Once(function(...) task.spawn(co, ...) end)
	return coroutine.yield()
end

function Signal:Fire(...)
	for _, h in ipairs(table.clone(self._h)) do
		if h.on then safeCall(h.fn, ...) end
	end
end

function Signal:DisconnectAll()
	for _, h in ipairs(self._h) do h.on = false end
	table.clear(self._h)
end

Library.Signal = Signal

local function valuesEqual(a, b)
	if type(a) == "table" and type(b) == "table" then
		if #a ~= #b then return false end
		for i = 1, #a do
			if a[i] ~= b[i] then return false end
		end
		return true
	end
	return a == b
end

local function sanitizeName(s)
	local clean = tostring(s or ""):gsub("[^%w%-_ ]", "")
	return string.sub(clean, 1, 40)
end

-- permite chamar tanto obj.Metodo(x) quanto obj:Metodo(x)
local function dual(obj, name, fn)
	rawset(obj, name, function(a, ...)
		if a == obj then return fn(obj, ...) end
		return fn(obj, a, ...)
	end)
end

