-- Slider  { Name, Description, Min, Max, Default, Flag, Callback }
----------------------------------------------------------------
function Card:AddSlider(opts)
	opts = opts or {}
	local C = Autumn.Theme
	local window = self.window
	local top = self:_row(opts, 118)
	local flag = opts.Flag or opts.Name
	local min, max = opts.Min or 0, opts.Max or 100
	local value = math.clamp(opts.Default or min, min, max)
	local el = {}

	local track = make("Frame", {
		Position = UDim2.fromOffset(32, top + 87), Size = UDim2.new(1, -64, 0, 4),
		BackgroundColor3 = C.off, BorderSizePixel = 0,
	}, self.frame)
	corner(track, 2)
	local fill = make("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.accent, BorderSizePixel = 0,
	}, track)
	corner(fill, 2)
	local knob = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(24, 24), BackgroundColor3 = C.text,
		BorderSizePixel = 0, ZIndex = 2,
	}, track)
	corner(knob, 12)
	local valueLabel = label(self.frame, tostring(value), 0, 0, 100, 30, 22,
		C.sub, false, Enum.TextXAlignment.Right)
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, -32, 0, top + 9)
	local hit = make("TextButton", {
		Text = "", BackgroundTransparency = 1,
		Position = UDim2.fromOffset(32, top + 75), Size = UDim2.new(1, -64, 0, 28),
	}, self.frame)

	function el:Set(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		value = v
		local a = (max == min) and 0 or (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		valueLabel.Text = tostring(v)
		Autumn.Flags[flag] = v
		if not silent then fire(opts.Callback, v) end
	end
	function el:Get() return value end

	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + a * (max - min) + 0.5)
		if v ~= value then el:Set(v) end
	end

	local dragging = false
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(i.Position.X)
		end
	end)
	window:_connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
			or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(i.Position.X)
		end
	end)
	window:_connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	el:Set(value, true)
	return el
end

----------------------------------------------------------------
-- Progress  { Name, Description, Min, Max, Default, Format, Flag, Callback, OnComplete }
-- Barra de progresso que vai se enchendo (não é arrastável).
--   el:Set(valor, instantaneo)   el:Get()   el:Increment(n)
--   el:FillOver(segundos, aoTerminar)  -> enche sozinha até o máximo
----------------------------------------------------------------
function Card:AddProgress(opts)
	opts = opts or {}
	local C = Autumn.Theme
	local top = self:_row(opts, 112)
	local flag = opts.Flag or opts.Name
	local min, max = opts.Min or 0, opts.Max or 100
	local value = math.clamp(opts.Default or min, min, max)
	local format = opts.Format or function(_, alpha)
		return math.floor(alpha * 100 + 0.5) .. "%"
	end
	local el = {}

	local track = make("Frame", {
		Position = UDim2.fromOffset(32, top + 85), Size = UDim2.new(1, -64, 0, 10),
		BackgroundColor3 = C.off, BorderSizePixel = 0, ClipsDescendants = true,
	}, self.frame)
	corner(track, 5)
	local fill = make("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.accent, BorderSizePixel = 0,
	}, track)
	corner(fill, 5)
	make("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(150, 76, 36), Color3.fromRGB(232, 140, 78)),
	}, fill)
	local valueLabel = label(self.frame, "", 0, 0, 100, 30, 22, C.sub,
		false, Enum.TextXAlignment.Right)
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, -32, 0, top + 9)

	local function alphaOf(v)
		return (max == min) and 0 or (v - min) / (max - min)
	end

	function el:Set(v, instant, silent)
		v = math.clamp(v, min, max)
		value = v
		Autumn.Flags[flag] = v
		local a = alphaOf(v)
		valueLabel.Text = tostring(format(v, a))
		if instant then
			fill.Size = UDim2.fromScale(a, 1)
		else
			TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				Size = UDim2.fromScale(a, 1),
			}):Play()
		end
		if not silent then
			fire(opts.Callback, v)
			if v >= max then fire(opts.OnComplete) end
		end
	end
	function el:Get() return value end
	function el:Increment(n) el:Set(value + (n or 1)) end

	local run = 0
	function el:FillOver(seconds, onDone)
		run = run + 1
		local mine = run
		task.spawn(function()
			local start, t0 = value, os.clock()
			while mine == run and track.Parent do
				local a = math.clamp((os.clock() - t0) / math.max(seconds, 0.01), 0, 1)
				el:Set(start + (max - start) * a, true, true)
				if a >= 1 then break end
				task.wait()
			end
			if mine == run and track.Parent then
				fire(opts.Callback, value)
				fire(opts.OnComplete)
				fire(onDone)
			end
		end)
	end

	el:Set(value, true, true)
	return el
end

----------------------------------------------------------------
-- Button  { Name, Description, ButtonText, Callback }
-- Botão de largura total do card (acompanha o tamanho do card), na cor dos toggles.
--   só Name                      -> botão com o texto = Name
--   Description e/ou ButtonText  -> título + descrição e, abaixo, o botão
----------------------------------------------------------------
function Card:AddButton(opts)
	opts = opts or {}
	local C, S = Autumn.Theme, Autumn.Style
	local BTN_H, RADIUS = 56, 20
	local labelled = (opts.Description ~= nil) or (opts.ButtonText ~= nil)
	local top, btnY

	if labelled then
		top = self:_row(opts, 146)  -- título + descrição
		btnY = top + 80
	else
		top = self.y
		btnY = top + 2
		self:_advance(BTN_H + 10)
	end

	-- ícone dentro do botão: sem descrição -> Icon; com descrição -> ButtonIcon
	local btnIcon = labelled and opts.ButtonIcon or (opts.Icon or opts.ButtonIcon)

	local btn = make("TextButton", {
		Text = "", AutoButtonColor = false,
		Position = UDim2.fromOffset(32, btnY), Size = UDim2.new(1, -64, 0, BTN_H),
		BackgroundColor3 = C.off, BackgroundTransparency = R.bg and 0.2 or 0,
		BorderSizePixel = 0,
	}, self.frame)
	corner(btn, RADIUS)
	stroke(btn, C.stroke, 1, 0.4)

	-- mesmo png de fundo dos cards
	local img = imageBackground(btn, RADIUS, S.CardImageTransparency, S.CardImageTint, 1)

	-- conteúdo (ícone + texto) centralizado, acima da imagem
	local group = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, BTN_H), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, ZIndex = 3,
	}, btn)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, group)
	if btnIcon then
		local ic = makeIcon(group, btnIcon, 0, 0, 28, 28, C.text, true)
		ic.obj.ZIndex = 3
		ic.obj.LayoutOrder = 1
	end
	local txt = make("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, BTN_H), AutomaticSize = Enum.AutomaticSize.X,
		Text = opts.ButtonText or opts.Name or "Button",
		TextSize = 25, TextColor3 = C.text, FontFace = R.fontB,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = 2, ZIndex = 3,
	}, group)

	local hover = Color3.fromRGB(72, 66, 60)
	local imgBase = S.CardImageTransparency
	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = hover }):Play()
		if img then TweenService:Create(img, TweenInfo.new(0.12), { ImageTransparency = math.max(0, imgBase - 0.15) }):Play() end
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.off }):Play()
		if img then TweenService:Create(img, TweenInfo.new(0.15), { ImageTransparency = imgBase }):Play() end
	end)
	btn.MouseButton1Click:Connect(function()
		btn.BackgroundColor3 = C.accent -- "clique" laranja e volta para a cor dos toggles
		btn.BackgroundTransparency = 0
		TweenService:Create(btn, TweenInfo.new(0.25), {
			BackgroundColor3 = C.off, BackgroundTransparency = R.bg and 0.2 or 0,
		}):Play()
		fire(opts.Callback)
	end)

	return { Button = btn, Text = txt }
end

