	----------------------------------------------------------------------------
	local function makeColumn(parent, index, total)
		local gap = 8
		local col = new("ScrollingFrame", {
			Size = UDim2.new(1 / total, -math.ceil(gap * (total - 1) / total), 1, 0),
			BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 0, ScrollBarImageTransparency = 1, LayoutOrder = index,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, parent)
		list(col, gap)

		local Column = { Frame = col, Cards = {} }
		-- AddCard(titulo, letraDoÍcone, corDoÍcone, contagemFixa?)  ou  AddCard({ Title, Icon, Color, Count })
		function Column:AddCard(a, b, c, d)
			local o = type(a) == "table" and a or { Title = a, Icon = b, Color = c, Count = d }
			local cardTitle = o.Title or "Card"

			local card = new("Frame", {
				Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.card,
			}, col)
			corner(card, 14)
			new("UIStroke", { Color = T.cardStroke, Thickness = 1 }, card)
			pad(card, 10)
			list(card, 4)

			local head = new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1 }, card)
			local icon = label(head, o.Icon or string.sub(cardTitle, 1, 1), {
				Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 0, BackgroundColor3 = o.Color or T.accent,
				Face = "sans800", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center,
			})
			corner(icon, 7)
			local iconImg = new("ImageLabel", {
				Size = UDim2.fromOffset(13, 13), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				BackgroundTransparency = 1, ImageColor3 = Color3.new(1, 1, 1), ScaleType = Enum.ScaleType.Fit, Visible = false,
			}, icon)
			applyIcon(iconImg, o.IconKey or cardTitle, function() icon.Text = "" end)
			local titleLbl = label(head, cardTitle, {
				Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -70, 1, 0),
				Face = "sans700", TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd,
			})
			local countLabel = label(head, o.Count and tostring(o.Count) or "0", {
				Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = T.sub, TextSize = 10, Face = "mono500",
			})

			local obj = setmetatable({
				Frame = card, _n = 0, _elements = {}, _countLabel = countLabel,
				_titleLabel = titleLbl, _fixedCount = o.Count ~= nil,
			}, CardMethods)
			table.insert(Column.Cards, obj)
			return obj
		end
		return Column
	end

	----------------------------------------------------------------------------
	-- 5.9 Window:AddTab
	----------------------------------------------------------------------------
	-- AddTab("Farm", { Columns = 3, ContentTop = 52 })
	function Window:AddTab(name, opts)
		opts = opts or {}
		tabCount += 1

		local hasIcon = Library.IconFiles[name] ~= nil
		local width = getTextWidth(name, TAB_TEXT_SIZE) + (hasIcon and (TAB_ICON + TAB_ICON_GAP) or 0) + (TAB_PAD_X * 2)
		local posX = nextTabX
		nextTabX = nextTabX + width + TAB_GAP
		tabWidths[name], tabPositions[name], tabOrder[name] = width, posX, tabCount

		local b = new("TextButton", {
			Size = UDim2.fromOffset(width, 34), Position = UDim2.fromOffset(posX, 0),
			Text = name, Face = "sans700", TextSize = TAB_TEXT_SIZE, TextColor3 = TAB_INACTIVE,
			BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 4,
		}, tabBar)
		pad(b, TAB_PAD_Y, TAB_PAD_X, TAB_PAD_Y, hasIcon and (TAB_PAD_X + TAB_ICON + TAB_ICON_GAP) or TAB_PAD_X)
		tabButtons[name] = b

		if hasIcon then
			local ic = new("ImageLabel", {
				Size = UDim2.fromOffset(TAB_ICON, TAB_ICON), AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, TAB_PAD_X, 0.5, 0), BackgroundTransparency = 1,
				ImageColor3 = Library.Assets.IconTint and TAB_INACTIVE or Color3.new(1, 1, 1),
				ScaleType = Enum.ScaleType.Fit, ZIndex = 5, Visible = false,
			}, b)
			tabIcons[name] = ic
			applyIcon(ic, name)
		end

		b.MouseEnter:Connect(function()
			if currentTab ~= name then setTabColor(name, T.text, 0.15) end
		end)
		b.MouseLeave:Connect(function()
			if currentTab ~= name then setTabColor(name, TAB_INACTIVE, 0.15) end
		end)

		local page = new("CanvasGroup", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false,
		}, body)
		pages[name] = page
		b.MouseButton1Click:Connect(function() Window:SelectTab(name) end)

		local Tab = { Name = name, Page = page, Columns = {} }
		local top = opts.ContentTop or 52
		local totalCols = opts.Columns or 3
		local colsFrame

		function Tab:Select() Window:SelectTab(name) end

		function Tab:AddIndicators(items)
			local row = new("Frame", { Position = UDim2.fromOffset(16, 12), Size = UDim2.new(0, 400, 0, 26), BackgroundTransparency = 1 }, page)
			list(row, 6, Enum.FillDirection.Horizontal)
			local chips, states, api = {}, {}, {}

			dual(api, "Set", function(_, n, on)
				local chip = chips[n]
				if not chip then return end
				states[n] = on and true or false
				tween(chip, { BackgroundColor3 = on and Color3.fromRGB(34, 60, 48) or T.card }, 0.2)
				tween(chip.Dot, { TextColor3 = on and T.green or T.sub }, 0.2)
				tween(chip, { TextColor3 = on and T.text or Color3.fromRGB(190, 190, 202) }, 0.2)
			end)
			dual(api, "Get", function(_, n) return states[n] == true end)

			for _, item in ipairs(items) do
				local chip = new("TextLabel", {
					AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), Text = item[1],
					Face = "sans600", TextSize = 11, TextColor3 = T.text, BackgroundColor3 = T.card,
				}, row)
				pad(chip, 0, 12, 0, 24)
				corner(chip, 13)
				label(chip, "●", { Name = "Dot", Position = UDim2.fromOffset(-14, 0), Size = UDim2.fromOffset(10, 26), TextSize = 8, TextColor3 = T.sub })
				chips[item[1]] = chip
				api:Set(item[1], item[2])
			end
			return api
		end

		-- AddInfoBar()  ou  AddInfoBar(function(segundosDeSessão) return "texto" end)
		function Tab:AddInfoBar(formatter)
			local l = label(page, "", {
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 12), Size = UDim2.fromOffset(280, 26),
				TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.sub, TextSize = 10, Face = "mono500",
			})
			local start = os.clock()
			task.spawn(function()
				while l.Parent do
					local s = math.floor(os.clock() - start)
					if formatter then
						local ok, text = pcall(formatter, s)
						l.Text = ok and tostring(text) or ""
					else
						l.Text = string.format("Server %d/%d   Session %02d:%02d:%02d   Char %s",
							#Players:GetPlayers(), Players.MaxPlayers, s // 3600, (s % 3600) // 60, s % 60, LP.DisplayName)
					end
					task.wait(1)
				end
			end)
			return l
		end

		function Tab:AddColumn()
			if not colsFrame then
				colsFrame = new("Frame", {
					Position = UDim2.fromOffset(16, top), Size = UDim2.new(1, -32, 1, -(top + 12)), BackgroundTransparency = 1,
				}, page)
				list(colsFrame, 8, Enum.FillDirection.Horizontal)
			end
			local col = makeColumn(colsFrame, #self.Columns + 1, totalCols)
			table.insert(self.Columns, col)
			return col
		end

		-- AddCard: cria as colunas sob demanda e coloca o card na coluna com menos cards
		function Tab:AddCard(a, b, c, d)
			while #self.Columns < totalCols do self:AddColumn() end
			local best = self.Columns[1]
			for _, col in ipairs(self.Columns) do
				if #col.Cards < #best.Cards then best = col end
			end
			return best:AddCard(a, b, c, d)
		end

		self.Tabs[name] = Tab
		table.insert(self.TabList, Tab)

		-- seleciona a primeira aba, a menos que o usuário selecione outra logo em seguida
		if tabCount == 1 then
			task.defer(function()
				if not currentTab then Window:SelectTab(name) end
			end)
		end
		return Tab
	end

	----------------------------------------------------------------------------
	-- 5.10 Configs (salvar / carregar / auto-load)
	----------------------------------------------------------------------------
	local function configPath(name) return Window.ConfigFolder .. "/" .. sanitizeName(name) .. ".json" end

	function Window:SaveConfig(name)
		if not writefile then return false, "writefile indisponível" end
		name = sanitizeName(name)
		if name == "" then return false, "nome inválido" end
		ensureFolder(self.ConfigFolder)
		local ok, json = pcall(function() return HttpService:JSONEncode(self.Flags) end)
		if not ok then return false, tostring(json) end
		local ok2, err = pcall(writefile, configPath(name), json)
		if not ok2 then return false, tostring(err) end
		self.ConfigSaved:Fire(name)
		return true
	end

	function Window:LoadConfig(name)
		if not (readfile and isfile) then return false, "readfile indisponível" end
		name = sanitizeName(name)
		local path = configPath(name)
		if name == "" or not isfile(path) then return false, "config não encontrada" end
		local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
		if not ok or type(data) ~= "table" then return false, "arquivo inválido" end
		local loaded = 0
		for flag, value in pairs(data) do
			local el = self.Elements[flag]
			if el then
				local okSet = pcall(el.Set, el, value)
				if okSet then loaded += 1 end
			end
		end
		self.ConfigLoaded:Fire(name, loaded)
		return true, loaded
	end

	function Window:DeleteConfig(name)
		if not (delfile and isfile) then return false, "delfile indisponível" end
		local path = configPath(name)
		if not isfile(path) then return false, "config não encontrada" end
		local ok, err = pcall(delfile, path)
		return ok, ok and nil or tostring(err)
	end

	function Window:ListConfigs()
		local out = {}
		if not (listfiles and isfolder and isfolder(self.ConfigFolder)) then return out end
		local ok, files = pcall(listfiles, self.ConfigFolder)
		if not ok then return out end
		for _, f in ipairs(files) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
		table.sort(out)
		return out
	end

	function Window:SetAutoLoad(name)
		if not (writefile and ensureFolder) then return false end
		ensureFolder(self.ConfigFolder)
		local path = self.ConfigFolder .. "/autoload.txt"
		if name and name ~= "" then
			return pcall(writefile, path, sanitizeName(name))
		elseif isfile and isfile(path) and delfile then
			return pcall(delfile, path)
		end
		return true
	end

	function Window:GetAutoLoad()
		local path = self.ConfigFolder .. "/autoload.txt"
		if readfile and isfile and isfile(path) then
			local ok, name = pcall(readfile, path)
			if ok and name ~= "" then return name end
		end
	end

	-- chame no FIM da construção da UI
	function Window:LoadAutoConfig()
		local name = self:GetAutoLoad()
		if not name then return false end
		return self:LoadConfig(name)
	end

	-- dispara os callbacks de todos os elementos com Flag (inicializa o estado)
	function Window:FireAll()
		for _, el in pairs(self.Elements) do el:Fire() end
	end

	----------------------------------------------------------------------------
	-- 5.11 Controle da janela
	----------------------------------------------------------------------------
	function Window:SetTitle(text) titleLabel.Text = text end

	function Window:SetToggleKey(key)
		toggleKey = key
		keyPill.Text = key.Name
	end

	function Window:SetScale(n)
		baseScale = math.clamp(n, 0.5, 1.5)
		tween(scale, { Scale = baseScale }, 0.15)
	end

	function Window:Toggle(state)
		if state == nil then state = not root.Visible end
		root.Visible = state
		if state then
			scale.Scale = baseScale * 0.94
			tween(scale, { Scale = baseScale }, 0.25, Enum.EasingStyle.Back)
		end
		closeDropdown()
		self.VisibilityChanged:Fire(state)
	end

	local minimized = false
	function Window:SetMinimized(state)
		minimized = state and true or false
		body.Visible = not minimized
		closeDropdown()
		tween(root, { Size = UDim2.fromOffset(W, minimized and HEADER_H or H) }, 0.25, Enum.EasingStyle.Quint)
	end

	function Window:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		self.Closed:Fire()
		closeDropdown()
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		table.clear(conns)
		for _, el in pairs(self.Elements) do el.Changed:DisconnectAll() end
		local i = table.find(Library.Windows, self)
		if i then table.remove(Library.Windows, i) end
		if lastWindow == self then lastWindow = nil end
		gui:Destroy()
	end

	closeBtn.MouseButton1Click:Connect(function()
		tween(scale, { Scale = baseScale * 0.9 }, 0.2)
		task.delay(0.2, function() Window:Destroy() end)
	end)
	minBtn.MouseButton1Click:Connect(function() Window:SetMinimized(not minimized) end)

	do -- arrastar
		local dragging, startPos, startInput
		header.InputBegan:Connect(function(i)
			if isPress(i) then
				dragging, startPos, startInput = true, root.Position, i.Position
			end
		end)
		track(UIS.InputChanged:Connect(function(i)
			if dragging and isMove(i) then
				local d = i.Position - startInput
				root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end))
		track(UIS.InputEnded:Connect(function(i)
			if isPress(i) then dragging = false end
		end))
	end

	-- teclado: captura de keybind, tecla de abrir/fechar e keybinds
	track(UIS.InputBegan:Connect(function(i, gp)
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if listening then
			local el = listening
			el:_finishListen(i.KeyCode)
			return
		end
		if gp then return end
		if i.KeyCode == toggleKey then
			Window:Toggle()
			return
		end
		local name = i.KeyCode.Name
		for _, kb in ipairs(table.clone(keybinds)) do
			if kb._value == name and not kb._disabled then
				kb.Pressed:Fire()
				safeCall(kb._onPress)
			end
		end
	end))

	----------------------------------------------------------------------------
	-- 5.12 Aba de Settings pronta (config + interface)
	----------------------------------------------------------------------------
	function Window:AddSettingsTab(name)
		local tab = self:AddTab(name or "Settings", { Columns = 2 })
		local left, right = tab:AddColumn(), tab:AddColumn()

		-- Config
		local cfgCard = left:AddCard("Config", "C", T.cyan)
		local typedName, selected = "", nil
		local status = cfgCard:AddStatus("Nenhuma ação ainda")
		local dd, autoToggle

		local function currentName()
			if typedName ~= "" then return typedName end
			return selected
		end
		local function report(ok, okText, err)
			if ok then
				status(okText, T.green)
				self:Notify(okText, "success")
			else
				status(tostring(err), T.red)
				self:Notify(tostring(err), "error")
			end
		end
		local function refresh(keep)
			dd:Refresh(self:ListConfigs(), keep)
			selected = dd:Get()
			if selected == "None" then selected = nil end
		end

		cfgCard:AddInput({ Text = "Config name", Placeholder = "default", Callback = function(v) typedName = sanitizeName(v) end })
		dd = cfgCard:AddDropdown({ Text = "Configs", Options = self:ListConfigs(), Callback = function(v)
			selected = (v ~= "None") and v or nil
		end })
		selected = dd:Get()
		if selected == "None" then selected = nil end

		cfgCard:AddButton({ Text = "Save config", Callback = function()
			local n = currentName()
			if not n then return report(false, nil, "Digite um nome") end
			local ok, err = self:SaveConfig(n)
			report(ok, "Salvo: " .. tostring(n), err)
			if ok then
				refresh(true)
				dd:Set(n, true)
				selected = n
			end
		end })
		cfgCard:AddButton({ Text = "Load config", Style = "secondary", Callback = function()
			local n = currentName()
			if not n then return report(false, nil, "Selecione uma config") end
			local ok, res = self:LoadConfig(n)
			report(ok, "Carregado: " .. tostring(n) .. " (" .. tostring(res) .. ")", res)
		end })
		cfgCard:AddButton({ Text = "Delete config", Style = "danger", Callback = function()
			local n = selected or typedName
			if not n or n == "" then return report(false, nil, "Selecione uma config") end
			local ok, err = self:DeleteConfig(n)
			report(ok, "Removido: " .. tostring(n), err)
			if ok then refresh(false) end
		end })
		autoToggle = cfgCard:AddToggle({ Text = "Auto load", Default = self:GetAutoLoad() ~= nil, Notify = false, Callback = function(v)
			if v then
				if not selected then
					self:Notify("Selecione uma config primeiro", "warning")
					autoToggle:Set(false, true)
					return
				end
				self:SetAutoLoad(selected)
			else
				self:SetAutoLoad(nil)
			end
		end })

		-- Interface
		local ui = right:AddCard("Interface", "I", T.purple)
		ui:AddKeybind({ Text = "Menu key", Default = toggleKey, ChangedCallback = function(v)
			local ok, key = pcall(function() return Enum.KeyCode[v] end)
			if ok and key and v ~= "None" then self:SetToggleKey(key) end
		end })
		ui:AddToggle({ Text = "Toggle notifications", Default = self.Options.ToggleNotifications, Notify = false, Callback = function(v)
			self.Options.ToggleNotifications = v
		end })
		ui:AddToggle({ Text = "Mascot reactions", Default = self.Options.MascotReactions, Notify = false, Callback = function(v)
			self.Options.MascotReactions = v
		end })
		ui:AddSlider({ Text = "UI scale", Min = 70, Max = 130, Increment = 5, Default = math.floor(baseScale * 100 + 0.5), Suffix = "%", Callback = function(v)
			self:SetScale(v / 100)
		end })
		ui:AddDivider()
		ui:AddButton({ Text = "Unload UI", Style = "danger", Callback = function() self:Destroy() end })

		return tab
	end

	table.insert(Library.Windows, Window)
	lastWindow = Window
	return Window
end

-- notificação global (usa a última janela criada)
function Library:Notify(text, kind, duration)
	if lastWindow then lastWindow:Notify(text, kind, duration) end
end

function Library:DestroyAll()
	for _, w in ipairs(table.clone(self.Windows)) do w:Destroy() end
end

return Library
