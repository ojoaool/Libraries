	local CardMethods = {}
	CardMethods.__index = CardMethods

	local COUNTED = { Toggle = true, Slider = true, Dropdown = true, Button = true, Keybind = true, Input = true }

	function CardMethods:_refreshCount()
		if not self._fixedCount then self._countLabel.Text = tostring(self._n) end
	end

	function CardMethods:_register(el)
		table.insert(self._elements, el)
		if COUNTED[el.Type] then self._n += 1 end
		self:_refreshCount()
	end

	function CardMethods:_unregister(el)
		local i = table.find(self._elements, el)
		if i then table.remove(self._elements, i) end
		if COUNTED[el.Type] then self._n = math.max(0, self._n - 1) end
		self:_refreshCount()
	end

	function CardMethods:SetCount(n)
		self._fixedCount = true
		self._countLabel.Text = tostring(n)
	end

	function CardMethods:SetTitle(text) self._titleLabel.Text = text end
	function CardMethods:SetVisible(v) self.Frame.Visible = v and true or false end

	function CardMethods:Destroy()
		for _, el in ipairs(table.clone(self._elements)) do el:Destroy() end
		self.Frame:Destroy()
	end

	-- ── Toggle ────────────────────────────────────────────────────────────────
	-- AddToggle(texto, padrão, callback)  ou  AddToggle({ Text, Default, Callback, Flag, Tooltip, Notify, Disabled })
	local KNOB_ON, KNOB_OFF = UDim2.new(1, -16, 0.5, 0), UDim2.new(0, 2, 0.5, 0)

	function CardMethods:AddToggle(a, b, c)
		local o = type(a) == "table" and a or { Text = a, Default = b, Callback = c }
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1 }, self.Frame)
