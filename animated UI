	local C, S = Autumn.Theme, Autumn.Style
	local tab = setmetatable({
		window = self, name = opts.Name or "Tab", icon = opts.Icon,
		subList = {}, current = nil, active = false,
	}, Tab)

	-- container das subtabs (cima) desta tab
	tab.holder = make("Frame", {
		Position = UDim2.fromOffset(23, 80), Size = UDim2.fromOffset(1073, 43),
		BackgroundTransparency = 1, Visible = false,
	}, self.root)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 14),
	}, tab.holder)

	-- botão da tab (embaixo)
	local pill = make("TextButton", {
		Text = "", AutoButtonColor = false,
		Size = UDim2.fromOffset(205, 56),
		BackgroundColor3 = C.pill, BorderSizePixel = 0,
		ZIndex = 10, LayoutOrder = #self.tabs + 1,
	}, self.pillHolder)
	corner(pill, 16)
	tab.pillStroke = stroke(pill, C.stroke, 1, 0.1)
	local img = imageBackground(pill, 16, S.CardImageTransparency, S.CardImageTint, 10)

	local group = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 56), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, ZIndex = 11,
	}, pill)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
