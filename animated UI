	local keybinds, listening = {}, nil

	local ElementMethods = {}
	ElementMethods.__index = ElementMethods
	ElementMethods.__call = function(self, ...)
		if self._invoke then return self._invoke(...) end
	end

	function ElementMethods:Get() return self._value end

	function ElementMethods:Set(value, silent)
		local v = value
		if self._normalize then v = self._normalize(value) end
		if v == nil then return end
		local old = self._value
		self._value = v
		if self._render then self._render(v) end
		if self.Flag then Window.Flags[self.Flag] = v end
		if silent or valuesEqual(old, v) then return end
		self.Changed:Fire(v)
		safeCall(self._callback, v)
	end

	-- dispara os callbacks com o valor atual (útil para inicializar estado)
	function ElementMethods:Fire()
		self.Changed:Fire(self._value)
		safeCall(self._callback, self._value)
	end

	function ElementMethods:OnChanged(fn) return self.Changed:Connect(fn) end

	function ElementMethods:SetText(text)
		self.Text = text
		if self._label then self._label.Text = (self._prefix or "") .. tostring(text) end
		if self._ctrl then
			self._ctrl.labelW = getTextWidth(tostring(text), 12)
			self._ctrl:Layout()
		end
	end

	function ElementMethods:SetVisible(v)
		self.Frame.Visible = v and true or false
	end

	function ElementMethods:SetDisabled(d)
		self._disabled = d and true or false
		self._overlay.Visible = self._disabled
	end

	function ElementMethods:IsDisabled() return self._disabled end

	function ElementMethods:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		if self._onDestroy then self._onDestroy() end
		for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
		if self.Flag and Window.Elements[self.Flag] == self then
			Window.Elements[self.Flag] = nil
			Window.Flags[self.Flag] = nil
		end
		self.Changed:DisconnectAll()
		self.Card:_unregister(self)
		self.Frame:Destroy()
	end

	local function makeElement(card, kind, row, o)
		local el = setmetatable({
			Type = kind, Frame = row, Card = card, Flag = o.Flag, Text = o.Text or o.Title or kind,
			Changed = Signal.new(), _callback = o.Callback, _disabled = false, _conns = {},
		}, ElementMethods)
		el._overlay = new("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.card, BackgroundTransparency = 0.4,
			BorderSizePixel = 0, Visible = false, ZIndex = 10,
		}, row)
		corner(el._overlay, 6)
		card:_register(el)
		attachTooltip(row, o.Tooltip)
		return el
	end

	local function registerFlag(el)
		if not el.Flag then return end
		if Window.Elements[el.Flag] then
			warn("[FarmUI] flag duplicada: " .. tostring(el.Flag))
		end
		Window.Elements[el.Flag] = el
		Window.Flags[el.Flag] = el._value
	end

	local function trackFor(el, c)
		table.insert(el._conns, c)
		track(c)
	end

	-- linha "texto à esquerda + controle à direita" que se adapta ao tamanho do texto
	local function splitRow(parent, text, need, minW, height)
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1 }, parent)
		local lbl = label(row, text, { Size = UDim2.new(1, -(need + 8), 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
		local ctrl = { Row = row, Label = lbl, need = need, min = math.min(minW, need), labelW = getTextWidth(text, 12) }
		function ctrl:Layout()
			local right = self.right
			if not right then return end
			local rowW = row.AbsoluteSize.X / math.max(scale.Scale, 0.01)
			if rowW <= 0 then return end
			local w = math.clamp(rowW - self.labelW - 10, self.min, self.need)
			right.Size = UDim2.fromOffset(w, right.Size.Y.Offset)
			lbl.Size = UDim2.new(1, -(w + 8), 1, 0)
		end
		function ctrl:Bind(right)
			self.right = right
			task.defer(function() self:Layout() end)
		end
		row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() ctrl:Layout() end)
		return ctrl
	end

