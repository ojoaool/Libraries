function Autumn:CreateWindow(opts)
	opts = opts or {}
	init()
	local C, S = Autumn.Theme, Autumn.Style

	local parent = getGuiParent()
	local guiName = opts.GuiName or "AutumnUI"
	local old = parent:FindFirstChild(guiName)
	if old then old:Destroy() end

	local gui = make("ScreenGui", {
		Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = opts.DisplayOrder or 100,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parent)

	-- escala automática (cabe em telas pequenas/celular)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local scale = math.min(opts.Scale or 0.6, vp.X * 0.95 / DESIGN_W, vp.Y * 0.95 / DESIGN_H)

	local frame = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(DESIGN_W * scale, DESIGN_H * scale),
		BackgroundColor3 = C.window,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, gui)
	corner(frame, 16)
	stroke(frame, C.stroke, 1, 0.3)

	local bg = imageBackground(frame, 16, S.WindowImageTransparency, nil, 0)
	if bg then bg.ZIndex = 0 end

	local root = make("Frame", {
		Size = UDim2.fromOffset(DESIGN_W, DESIGN_H),
		BackgroundTransparency = 1,
	}, frame)
	make("UIScale", { Scale = scale }, root)

	local self = setmetatable({
		gui = gui, frame = frame, root = root, scale = scale,
		tabs = {}, activeTab = nil, _conns = {},
		OnTabChanged = opts.OnTabChanged,
		OnSubTabChanged = opts.OnSubTabChanged,
	}, Window)

	-- cabeçalho: logo + nome + versão
	makeIcon(root, opts.Logo or "leaf", 24, 18, 40, 40, C.accent, false)
	local titleHolder = make("Frame", {
		Position = UDim2.fromOffset(70, 18), Size = UDim2.fromOffset(500, 40),
		BackgroundTransparency = 1,
	}, root)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 14),
	}, titleHolder)
	local title = label(titleHolder, opts.Name or "Autumn", 0, 0, 0, 40, 31, C.text, true)
	title.Size = UDim2.fromOffset(0, 40)
	title.AutomaticSize = Enum.AutomaticSize.X
	title.LayoutOrder = 1
	local ver = label(titleHolder, opts.Version or ("v" .. Autumn.Version), 0, 0, 0, 40, 21, C.sub, false)
	ver.Size = UDim2.fromOffset(0, 40)
	ver.AutomaticSize = Enum.AutomaticSize.X
	ver.LayoutOrder = 2
	self.titleLabel, self.versionLabel = title, ver

	-- arrastar pela área do cabeçalho
	do
		local drag = make("Frame", {
			Size = UDim2.fromOffset(DESIGN_W, 70), BackgroundTransparency = 1,
		}, root)
		local dragging, startPos, startInput
		drag.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
				or i.UserInputType == Enum.UserInputType.Touch then
				dragging, startPos, startInput = true, frame.Position, i.Position
			end
		end)
		self:_connect(UserInputService.InputChanged, function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
				or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - startInput
				frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
					startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
		self:_connect(UserInputService.InputEnded, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
				or i.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

	-- divisória entre subtabs e conteúdo
	local fade = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.04, 0),
		NumberSequenceKeypoint.new(0.96, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	local shadow = make("Frame", {
		Name = "DividerShadow", Position = UDim2.fromOffset(23, 138),
		Size = UDim2.fromOffset(1073, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 2,
	}, root)
	make("UIGradient", { Transparency = fade }, shadow)
	local divider = make("Frame", {
		Name = "Divider", Position = UDim2.fromOffset(23, 137),
		Size = UDim2.fromOffset(1073, 1), BackgroundColor3 = Color3.fromRGB(66, 58, 52),
		BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 2,
	}, root)
	make("UIGradient", { Transparency = fade }, divider)

	-- barra de tabs de baixo
	self.pillHolder = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(548, 777),
		Size = UDim2.fromOffset(0, 56), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1, ZIndex = 10,
	}, root)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 12),
	}, self.pillHolder)

	-- tecla para esconder/mostrar
	local toggleKey = opts.ToggleKey
	if toggleKey == nil then toggleKey = Enum.KeyCode.RightShift end
	if toggleKey then
		self:_connect(UserInputService.InputBegan, function(i, gp)
			if not gp and i.KeyCode == toggleKey then self:Toggle() end
		end)
	end

	table.insert(Autumn.Windows, self)
	return self
end

function Window:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Window:Toggle(state)
	if state == nil then state = not self.gui.Enabled end
	self.gui.Enabled = state
end

function Window:Destroy()
	for _, c in ipairs(self._conns) do c:Disconnect() end
	self._conns = {}
	self.gui:Destroy()
	for i, w in ipairs(Autumn.Windows) do
		if w == self then table.remove(Autumn.Windows, i) break end
	end
end

function Window:SetTitle(name, version)
	if name then self.titleLabel.Text = name end
	if version then self.versionLabel.Text = version end
end

function Window:SelectTab(tab, silent)
	if type(tab) == "string" then
		for _, t in ipairs(self.tabs) do
			if t.name == tab then tab = t break end
		end
	end
	if type(tab) ~= "table" then return end
	local C = Autumn.Theme
	self.activeTab = tab
	for _, t in ipairs(self.tabs) do
		t.active = (t == tab)
		t.holder.Visible = t.active -- troca as subtabs de cima
		for _, sub in ipairs(t.subList) do
			setPage(sub, t.active and sub == t.current, true, 0)
		end
		t.pillStroke.Color = t.active and C.accent or C.stroke
		t.pillStroke.Transparency = t.active and 0.35 or 0.1
		t.pillText.TextColor3 = t.active and C.text or C.sub
		t.pillIcon.SetColor(t.active and C.text or C.sub)
	end
	if not silent then fire(self.OnTabChanged, tab.name) end
end

