	-- ── Barra de progresso ────────────────────────────────────────────────────
	-- local p = card:AddProgressBar("XP", 1000, 450, cor);  p:Set(700)  /  p.Set(700)
	function CardMethods:AddProgressBar(title, max, default, color)
		color = color or T.accent
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, self.Frame)
		local lbl = label(row, title, { Size = UDim2.new(0.5, 0, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd })
		local val = label(row, "", {
			Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0.5, 0, 0, 14),
			TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.sub, TextSize = 10, Face = "mono500",
		})
		local bar = new("Frame", {
			Position = UDim2.new(0, 0, 0, 21), Size = UDim2.new(1, 0, 0, 7), BackgroundColor3 = T.off,
		}, row)
		corner(bar, 4)
		local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color }, bar)
		corner(fill, 4)
		new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, color:Lerp(Color3.new(1, 1, 1), 0.35)),
				ColorSequenceKeypoint.new(1, color),
			}),
		}, fill)

		local el = makeElement(self, "ProgressBar", row, { Text = title })
		el._label = lbl
		local current, maxValue = 0, max
		local function apply(v, animate)
			current = math.clamp(v, 0, maxValue)
			el._value = current
			local size = UDim2.fromScale(maxValue > 0 and current / maxValue or 0, 1)
			if animate then tween(fill, { Size = size }, 0.3, Enum.EasingStyle.Quad) else fill.Size = size end
			val.Text = tostring(math.floor(current)) .. "/" .. tostring(maxValue)
		end
		dual(el, "Set", function(_, v) apply(v, true) end)
		dual(el, "Get", function() return current end)
		dual(el, "SetMax", function(_, m) maxValue = m apply(current, true) end)
		apply(default or 0, false)
		return el
	end

