	local function attachTooltip(obj, text)
		if not text or text == "" then return end
		local token = 0
		obj.MouseEnter:Connect(function()
			token += 1
			local mine = token
			task.delay(0.45, function()
				if mine == token and obj.Parent then
					tip.Text = text
					moveTip()
					tip.Visible = true
				end
			end)
		end)
		obj.MouseMoved:Connect(moveTip)
		obj.MouseLeave:Connect(function()
			token += 1
			tip.Visible = false
		end)
	end

