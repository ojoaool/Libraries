--[[
	CreateWindow({
		Title = "Meu Hub",               Version = "DEV   v1.0",  -- "" = sem pílula
		Name = "FarmUI",                 -- nome do ScreenGui (substitui um antigo com o mesmo nome)
		Width = 720, Height = 490,       Scale = 1,
		ToggleKey = Enum.KeyCode.RightShift,
		Mascot = true,                   MascotReactions = true,
		ToggleNotifications = true,      -- toast ao ligar/desligar toggles
		ConfigFolder = "FarmUI/configs/<Name>",
		Parent = nil,                    -- padrão: PlayerGui
	})
]]
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	init()

	local W, H = cfg.Width or 720, cfg.Height or 490
	local WINDOW_RADIUS, HEADER_H = 22, 82
	local guiName = cfg.Name or "FarmUI"
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	local baseScale = cfg.Scale or 1
	local guiParent = cfg.Parent or LP:WaitForChild("PlayerGui")

	local Window = {
		Flags = {}, Elements = {}, Tabs = {}, TabList = {},
		Options = {
			ToggleNotifications = cfg.ToggleNotifications ~= false,
			MascotReactions = cfg.MascotReactions ~= false,
		},
		ConfigFolder = cfg.ConfigFolder or ("FarmUI/configs/" .. guiName),
		Mascot = { React = function() end },
		Closed = Signal.new(), TabChanged = Signal.new(), VisibilityChanged = Signal.new(),
		ConfigSaved = Signal.new(), ConfigLoaded = Signal.new(),
	}

	local conns = {}
	local function track(c) table.insert(conns, c) return c end

	local old = guiParent:FindFirstChild(guiName)
	if old then old:Destroy() end

	local gui = new("ScreenGui", {
		Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, AutoLocalize = false,
	}, guiParent)
	Window.Gui = gui

	local root = new("Frame", {
		Size = UDim2.fromOffset(W, H), AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, -H / 2), BackgroundTransparency = 1,
	}, gui)
	local scale = new("UIScale", { Scale = baseScale * 0.9 }, root)

	new("ImageLabel", {
		BackgroundTransparency = 1, Image = "rbxassetid://6014261993",
		ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = 0.45,
		ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450),
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 60, 1, 60), ZIndex = 0,
	}, root)

	local main = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.bg, ZIndex = 1 }, root)
	corner(main, WINDOW_RADIUS)
	new("UIStroke", { Color = Color3.fromRGB(48, 48, 60), Thickness = 1.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, main)
	tween(scale, { Scale = baseScale }, 0.35, Enum.EasingStyle.Back)

	----------------------------------------------------------------------------
	-- 5.1 Header
	----------------------------------------------------------------------------
	local gradient = ColorSequence.new({
		ColorSequenceKeypoint.new(0, T.headerFrom),
		ColorSequenceKeypoint.new(1, T.headerTo),
	})

	local header = new("Frame", {
		Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2,
	}, main)
	corner(header, WINDOW_RADIUS)
	new("UIGradient", { Color = gradient }, header)

	local filler = new("Frame", {
		Size = UDim2.new(1, 0, 0, WINDOW_RADIUS + 2), Position = UDim2.new(0, 0, 1, -(WINDOW_RADIUS + 2)),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2,
	}, header)
	new("UIGradient", { Color = gradient }, filler)

	local titleLabel = label(header, cfg.Title or "FarmUI", {
		Position = UDim2.fromOffset(22, 11), Size = UDim2.fromOffset(240, 20),
		Face = "sans800", TextSize = 16, ZIndex = 4,
	})
	local version = cfg.Version or ""
	if version ~= "" then
		local ver = label(header, version, {
			Position = UDim2.fromOffset(22, 34), Size = UDim2.fromOffset(math.ceil(#version * 5.5 + 8), 14), TextSize = 9,
			Face = "mono600", TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(16, 26, 90), ZIndex = 4,
		})
		corner(ver, 7)
	end

	----------------------------------------------------------------------------
	-- 5.2 Mascote
	----------------------------------------------------------------------------
	local Mascot = Window.Mascot
	if cfg.Mascot ~= false then
		local A = Library.Assets
		local SIZE, X_FROM_RIGHT, SINK = 116, 235, 18
		local Y_OFFSET = HEADER_H - SIZE + SINK

		local IDLE = "mouth1"
		local LOOK_RADIUS, DEAD_ZONE, MIRROR_LOOK = 320, 10, false
		local YAWN_AFTER, SLEEP_AFTER = 25, 32

		local LOOK = { L = "lookL", R = "lookR", U = "lookUp", D = "lookDown" }
		local CLICK = { "poke", "boop" }
		local ANNOYED = { "angry", "huff", "grumpy", "ow", "dizzy" }
		local SHY = { "shyGlance", "blushAway", "flustered" }
		local ALL = {
			"angry", "blink", "blushAway", "boop", "denial", "dizzy", "excited", "flustered", "grumpy",
			"handL", "handL-hands", "handR", "handR-hands", "huff", "laugh", "lookDown", "lookL", "lookR",
			"lookUp", "mouth1", "mouth2", "mouth3", "nervous", "ow", "pat", "poke", "pout", "shyGlance",
			"sleep", "smug", "squint", "wink", "yawn",
		}
		local PRIORITY = { IDLE, LOOK.L, LOOK.R, LOOK.U, LOOK.D, "blink", "poke", "boop", "pat" }

		local holder = new("Frame", {
			Name = "Mascot", AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(SIZE, SIZE),
			Position = UDim2.new(1, -X_FROM_RIGHT, 0, Y_OFFSET), BackgroundTransparency = 1, ZIndex = 5,
		}, header)
		local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 9 }, holder)

		local layers, current = {}, nil
		local lockedUntil, holding = 0, false

		local function show(name)
			if current == name then return end
			local layer = layers[name]
			if not layer then return end
			if current and layers[current] then layers[current].Visible = false end
			layer.Visible = true
			current = name
		end

		local function pick(lst)
			local ok = {}
			for _, n in ipairs(lst) do
				if layers[n] then table.insert(ok, n) end
			end
			if #ok > 0 then return ok[math.random(#ok)] end
		end

		local function play(name, duration)
			if not name or not layers[name] then return end
			lockedUntil = os.clock() + duration
			show(name)
		end

		function Mascot.React(name, duration)
			if holding then return end
			play(name, duration or 1.2)
		end

		local function loadFrame(name)
			if layers[name] or not holder.Parent then return end
			local ok, asset = pcall(function()
				local path = download(A.FrameBase, A.FrameDir, name .. ".png")
				return path and getasset(path)
			end)
			if ok and asset and holder.Parent then
				local layer = new("ImageLabel", {
					Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = asset,
					ScaleType = Enum.ScaleType.Fit, Visible = false, ZIndex = 5,
				}, holder)
				layers[name] = layer
				pcall(function() ContentProvider:PreloadAsync({ layer }) end)
				if name == IDLE and not current then show(IDLE) end
			elseif not ok or not asset then
				warn("[FarmUI] não foi possível carregar o frame: " .. name .. ".png")
			end
		end

		if CAN_DOWNLOAD then
			ensureFolder(A.FrameDir)
			task.spawn(function()
				for _, n in ipairs(PRIORITY) do loadFrame(n) end
				for _, n in ipairs(ALL) do loadFrame(n) task.wait() end
			end)
		end

		local lastMouse, lastMove = Vector2.new(-1, -1), os.clock()
		local lookAxis, shyDone = "V", false

		track(RunService.Heartbeat:Connect(function()
			if not holder.Parent or not root.Visible then return end
			local now = os.clock()
			local m = UIS:GetMouseLocation()
			if (m - lastMouse).Magnitude > 1.5 then lastMouse, lastMove = m, now end

			local half = holder.AbsoluteSize / 2
			local d = m - (holder.AbsolutePosition + half)
			local dist = d.Magnitude
			local inside = math.abs(d.X) <= half.X and math.abs(d.Y) <= half.Y
			if not inside then shyDone = false end

			if holding or now < lockedUntil then return end
			local idleFor = now - lastMove

			if idleFor > SLEEP_AFTER then
				return show("sleep")
			elseif idleFor > YAWN_AFTER then
				return show("yawn")
			end

			if inside and idleFor > 2.5 and not shyDone then
				shyDone = true
				local f = pick(SHY)
				if f then return play(f, 2.2) end
			end

			if dist > DEAD_ZONE and dist <= LOOK_RADIUS then
				local ax, ay = math.abs(d.X), math.abs(d.Y)
				local horizontal
				if lookAxis == "H" then horizontal = ax > ay * 0.75 else horizontal = ax > ay * 1.25 end
				lookAxis = horizontal and "H" or "V"
				if horizontal then
					local left = d.X < 0
					if MIRROR_LOOK then left = not left end
					show(left and LOOK.L or LOOK.R)
				else
					show(d.Y < 0 and LOOK.U or LOOK.D)
				end
			else
				show(IDLE)
			end
		end))

		local blinkable = { [IDLE] = true, [LOOK.L] = true, [LOOK.R] = true, [LOOK.U] = true, [LOOK.D] = true }
		task.spawn(function()
			while holder.Parent do
				task.wait(math.random(25, 60) / 10)
				if not holding and os.clock() >= lockedUntil and blinkable[current] then play("blink", 0.13) end
			end
		end)

		local clicks, holdToken = {}, 0
		hit.MouseButton1Down:Connect(function()
			local now = os.clock()
			table.insert(clicks, now)
			while #clicks > 0 and now - clicks[1] > 1.6 do table.remove(clicks, 1) end
			if #clicks >= 5 then
				clicks = {}
				holding = false
				return play(pick(ANNOYED), 1.8)
			end
			holding = true
			holdToken += 1
			local token = holdToken
			play(pick(CLICK), 0.4)
			task.delay(0.5, function()
				if holding and holdToken == token and layers.pat then
					lockedUntil = math.huge
					show("pat")
				end
			end)
		end)

		local function release()
			if not holding then return end
			holding = false
			if lockedUntil == math.huge then lockedUntil = os.clock() + 0.3 end
		end
		hit.MouseButton1Up:Connect(release)
		track(UIS.InputEnded:Connect(function(i)
			if isPress(i) then release() end
		end))
	end

	local function react(name, duration)
		if Window.Options.MascotReactions then Mascot.React(name, duration) end
	end

