local R -- { bg, fontR, fontB }

local function init()
	if R then return R end
	R = {}
	local bgPath = fetchFile(Autumn.Style.Background, "png")
	if bgPath then
		local ok, asset = pcall(getcustomasset, bgPath)
		if ok then R.bg = asset end
	end
	R.fontR = loadFont(Autumn.Style.FontRegular, "AutumnComicRegular")
		or Font.new("rbxasset://fonts/families/ComicNeue.json", Enum.FontWeight.Regular)
	R.fontB = loadFont(Autumn.Style.FontBold, "AutumnComicBold")
		or Font.new("rbxasset://fonts/families/ComicNeue.json", Enum.FontWeight.Bold)
	return R
end

local iconCache = {}

local function encodeUrl(str)
	return (str:gsub(" ", "%%20"))
end

-- aceita links "github.com/usuario/repo/blob/main/arquivo.png" e converte para raw
local function toRawUrl(url)
	local user, repo, rest = url:match("^https?://github%.com/([^/]+)/([^/]+)/blob/(.+)$")
	if user then
		rest = rest:gsub("%?.*$", "")
		return "https://raw.githubusercontent.com/" .. user .. "/" .. repo .. "/" .. rest
	end
	return encodeUrl(url)
end

-- Resolve um ícone para um asset do Roblox. Aceita:
--   "speed"                    -> <IconsUrl><IconPrefix>speed.png
--   "pasta/arquivo.png"        -> <IconsUrl>pasta/arquivo.png
--   "https://..." (qualquer)   -> link direto (links github.com/.../blob/ são convertidos)
--   "rbxassetid://123"         -> asset do Roblox
--   nomes registrados em Autumn.IconUrls
local function iconAsset(name)
	if not name or name == "" then return nil end
	if iconCache[name] ~= nil then return iconCache[name] or nil end
	local asset = false
	local direct = Autumn.IconUrls[name]

	if name:find("^rbxasset") then
		asset = name
	elseif direct and direct:find("^rbxasset") then
		asset = direct
	else
		local url, cache
		if direct or name:find("^https?://") then
			url = toRawUrl(direct or name)
			cache = "icon_" .. (url:gsub("[^%w]", "_")):sub(-100) .. ".png"
		else
			local base = Autumn.IconsUrl or Autumn.AssetsUrl
			local fileName = name:find("%.png$") and name or (Autumn.IconPrefix .. name:lower() .. ".png")
			url = base .. encodeUrl(fileName)
			cache = "icon_" .. (fileName:gsub("[^%w%._%-]", "_"))
		end
		local path = fetchFile(cache, "png", url)
		if path then
			local ok, a = pcall(getcustomasset, path)
			if ok then asset = a end
		end
	end

	iconCache[name] = asset
	return asset or nil
end

-- Define de onde vêm os ícones (um repositório/pasta do GitHub).
--   Autumn:SetIconRepo("ojoaool/wood-assets", "main", "new icons", "")
function Autumn:SetIconRepo(repo, branch, folder, prefix)
	local url = "https://raw.githubusercontent.com/" .. repo .. "/" .. (branch or "main") .. "/"
	if folder and folder ~= "" then
		folder = folder:gsub("^/+", ""):gsub("/+$", "")
		url = url .. encodeUrl(folder) .. "/"
	end
	Autumn.IconsUrl = url
	if prefix ~= nil then Autumn.IconPrefix = prefix end
	iconCache = {}
end

-- Registra vários ícones de uma vez: nome -> link / arquivo / rbxassetid
--   Autumn:RegisterIcons({ speed = "https://.../run.png", fly = "plane.png" })
function Autumn:RegisterIcons(map)
	for name, src in pairs(map) do
		Autumn.IconUrls[name] = src
		iconCache[name] = nil
	end
end

-- Baixa os ícones antes de montar a UI (evita travadinhas)
--   Autumn:PreloadIcons({ "speed", "flight", "https://..." })
function Autumn:PreloadIcons(list)
	for _, name in ipairs(list) do iconAsset(name) end
end

function Autumn:ClearIconCache()
	iconCache = {}
end

----------------------------------------------------------------
-- Helpers de UI
----------------------------------------------------------------
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function corner(o, r)
	return make("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

local function stroke(o, col, thick, transp)
	return make("UIStroke", {
		Color = col, Thickness = thick or 1, Transparency = transp or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, o)
end

local function label(parent, str, x, y, w, h, size, color, bold, align)
	return make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		Text = str,
		TextSize = size,
		TextColor3 = color,
		FontFace = bold and R.fontB or R.fontR,
		TextXAlignment = align or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
end

-- ícone (imagem do GitHub ou emoji). tint=true pinta com `color`.
local function makeIcon(parent, name, x, y, w, h, color, tint)
	local asset = iconAsset(name)
	local obj, setColor
	if asset then
		obj = make("ImageLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			Image = asset,
			ImageColor3 = tint and color or Color3.new(1, 1, 1),
			ScaleType = Enum.ScaleType.Fit,
		}, parent)
		setColor = function(c) if tint then obj.ImageColor3 = c end end
	else
		obj = label(parent, Autumn.IconEmoji[name] or "•", x, y, w, h,
			math.floor(h * 0.8), color, false, Enum.TextXAlignment.Center)
		setColor = function(c) obj.TextColor3 = c end
	end
	return { obj = obj, SetColor = setColor }
end

local function getGuiParent()
	local ok, hui = pcall(function() return gethui and gethui() end)
	if ok and hui then return hui end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function fire(cb, ...)
	if cb then task.spawn(cb, ...) end
end

local function imageBackground(parent, radius, transparency, tint, zindex)
	if not R.bg then return nil end
	local img = make("ImageLabel", {
		Name = "Background",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = R.bg,
		ImageColor3 = tint or Color3.new(1, 1, 1),
		ImageTransparency = transparency,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = zindex or 1,
	}, parent)
	corner(img, radius)
	return img
end

