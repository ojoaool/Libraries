		local sw = new("TextButton", {
			Size = UDim2.fromOffset(34, 18), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			Text = "", AutoButtonColor = false, BackgroundColor3 = state and T.accent or T.off,
