		local knob = new("Frame", {
			Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0, 0.5),
			Position = state and KNOB_ON or KNOB_OFF, BackgroundColor3 = Color3.new(1, 1, 1),
		}, sw)
